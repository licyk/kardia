culus-88","page_id":"/en/docs/concepts-calculus","tags":[],"type":"text","url":"/en/docs/concepts-calculus#table-1--rules-as-writes","content":"`Reloading(i,g,ω)`","locale":"en"},"4257":{"id":"/en/docs/concepts-calculus-89","page_id":"/en/docs/concepts-calculus","tags":[],"type":"text","url":"/en/docs/concepts-calculus#table-1--rules-as-writes","content":"`Reloading(i′, g∘h, ω)`","locale":"en"},"4258":{"id":"/en/docs/concepts-calculus-90","page_id":"/en/docs/concepts-calculus","tags":[],"type":"text","url":"/en/docs/concepts-calculus#table-1--rules-as-writes","content":"`pr₁∘i`","locale":"en"},"4259":{"id":"/en/docs/concepts-calculus-91","page_id":"/en/docs/concepts-calculus","tags":[],"type":"text","url":"/en/docs/concepts-calculus#table-1--rules-as-writes","content":"`θ_n`","locale":"en"},"4260":{"id":"/en/docs/concepts-calculus-92","page_id":"/en/docs/concepts-calculus","tags":[],"type":"text","url":"/en/docs/concepts-calculus#table-1--rules-as-writes","content":"L-Finish","locale":"en"},"4261":{"id":"/en/docs/concepts-calculus-93","page_id":"/en/docs/concepts-calculus","tags":[],"type":"text","url":"/en/docs/concepts-calculus#table-1--rules-as-writes","content":"`Reloading(i,g,ω)`","locale":"en"},"4262":{"id":"/en/docs/concepts-calculus-94","page_id":"/en/docs/concepts-calculus","tags":[],"type":"text","url":"/en/docs/concepts-calculus#table-1--rules-as-writes","content":"`Active(g∘h, ω)`","locale":"en"},"4263":{"id":"/en/docs/concepts-calculus-95","page_id":"/en/docs/concepts-calculus","tags":[],"type":"text","url":"/en/docs/concepts-calculus#table-1--rules-as-writes","content":"`pr₁∘i`","locale":"en"},"4264":{"id":"/en/docs/concepts-calculus-96","page_id":"/en/docs/concepts-calculus","tags":[],"type":"text","url":"/en/docs/concepts-calculus#table-1--rules-as-writes","content":"`θ_n`","locale":"en"},"4265":{"id":"/en/docs/concepts-calculus-97","page_id":"/en/docs/concepts-calculus","tags":[],"type":"text","url":"/en/docs/concepts-calculus#table-1--rules-as-writes","content":"L-Divert","locale":"en"},"4266":{"id":"/en/docs/concepts-calculus-98","page_id":"/en/docs/concepts-calculus","tags":[],"type":"text","url":"/en/docs/concepts-calculus#table-1--rules-as-writes","content":"`Reloading(i,g,ω)`","locale":"en"},"4267":{"id":"/en/docs/concepts-calculus-99","page_id":"/en/docs/concepts-calculus","tags":[],"type":"text","url":"/en/docs/concepts-calculus#table-1--rules-as-writes","content":"`Unloading(g∘h, ω)`","locale":"en"},"4268":{"id":"/en/docs/concepts-calculus-100","page_id":"/en/docs/concepts-calculus","tags":[],"type":"text","url":"/en/docs/concepts-calculus#table-1--rules-as-writes","content":"`id` or `pr₁∘i`","locale":"en"},"4269":{"id":"/en/docs/concepts-calculus-101","page_id":"/en/docs/concepts-calculus","tags":[],"type":"text","url":"/en/docs/concepts-calculus#table-1--rules-as-writes","content":"`θ_n`","locale":"en"},"4270":{"id":"/en/docs/concepts-calculus-102","page_id":"/en/docs/concepts-calculus","tags":[],"type":"text","url":"/en/docs/concepts-calculus#table-1--rules-as-writes","content":"L-Leave","locale":"en"},"4271":{"id":"/en/docs/concepts-calculus-103","page_id":"/en/docs/concepts-calculus","tags":[],"type":"text","url":"/en/docs/concepts-calculus#table-1--rules-as-writes","content":"`Active(g,ω)`","locale":"en"},"4272":{"id":"/en/docs/concepts-calculus-104","page_id":"/en/docs/concepts-calculus","tags":[],"type":"text","url":"/en/docs/concepts-calculus#table-1--rules-as-writes","content":"`Unloading(g, ω)`","locale":"en"},"4273":{"id":"/en/docs/concepts-calculus-105","page_id":"/en/docs/concepts-calculus","tags":[],"type":"text","url":"/en/docs/concepts-calculus#table-1--rules-as-writes","content":"`id`","locale":"en"},"4274":{"id":"/en/docs/concepts-calculus-106","page_id":"/en/docs/concepts-calculus","tags":[],"type":"text","url":"/en/docs/concepts-calculus#table-1--rules-as-writes","content":"`θ_n`","locale":"en"},"4275":{"id":"/en/docs/concepts-calculus-107","page_id":"/en/docs/concepts-calculus","tags":[],"type":"text","url":"/en/docs/concepts-calculus#table-1--rules-as-writes","content":"L-Unload","locale":"en"},"4276":{"id":"/en/docs/concepts-calculus-108","page_id":"/en/docs/concepts-calculus","tags":[],"type":"text","url":"/en/docs/concepts-calculus#table-1--rules-as-writes","content":"`Unloading(g,ω)`","locale":"en"},"4277":{"id":"/en/docs/concepts-calculus-109","page_id":"/en/docs/concepts-calculus","tags":[],"type":"text","url":"/en/docs/concepts-calculus#table-1--rules-as-writes","content":"`Inactive`","locale":"en"},"4278":{"id":"/en/docs/concepts-calculus-110","page_id":"/en/docs/concepts-calculus","tags":[],"type":"text","url":"/en/docs/concepts-calculus#table-1--rules-as-writes","content":"`g`","locale":"en"},"4279":{"id":"/en/docs/concepts-calculus-111","page_id":"/en/docs/concepts-calculus","tags":[],"type":"text","url":"/en/docs/concepts-calculus#table-1--rules-as-writes","content":"`θ_n`","locale":"en"},"4280":{"id":"/en/docs/concepts-calculus-112","page_id":"/en/docs/concepts-calculus","tags":[],"type":"text","url":"/en/docs/concepts-calculus#table-1--rules-as-writes","content":"Every step factors as `γ^{t+1} = edit^t(Ψ^t(γ^t))`: `Ψ` moves tables (data), `edit` moves control fields. This seam is what the metatheory exploits.","locale":"en"},"4281":{"id":"/en/docs/concepts-calculus-113","page_id":"/en/docs/concepts-calculus","tags":[],"type":"text","url":"/en/docs/concepts-calculus#engineering-take-aways-for-an-implementation","content":"Keep *two* views per fiber: the **target** (recomputed on every relevant change) and the **committed** view (fixed for the whole episode). Transitions fire on their inequality.","locale":"en"},"4282":{"id":"/en/docs/concepts-calculus-114","page_id":"/en/docs/concepts-calculus","tags":[],"type":"text","url":"/en/docs/concepts-calculus#engineering-take-aways-for-an-implementation","content":"Identify providers by a **never-reused id**, so that \"replaced by an equal value\" still triggers a reload.","locale":"en"},"4283":{"id":"/en/docs/concepts-calculus-115","page_id":"/en/docs/concepts-calculus","tags":[],"type":"text","url":"/en/docs/concepts-calculus#engineering-take-aways-for-an-implementation","content":"A provider counts as available **only while Active**.","locale":"en"},"4284":{"id":"/en/docs/concepts-calculus-116","page_id":"/en/docs/concepts-calculus","tags":[],"type":"text","url":"/en/docs/concepts-calculus#engineering-take-aways-for-an-implementation","content":"Mark a deactivating fiber **out of service first** (L-Leave), notify dependents, and run the accumulator only once no installed dependent still commits to it (the guard).","locale":"en"},"4285":{"id":"/en/docs/concepts-calculus-117","page_id":"/en/docs/concepts-calculus","tags":[],"type":"text","url":"/en/docs/concepts-calculus#engineering-take-aways-for-an-implementation","content":"Child instantiation is an ordinary tracked effect of the parent; its inverse only *retires* the child.","locale":"en"},"4286":{"id":"/en/docs/concepts-calculus-118","page_id":"/en/docs/concepts-calculus","tags":[],"type":"text","url":"/en/docs/concepts-calculus#engineering-take-aways-for-an-implementation","content":"Removal of the registry entry happens only after the fiber is Inactive and empty.","locale":"en"},"4287":{"id":"/en/docs/concepts-context-paradigm","page_id":"/en/docs/concepts-context-paradigm","type":"page","content":"The context paradigm","breadcrumbs":["kardia Documentation","Concepts"],"tags":[],"url":"/en/docs/concepts-context-paradigm","locale":"en"},"4288":{"id":"/en/docs/concepts-context-paradigm-0","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm","content":"Paper §3.3–3.4: one unified context mediating every effect and coeffect, observational equivalence, independence and coeffect commutativity.","locale":"en"},"4289":{"id":"/en/docs/concepts-context-paradigm-1","page_id":"/en/docs/concepts-context-paradigm","type":"heading","tags":[],"url":"/en/docs/concepts-context-paradigm#unified-context-331","content":"Unified context (§3.3.1)","locale":"en"},"4290":{"id":"/en/docs/concepts-context-paradigm-2","page_id":"/en/docs/concepts-context-paradigm","type":"heading","tags":[],"url":"/en/docs/concepts-context-paradigm#definition-28--context-type","content":"Definition 28 – context type","locale":"en"},"4291":{"id":"/en/docs/concepts-context-paradigm-3","page_id":"/en/docs/concepts-context-paradigm","type":"heading","tags":[],"url":"/en/docs/concepts-context-paradigm#definition-29--coeffect--value-type-operations","content":"Definition 29 – coeffect = (value type, operations)","locale":"en"},"4292":{"id":"/en/docs/concepts-context-paradigm-4","page_id":"/en/docs/concepts-context-paradigm","type":"heading","tags":[],"url":"/en/docs/concepts-context-paradigm#definition-30--context-mediated-iterators-ℑ𝒜_σs-p-p--s--k","content":"Definition 30 – context-mediated iterators `ℑ^𝒜_Σ(S, P)`, `P ⊆ S ⊆ K`","locale":"en"},"4293":{"id":"/en/docs/concepts-context-paradigm-5","page_id":"/en/docs/concepts-context-paradigm","type":"heading","tags":[],"url":"/en/docs/concepts-context-paradigm#hierarchical-composition","content":"Hierarchical composition","locale":"en"},"4294":{"id":"/en/docs/concepts-context-paradigm-6","page_id":"/en/docs/concepts-context-paradigm","type":"heading","tags":[],"url":"/en/docs/concepts-context-paradigm#observational-equivalence-332","content":"Observational equivalence (§3.3.2)","locale":"en"},"4295":{"id":"/en/docs/concepts-context-paradigm-7","page_id":"/en/docs/concepts-context-paradigm","type":"heading","tags":[],"url":"/en/docs/concepts-context-paradigm#independence-341","content":"Independence (§3.4.1)","locale":"en"},"4296":{"id":"/en/docs/concepts-context-paradigm-8","page_id":"/en/docs/concepts-context-paradigm","type":"heading","tags":[],"url":"/en/docs/concepts-context-paradigm#coeffect-commutativity-342","content":"Coeffect commutativity (§3.4.2)","locale":"en"},"4297":{"id":"/en/docs/concepts-context-paradigm-9","page_id":"/en/docs/concepts-context-paradigm","type":"heading","tags":[],"url":"/en/docs/concepts-context-paradigm#examples-that-drive-design-decisions","content":"Examples that drive design decisions","locale":"en"},"4298":{"id":"/en/docs/concepts-context-paradigm-10","page_id":"/en/docs/concepts-context-paradigm","type":"heading","tags":[],"url":"/en/docs/concepts-context-paradigm#what-the-decomposition-achieves","content":"What the decomposition achieves","locale":"en"},"4299":{"id":"/en/docs/concepts-context-paradigm-11","page_id":"/en/docs/concepts-context-paradigm","type":"heading","tags":[],"url":"/en/docs/concepts-context-paradigm#engineering-take-aways","content":"Engineering take-aways","locale":"en"},"4300":{"id":"/en/docs/concepts-context-paradigm-12","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm","content":"This page summarises §3.3–3.4 of the paper (arXiv:2608.25512). It is the part of the paper that turns *local* guarantees (one component, see Revertible effects and Reactive coeffects) into the precondition for *global* guarantees (many interleaved components, §4.3, see Metatheory).","locale":"en"},"4301":{"id":"/en/docs/concepts-context-paradigm-13","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#definition-28--context-type","content":"The projections are the current state (recursive), the accumulator reverting this level's effects, and the coeffect context. `effect` maps `𝔈Γ∞` to itself, collapsing the `∂`-tower into one self-similar type. Because the value family `𝒱` is unconstrained, **any shared mutable state can be encoded as a dependency**: `Σ` subsumes all shared state, not only inter-component dependencies. *Every interaction between a component and its environment passes through this single entity.*","locale":"en"},"4302":{"id":"/en/docs/concepts-context-paradigm-14","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#definition-29--coeffect--value-type-operations","content":"A coeffect at key `k` is a pair `(𝒱_k, 𝒜_k)`; each operation `a ∈ 𝒜_k` with argument `X_a` and outcome `B_a` acts **on the value alone**:","locale":"en"},"4303":{"id":"/en/docs/concepts-context-paradigm-15","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#definition-29--coeffect--value-type-operations","content":"That is, an effect function on the value plus an outcome. Its lift to `Σ` (eq. 31) reads and writes only the binding at `k`: typing confines the operation to its key. An operation that depends on another key must read that key's value into its argument. Operations induce an equivalence `≃_k` (§3.3.2, below).","locale":"en"},"4304":{"id":"/en/docs/concepts-context-paradigm-16","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#definition-30--context-mediated-iterators-ℑ𝒜_σs-p-p--s--k","content":"The least set of iterators containing the unit and closed under two **stage** forms:","locale":"en"},"4305":{"id":"/en/docs/concepts-context-paradigm-17","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#definition-30--context-mediated-iterators-ℑ𝒜_σs-p-p--s--k","content":"**operation stage**: perform `a ∈ 𝒜_k` for `k ∈ S`, and choose the continuation by the outcome;","locale":"en"},"4306":{"id":"/en/docs/concepts-context-paradigm-18","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#definition-30--context-mediated-iterators-ℑ𝒜_σs-p-p--s--k","content":"**provision stage**: `set(k, v)` for `k ∈ P` (a key no operation can create).","locale":"en"},"4307":{"id":"/en/docs/concepts-context-paradigm-19","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#definition-30--context-mediated-iterators-ℑ𝒜_σs-p-p--s--k","content":"Membership in this class *is* the formal content of \"mediate every interaction through the context\". Anything reading a location no key binds (for example an allocator drawing handles from a counter the context does not carry) is outside the class, and becomes mediated once that counter is bound at a key of its own.","locale":"en"},"4308":{"id":"/en/docs/concepts-context-paradigm-20","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#hierarchical-composition","content":"The recursive structure gives a tree: loading a component means executing its effects (plugging in); unloading means reverting them without affecting others; a parent aggregates the effects of all its children, which allows arbitrary nesting.","locale":"en"},"4309":{"id":"/en/docs/concepts-context-paradigm-21","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#observational-equivalence-332","content":"Theorem 7's state equality is an idealisation: `free` does not restore heap layout, and a fresh name is not \"un-drawn\". So equalities are read **up to an observational equivalence `≃`**: two states are related when no observer can distinguish them. An observer of a context is given its coeffects; an observer of a value is given its key's operations.","locale":"en"},"4310":{"id":"/en/docs/concepts-context-paradigm-22","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#observational-equivalence-332","content":"**Definition 31 – tests / indistinguishability.** A *test* over `𝒜` is a finite word of forward maps and yielded inverses of operations; `v ≈_𝒜 v′` when every test is defined at both or at neither and yields equal outcomes. `≃_k := ≈_{𝒜_k}`.","locale":"en"},"4311":{"id":"/en/docs/concepts-context-paradigm-23","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#observational-equivalence-332","content":"**Lemma 32**: `≃_k` is an equivalence respected by all operations of `𝒜_k`, and the *coarsest* such relation (proof principle: exhibit any respected equivalence containing the pair).","locale":"en"},"4312":{"id":"/en/docs/concepts-context-paradigm-24","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#observational-equivalence-332","content":"**Definition 33**: states related at key set `S` have the same domain on `S` and related values at each key. `≃` (`S = K`) is the finest; `≃_S` forgets keys outside `S`. Related states agree on satisfaction and on `notify_d`, so *reactivity is a property of `Σ/≃`*.","locale":"en"},"4313":{"id":"/en/docs/concepts-context-paradigm-25","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#observational-equivalence-332","content":"**Definition 34**: the logical-relation extension of `≃` to functions, products and `Maybe`, read coinductively for iterators. A map *respects* `≃` when it is related to itself.","locale":"en"},"4314":{"id":"/en/docs/concepts-context-paradigm-26","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#observational-equivalence-332","content":"**Lemma 35**: on maps and iterators `≃_S` is a partial equivalence.","locale":"en"},"4315":{"id":"/en/docs/concepts-context-paradigm-27","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#observational-equivalence-332","content":"**Definitions 36/37**: effect functions and iterators *witnessed up to `≃_S`*: `g(δ) ≃_S γ` instead of equality.","locale":"en"},"4316":{"id":"/en/docs/concepts-context-paradigm-28","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#observational-equivalence-332","content":"**Lemma 38**: all equalities of §3.1 hold with `=` replaced by `≃`.","locale":"en"},"4317":{"id":"/en/docs/concepts-context-paradigm-29","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#observational-equivalence-332","content":"**Lemma 39**: a context-mediated iterator lies in `ℑ^S_Σ` for any `S` containing the keys its stages touch.","locale":"en"},"4318":{"id":"/en/docs/concepts-context-paradigm-30","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#independence-341","content":"Independence is needed for two situations Theorem 16 does not cover: running an inverse while *later* effects are still in place (removing one component of a running system), and interleaving the effects of several components.","locale":"en"},"4319":{"id":"/en/docs/concepts-context-paradigm-31","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#independence-341","content":"**Definition 40**: `reach(i)` is the set of iterators reachable by continuation; the transformation monoid `𝔐(i)` is generated by all forward maps and yielded inverses in `reach(i)`; `len(i)` is the longest continuation chain.","locale":"en"},"4320":{"id":"/en/docs/concepts-context-paradigm-32","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#independence-341","content":"**Lemma 41**: commutation is settled on generators; `⋄` does not enlarge the monoid.","locale":"en"},"4321":{"id":"/en/docs/concepts-context-paradigm-33","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#independence-341","content":"**Definition 42 – independent iterators** `i, j`:","locale":"en"},"4322":{"id":"/en/docs/concepts-context-paradigm-34","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#independence-341","content":"every transformation of one commutes with every transformation of the other (`f ∘ g = g ∘ f` for `f ∈ 𝔐(i), g ∈ 𝔐(j)`);","locale":"en"},"4323":{"id":"/en/docs/concepts-context-paradigm-35","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#independence-341","content":"neither disturbs what the other *yields* (inverse and continuation): `pr₂,₃(i′(g(γ))) = pr₂,₃(i′(γ))`.","locale":"en"},"4324":{"id":"/en/docs/concepts-context-paradigm-36","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#independence-341","content":"**Theorem 43**: for pairwise independent `e₁…eₙ`, applying the yielded inverses **in any permutation** reaches `γ₀`. Each inverse withdraws its own contribution and nothing else, whatever the order.","locale":"en"},"4325":{"id":"/en/docs/concepts-context-paradigm-37","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#coeffect-commutativity-342","content":"**Definition 44**: operations `a, a′` are independent when their lifts are independent effect functions *and* neither disturbs the other's outcome. A key is **commutative** when any two of its operations (including an operation with itself) are independent.","locale":"en"},"4326":{"id":"/en/docs/concepts-context-paradigm-38","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#coeffect-commutativity-342","content":"**Theorem 45**: operations at **distinct keys** are always independent (key-local maps commute).","locale":"en"},"4327":{"id":"/en/docs/concepts-context-paradigm-39","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#coeffect-commutativity-342","content":"**Definition 46 – witnessed coeffect**: a coeffect carries, as a third constituent, a proof that its key is commutative. As with the effect witness, *the obligation falls on the component providing the key*, not on consumers. From here on every coeffect is assumed witnessed.","locale":"en"},"4328":{"id":"/en/docs/concepts-context-paradigm-40","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#examples-that-drive-design-decisions","content":"Key value","locale":"en"},"4329":{"id":"/en/docs/concepts-context-paradigm-41","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#examples-that-drive-design-decisions","content":"Commutative?","locale":"en"},"4330":{"id":"/en/docs/concepts-context-paradigm-42","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#examples-that-drive-design-decisions","content":"Why","locale":"en"},"4331":{"id":"/en/docs/concepts-context-paradigm-43","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#examples-that-drive-design-decisions","content":"Table of entries where each registration draws a **fresh id** (routes, event listeners)","locale":"en"},"4332":{"id":"/en/docs/concepts-context-paradigm-44","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#examples-that-drive-design-decisions","content":"**Yes**","locale":"en"},"4333":{"id":"/en/docs/concepts-context-paradigm-45","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#examples-that-drive-design-decisions","content":"Two registrations name two entries; either order answers every test alike; each can be withdrawn while the other stands. (The same reason CRDTs tag every addition uniquely.)","locale":"en"},"4334":{"id":"/en/docs/concepts-context-paradigm-46","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#examples-that-drive-design-decisions","content":"A set whose add/remove name a bare element","locale":"en"},"4335":{"id":"/en/docs/concepts-context-paradigm-47","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#examples-that-drive-design-decisions","content":"No","locale":"en"},"4336":{"id":"/en/docs/concepts-context-paradigm-48","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#examples-that-drive-design-decisions","content":"Removing `x` after two `add(x)` cannot tell whose `x` to remove.","locale":"en"},"4337":{"id":"/en/docs/concepts-context-paradigm-49","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#examples-that-drive-design-decisions","content":"Ordered middleware chain","locale":"en"},"4338":{"id":"/en/docs/concepts-context-paradigm-50","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#examples-that-drive-design-decisions","content":"**No**","locale":"en"},"4339":{"id":"/en/docs/concepts-context-paradigm-51","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#examples-that-drive-design-decisions","content":"A middleware inserted before another sees a different request. Order must be imposed from outside (by the accumulator within a component, or by a declared coeffect across components).","locale":"en"},"4340":{"id":"/en/docs/concepts-context-paradigm-52","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#examples-that-drive-design-decisions","content":"Allocator whose handles are never compared","locale":"en"},"4341":{"id":"/en/docs/concepts-context-paradigm-53","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#examples-that-drive-design-decisions","content":"Yes (up to renaming)","locale":"en"},"4342":{"id":"/en/docs/concepts-context-paradigm-54","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#examples-that-drive-design-decisions","content":"`≃_k` relates heaps up to handle renaming (cf. CompCert).","locale":"en"},"4343":{"id":"/en/docs/concepts-context-paradigm-55","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#examples-that-drive-design-decisions","content":"POSIX `open` (lowest free fd)","locale":"en"},"4344":{"id":"/en/docs/concepts-context-paradigm-56","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#examples-that-drive-design-decisions","content":"No","locale":"en"},"4345":{"id":"/en/docs/concepts-context-paradigm-57","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#examples-that-drive-design-decisions","content":"The outcome of a further allocation distinguishes the two orders. `mmap`/`creat` are fine.","locale":"en"},"4346":{"id":"/en/docs/concepts-context-paradigm-58","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#examples-that-drive-design-decisions","content":"*Interface design rule (from Definition 31):* publishing fewer outcomes coarsens `≃_k`; withholding an outcome callers do not need can make a key commutative (cf. the scalable commutativity rule).","locale":"en"},"4347":{"id":"/en/docs/concepts-context-paradigm-59","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#examples-that-drive-design-decisions","content":"**Theorem 47**: two context-mediated iterators with `P₁ ∩ S₂ = P₂ ∩ S₁ = ∅` (neither provides a key the other touches) and commutative shared keys are independent. With every coeffect witnessed, only that disjointness remains to check, and §4 (the calculus) reads it off the declarations.","locale":"en"},"4348":{"id":"/en/docs/concepts-context-paradigm-60","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#what-the-decomposition-achieves","content":"The **commuting part** of a computation is carried by effects: performed in any order, reverted in any order (Theorem 43). The **order-sensitive part** is carried by coeffects: within one component the accumulator imposes LIFO; across components a declared coeffect imposes \"provider before consumer\". Composability is therefore obtained at the grain of components, not of single effects.","locale":"en"},"4349":{"id":"/en/docs/concepts-context-paradigm-61","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#what-the-decomposition-achieves","content":"**Limit:** binding every shared location at a key is a *discipline*, not a property of the construction. A location the system cannot reify as a coeffect lies outside the theorem (see the system boundary, §6.1, on Discussion and related work).","locale":"en"},"4350":{"id":"/en/docs/concepts-context-paradigm-62","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#engineering-take-aways","content":"Design every shared registry as \"**insert with fresh id, remove by id**\". This is exactly what makes keys commutative and lets components be unloaded in any order.","locale":"en"},"4351":{"id":"/en/docs/concepts-context-paradigm-63","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#engineering-take-aways","content":"Order-sensitive structures (middleware chains, priority lists) must either be owned by a single component, or have their order made explicit (for example explicit priority values) so that the observable result does not depend on insertion order.","locale":"en"},"4352":{"id":"/en/docs/concepts-context-paradigm-64","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#engineering-take-aways","content":"Do not let a component reach shared state except through the context; anything else is outside the guarantees.","locale":"en"},"4353":{"id":"/en/docs/concepts-context-paradigm-65","page_id":"/en/docs/concepts-context-paradigm","tags":[],"type":"text","url":"/en/docs/concepts-context-paradigm#engineering-take-aways","content":"**In kardia:** `kardia_core::IdTable<T>` is this registry: `insert` returns a fresh, never-reused id, `remove` takes that id, and entries stay in insertion order. Service authors should build their registries (routes, listeners, commands) on it. See Services and API design.","locale":"en"},"4354":{"id":"/en/docs/concepts-implementation","page_id":"/en/docs/concepts-implementation","type":"page","content":"Implementation in the paper","breadcrumbs":["kardia Documentation","Concepts"],"tags":[],"url":"/en/docs/concepts-implementation","locale":"en"},"4355":{"id":"/en/docs/concepts-implementation-0","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation","content":"Paper §5: what the paper says Cordis does, from the theory-to-runtime table (Table 2) through Algorithms 1–10 for effects, coeffects, the lifecycle, the loader and HMR, to the Koishi case study.","locale":"en"},"4356":{"id":"/en/docs/concepts-implementation-1","page_id":"/en/docs/concepts-implementation","type":"heading","tags":[],"url":"/en/docs/concepts-implementation#table-2--theory--runtime","content":"Table 2 – theory ↔ runtime","locale":"en"},"4357":{"id":"/en/docs/concepts-implementation-2","page_id":"/en/docs/concepts-implementation","type":"heading","tags":[],"url":"/en/docs/concepts-implementation#effect-tracking-511-algorithm-1","content":"Effect tracking (§5.1.1, Algorithm 1)","locale":"en"},"4358":{"id":"/en/docs/concepts-implementation-3","page_id":"/en/docs/concepts-implementation","type":"heading","tags":[],"url":"/en/docs/concepts-implementation#coeffect-operations-512-algorithms-23","content":"Coeffect operations (§5.1.2, Algorithms 2–3)","locale":"en"},"4359":{"id":"/en/docs/concepts-implementation-4","page_id":"/en/docs/concepts-implementation","type":"heading","tags":[],"url":"/en/docs/concepts-implementation#component-lifecycle-513-algorithms-45","content":"Component lifecycle (§5.1.3, Algorithms 4–5)","locale":"en"},"4360":{"id":"/en/docs/concepts-implementation-5","page_id":"/en/docs/concepts-implementation","type":"heading","tags":[],"url":"/en/docs/concepts-implementation#context-access-514-algorithm-6","content":"Context access (§5.1.4, Algorithm 6)","locale":"en"},"4361":{"id":"/en/docs/concepts-implementation-6","page_id":"/en/docs/concepts-implementation","type":"heading","tags":[],"url":"/en/docs/concepts-implementation#component-loader-52","content":"Component loader (§5.2)","locale":"en"},"4362":{"id":"/en/docs/concepts-implementation-7","page_id":"/en/docs/concepts-implementation","type":"heading","tags":[],"url":"/en/docs/concepts-implementation#declarative-configuration-521","content":"Declarative configuration (§5.2.1)","locale":"en"},"4363":{"id":"/en/docs/concepts-implementation-8","page_id":"/en/docs/concepts-implementation","type":"heading","tags":[],"url":"/en/docs/concepts-implementation#hot-module-replacement-522","content":"Hot module replacement (§5.2.2)","locale":"en"},"4364":{"id":"/en/docs/concepts-implementation-9","page_id":"/en/docs/concepts-implementation","type":"heading","tags":[],"url":"/en/docs/concepts-implementation#case-study-koishi-53","content":"Case study: Koishi (§5.3)","locale":"en"},"4365":{"id":"/en/docs/concepts-implementation-10","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation","content":"This page records what the *paper* (arXiv:2608.25512, §5) says Cordis does: Algorithms 1–10 and Table 2. It sits between theory and design. The actual TypeScript code differs in several details; those differences are catalogued on Paper vs. code, and the code itself is described in the Cordis reference.","locale":"en"},"4366":{"id":"/en/docs/concepts-implementation-11","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation","content":"Cordis is a **meta-framework**: it prescribes no domain (no routing, ORM or UI); its only responsibility is universal dynamic-composition semantics. It has three tiers:","locale":"en"},"4367":{"id":"/en/docs/concepts-implementation-12","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation","content":"the **core library**: effect and coeffect systems (§5.1);","locale":"en"},"4368":{"id":"/en/docs/concepts-implementation-13","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation","content":"the **component loader**: configuration reconciliation and HMR (§5.2);","locale":"en"},"4369":{"id":"/en/docs/concepts-implementation-14","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation","content":"**application frameworks**, for example Koishi (§5.3).","locale":"en"},"4370":{"id":"/en/docs/concepts-implementation-15","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#table-2--theory--runtime","content":"Theory","locale":"en"},"4371":{"id":"/en/docs/concepts-implementation-16","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#table-2--theory--runtime","content":"Runtime","locale":"en"},"4372":{"i