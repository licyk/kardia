run it once.","locale":"en"},"7628":{"id":"/en/docs/reference-events-16","page_id":"/en/docs/reference-events","tags":[],"type":"text","url":"/en/docs/reference-events#dispatch","content":"`events.ts:110-163`:","locale":"en"},"7629":{"id":"/en/docs/reference-events-17","page_id":"/en/docs/reference-events","tags":[],"type":"text","url":"/en/docs/reference-events#dispatch","content":"Mode","locale":"en"},"7630":{"id":"/en/docs/reference-events-18","page_id":"/en/docs/reference-events","tags":[],"type":"text","url":"/en/docs/reference-events#dispatch","content":"Semantics","locale":"en"},"7631":{"id":"/en/docs/reference-events-19","page_id":"/en/docs/reference-events","tags":[],"type":"text","url":"/en/docs/reference-events#dispatch","content":"`emit`","locale":"en"},"7632":{"id":"/en/docs/reference-events-20","page_id":"/en/docs/reference-events","tags":[],"type":"text","url":"/en/docs/reference-events#dispatch","content":"synchronous, all listeners, return ignored","locale":"en"},"7633":{"id":"/en/docs/reference-events-21","page_id":"/en/docs/reference-events","tags":[],"type":"text","url":"/en/docs/reference-events#dispatch","content":"`parallel`","locale":"en"},"7634":{"id":"/en/docs/reference-events-22","page_id":"/en/docs/reference-events","tags":[],"type":"text","url":"/en/docs/reference-events#dispatch","content":"`Promise.allSettled`; failures aggregated into `AggregateError`","locale":"en"},"7635":{"id":"/en/docs/reference-events-23","page_id":"/en/docs/reference-events","tags":[],"type":"text","url":"/en/docs/reference-events#dispatch","content":"`serial`","locale":"en"},"7636":{"id":"/en/docs/reference-events-24","page_id":"/en/docs/reference-events","tags":[],"type":"text","url":"/en/docs/reference-events#dispatch","content":"sequential `await`; stops at the first \"bailed\" result (not `null/undefined/false`)","locale":"en"},"7637":{"id":"/en/docs/reference-events-25","page_id":"/en/docs/reference-events","tags":[],"type":"text","url":"/en/docs/reference