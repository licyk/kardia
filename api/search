docs/development-status","tags":[],"type":"text","url":"/en/docs/development-status#phases","content":"**3. Services & built-ins**","locale":"en"},"5311":{"id":"/en/docs/development-status-22","page_id":"/en/docs/development-status","tags":[],"type":"text","url":"/en/docs/development-status#phases","content":"`Service`/`Svc<S>` caller attribution, interception merge, typed events + internal events, logger + exporters, `kardia-timer`, `kardia-logger-console`","locale":"en"},"5312":{"id":"/en/docs/development-status-23","page_id":"/en/docs/development-status","tags":[],"type":"text","url":"/en/docs/development-status#phases","content":"Phase-3 specs green; example app with a provider/consumer pair and hot provider replacement","locale":"en"},"5313":{"id":"/en/docs/development-status-24","page_id":"/en/docs/development-status","tags":[],"type":"text","url":"/en/docs/development-status#phases","content":"**4. Loader**","locale":"en"},"5314":{"id":"/en/docs/development-status-25","page_id":"/en/docs/development-status","tags":[],"type":"text","url":"/en/docs/development-status#phases","content":"`EntryOptions`, validation, `EntryTree`/`EntryGroup`/`Group`, entry state machine, outer/inner fibers, catalog, managed realms + migration, write-back hooks, `loader` barrier; `kardia` binary bootstrapping a root with the loader","locale":"en"},"5315":{"id":"/en/docs/development-status-26","page_id":"/en/docs/development-status","tags":[],"type":"text","url":"/en/docs/development-status#phases","content":"loader specs (minus expressions) green","locale":"en"},"5316":{"id":"/en/docs/development-status-27","page_id":"/en/docs/development-status","tags":[],"type":"text","url":"/en/docs/development-status#phases","content":"**5. Include & fs**","locale":"en"},"5317":{"id":"/en/docs/development-status-28","page_id":"/en/docs/development-status","tags":[],"type":"text","url":"/en/docs/development-status#phases","content":"`kardia-fs` watcher; `kardia-include` parse/journal/patch/sync/a