is","locale":"en"},"8324":{"id":"/en/docs/reference-services-10","page_id":"/en/docs/reference-services","tags":[],"type":"text","url":"/en/docs/reference-services#problem","content":"Governs","locale":"en"},"8325":{"id":"/en/docs/reference-services-11","page_id":"/en/docs/reference-services","tags":[],"type":"text","url":"/en/docs/reference-services#problem","content":"**use site**","locale":"en"},"8326":{"id":"/en/docs/reference-services-12","page_id":"/en/docs/reference-services","tags":[],"type":"text","url":"/en/docs/reference-services#problem","content":"the context the service was accessed from (the caller)","locale":"en"},"8327":{"id":"/en/docs/reference-services-13","page_id":"/en/docs/reference-services","tags":[],"type":"text","url":"/en/docs/reference-services#problem","content":"*effects*, *interception*, *isolation*","locale":"en"},"8328":{"id":"/en/docs/reference-services-14","page_id":"/en/docs/reference-services","tags":[],"type":"text","url":"/en/docs/reference-services#problem","content":"**def site**","locale":"en"},"8329":{"id":"/en/docs/reference-services-15","page_id":"/en/docs/reference-services","tags":[],"type":"text","url":"/en/docs/reference-services#problem","content":"the context where the accessing code was defined (the service's own context when code inside the service runs)","locale":"en"},"8330":{"id":"/en/docs/reference-services-16","page_id":"/en/docs/reference-services","tags":[],"type":"text","url":"/en/docs/reference-services#problem","content":"*service resolution* (which `inject` declarations admit access)","locale":"en"},"8331":{"id":"/en/docs/reference-services-17","page_id":"/en/docs/reference-services","tags":[],"type":"text","url":"/en/docs/reference-services#service","content":"`service.ts`:","locale":"en"},"8332":{"id":"/en/docs/reference-services-18","page_id":"/en/docs/reference-services","tags":[],"type":"text","url":"/en/docs/reference-services#service","content":"Constructing a `Service` inside a plugin's `apply` 