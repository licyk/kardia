age_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#using-a-service","content":"Access","locale":"en"},"7157":{"id":"/en/docs/guide-plugins-49","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#using-a-service","content":"Checked against","locale":"en"},"7158":{"id":"/en/docs/guide-plugins-50","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#using-a-service","content":"Fails with","locale":"en"},"7159":{"id":"/en/docs/guide-plugins-51","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#using-a-service","content":"`ctx.get::<S>()`","locale":"en"},"7160":{"id":"/en/docs/guide-plugins-52","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#using-a-service","content":"The plugin's declared dependencies, at run time","locale":"en"},"7161":{"id":"/en/docs/guide-plugins-53","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#using-a-service","content":"`AccessError::Undeclared` if `S` is not declared; `AccessError::Inactive` if it is declared but has no binding","locale":"en"},"7162":{"id":"/en/docs/guide-plugins-54","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#using-a-service","content":"`Injected<D>::get::<S, _>()`","locale":"en"},"7163":{"id":"/en/docs/guide-plugins-55","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#using-a-service","content":"`D`, at compile time","locale":"en"},"7164":{"id":"/en/docs/guide-plugins-56","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#using-a-service","content":"A compile error if `S` is not in `D`","locale":"en"},"7165":{"id":"/en/docs/guide-plugins-57","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#using-a-service","content":"`Injected<D>::deps()`,