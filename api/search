d":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#table-2--theory--runtime","content":"O-Insert, O-Retire","locale":"en"},"4415":{"id":"/en/docs/concepts-implementation-60","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#table-2--theory--runtime","content":"`ctx.use` and the inverse of its callback","locale":"en"},"4416":{"id":"/en/docs/concepts-implementation-61","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#table-2--theory--runtime","content":"O-Remove","locale":"en"},"4417":{"id":"/en/docs/concepts-implementation-62","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#table-2--theory--runtime","content":"fiber dropped from its runtime, uid cleared","locale":"en"},"4418":{"id":"/en/docs/concepts-implementation-63","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#table-2--theory--runtime","content":"L-Begin/Iter/Finish","locale":"en"},"4419":{"id":"/en/docs/concepts-implementation-64","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#table-2--theory--runtime","content":"`execute`'s iteration loop","locale":"en"},"4420":{"id":"/en/docs/concepts-implementation-65","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#table-2--theory--runtime","content":"L-Divert","locale":"en"},"4421":{"id":"/en/docs/concepts-implementation-66","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#table-2--theory--runtime","content":"guard failing at an iteration boundary, or reload chaining into unload","locale":"en"},"4422":{"id":"/en/docs/concepts-implementation-67","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#table-2--theory--runtime","content":"L-Leave","locale":"en"},"4423":{"id":"/en/docs/concepts-implementation-68","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#table-2--theory--runtime","content":"`refresh` marking the fiber `UNLOADING`","locale":"en"},"4424":{"id":"/en/docs/concepts-implementation-69","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#table-2--theory--runtime","content":"L-Unload","locale":"en"},"4425":{"id":"/en/docs/concepts-implementation-70","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#table-2--theory--runtime","content":"`unload` and its inertial chaining","locale":"en"},"4426":{"id":"/en/docs/concepts-implementation-71","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#table-2--theory--runtime","content":"guard","locale":"en"},"4427":{"id":"/en/docs/concepts-implementation-72","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#table-2--theory--runtime","content":"`unload` awaiting notified dependents","locale":"en"},"4428":{"id":"/en/docs/concepts-implementation-73","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#table-2--theory--runtime","content":"failure","locale":"en"},"4429":{"id":"/en/docs/concepts-implementation-74","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#table-2--theory--runtime","content":"error recorded on the fiber, target set to `⊥`","locale":"en"},"4430":{"id":"/en/docs/concepts-implementation-75","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#table-2--theory--runtime","content":"For the same mapping extended to kardia's Rust types, see the concept mapping on Development.","locale":"en"},"4431":{"id":"/en/docs/concepts-implementation-76","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#effect-tracking-511-algorithm-1","content":"Every context mutation (provision, instantiation, listeners, …) reduces to one primitive, `ctx.effect`, so any operation performed through the context is automatically tracked.","locale":"en"},"4432":{"id":"/en/docs/concepts-implementation-77","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#effect-tracking-511-algorithm-1","content":"`effect` accepts both effect functions and iterators (ad-hoc polymorphism); the guard is checked at each iteration boundary.","locale":"en"},"4433":{"id":"/en/docs/concepts-implementation-78","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#effect-tracking-511-algorithm-1","content":"**Not checked:** the witness (that the inverse really reverts) and the coeffect commutativity witness. These are author and provider obligations.","locale":"en"},"4434":{"id":"/en/docs/concepts-implementation-79","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#effect-tracking-511-algorithm-1","content":"The component level reuses `execute` with a guard testing the stability of `fiber.target`.","locale":"en"},"4435":{"id":"/en/docs/concepts-implementation-80","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#coeffect-operations-512-algorithms-23","content":"Each context carries three symbol-keyed slots: `@@store` (realm symbol → value), `@@isolate` (key → realm symbol) and `@@intercept` (key → metadata).","locale":"en"},"4436":{"id":"/en/docs/concepts-implementation-81","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#coeffect-operations-512-algorithms-23","content":"A binding counts as available only while the installing fiber is `ACTIVE`; a provider entering `UNLOADING` stops providing, so dependents recompute an unsatisfied target and begin their own teardown *while its bindings are still in place*.","locale":"en"},"4437":{"id":"/en/docs/concepts-implementation-82","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#coeffect-operations-512-algorithms-23","content":"`isolate` and `intercept` derive a child context overriding one inherited table; recovery is implicit (discard the child). `isolate` defaults to a freshly generated symbol; `intercept` merges new metadata over the inherited value (the new value wins).","locale":"en"},"4438":{"id":"/en/docs/concepts-implementation-83","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#component-lifecycle-513-algorithms-45","content":"How `refresh`, `reload` and `unload` chain into one another:","locale":"en"},"4439":{"id":"/en/docs/concepts-implementation-84","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#component-lifecycle-513-algorithms-45","content":"Footnote 2 addresses Rust explicitly: *\"with lazy scheduling (e.g. Python coroutines, Rust futures) the host must spawn the task for it to progress\"*. The algorithms write `create_task` out for language independence.","locale":"en"},"4440":{"id":"/en/docs/concepts-implementation-85","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#component-lifecycle-513-algorithms-45","content":"**In kardia:** transitions and asynchronous effect bodies are spawned as tokio tasks, so they progress without being polled by the caller, and they are never dropped half-way. All lifecycle bookkeeping happens in short critical sections under one state lock per root; no user code runs while the lock is held. See Concurrency.","locale":"en"},"4441":{"id":"/en/docs/concepts-implementation-86","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#component-lifecycle-513-algorithms-45","content":"`fiber.target` is a digest tupling the uid of each declared key's provider. A **uid is never reused**, so a replaced provider is never mistaken for the old one even if the values are equal. Consequently a provider overwriting its own binding *in place* is not observed: to propagate a replacement, withdraw and re-install.","locale":"en"},"4442":{"id":"/en/docs/concepts-implementation-87","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#component-lifecycle-513-algorithms-45","content":"There are two levels of checking: the transition level (`reload`/`unload` check the target at completion, giving inertial chaining) and the iteration level (`execute` checks at every boundary, giving partial rollback).","locale":"en"},"4443":{"id":"/en/docs/concepts-implementation-88","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#component-lifecycle-513-algorithms-45","content":"Three lines carry Theorem 70: commit at reload start, and discard the committed view only after every inverse; mark `UNLOADING` before scheduling the task; `unload` waits for each notified dependent. The wait sits **before** the whole recovery, since `fiber.dispose` initiates a fiber's effects concurrently.","locale":"en"},"4444":{"id":"/en/docs/concepts-implementation-89","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#component-lifecycle-513-algorithms-45","content":"Termination follows Theorem 73 (Metatheory): the provider graph is traversed on demand.","locale":"en"},"4445":{"id":"/en/docs/concepts-implementation-90","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#context-access-514-algorithm-6","content":"Besides reflective `ctx.get`/`ctx.set`, coeffects are read as **properties** (`ctx[key]`) through a JavaScript `Proxy`:","locale":"en"},"4446":{"id":"/en/docs/concepts-implementation-91","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#context-access-514-algorithm-6","content":"Unlike `ctx.get` (which never fails), the proxy resolves against the accessing fiber's **committed view** and enforces the specification at the point of use. Reading the view rather than the store is what keeps a dependency readable during the consumer's own teardown (Theorem 70). The check is made at runtime but, since `inject` is static, could be made at compile time (§6.4, for example with Rust procedural macros or traits; see Discussion and related work).","locale":"en"},"4447":{"id":"/en/docs/concepts-implementation-92","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#context-access-514-algorithm-6","content":"**In kardia:** there is no proxy. `ctx.get::<S>()` performs Algorithm 6 against committed views and fails with `AccessError::Undeclared`, `AccessError::Inactive` or `AccessError::TypeMismatch`; `ctx.live::<S>()` is the reflective read of the live store, which never fails for an undeclared key. The compile-time check is there too: a `#[plugin]` function taking `Injected<(A, B)>` declares `A` and `B`, and `get::<S, _>()` on it does not compile for an undeclared `S`. See Services and Plugins.","locale":"en"},"4448":{"id":"/en/docs/concepts-implementation-93","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#declarative-configuration-521","content":"**Definition 81 – entry:** `id` (stable reconciliation key), `url` (component module), `isolate`, `intercept`, `config`, `disabled`. An entry is a faithful specification because it records exactly what the support set reads: `disabled` → `τ`, tree parent → `π`, `url` → `(d, p)`. Entries form a **configuration tree**; `@cordisjs/group` loads a list of child entries; `@cordisjs/include` grafts an external YAML or JSON file. Binding is **bidirectional**: a component that revises its own config or disables itself has the change written back.","locale":"en"},"4449":{"id":"/en/docs/concepts-implementation-94","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#declarative-configuration-521","content":"**Reconciliation** is incremental, justified by Theorem 80 (the endpoint is a function of the final config), Theorem 73 (it quiesces), Corollary 69 (rebuilding one entry leaves its neighbours untouched) and Theorem 70 (entries can be instantiated together, and a fiber waits at L-Begin, so **modules are loaded concurrently**). Changes are dispatched per field:","locale":"en"},"4450":{"id":"/en/docs/concepts-implementation-95","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#declarative-configuration-521","content":"Field changed","locale":"en"},"4451":{"id":"/en/docs/concepts-implementation-96","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#declarative-configuration-521","content":"Action","locale":"en"},"4452":{"id":"/en/docs/concepts-implementation-97","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#declarative-configuration-521","content":"`id`, `url`","locale":"en"},"4453":{"id":"/en/docs/concepts-implementation-98","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#declarative-configuration-521","content":"rebuild the entry","locale":"en"},"4454":{"id":"/en/docs/concepts-implementation-99","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#declarative-configuration-521","content":"`isolate`","locale":"en"},"4455":{"id":"/en/docs/concepts-implementation-100","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#declarative-configuration-521","content":"reassign realms (Algorithm 7)","locale":"en"},"4456":{"id":"/en/docs/concepts-implementation-101","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#declarative-configuration-521","content":"`intercept`","locale":"en"},"4457":{"id":"/en/docs/concepts-implementation-102","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#declarative-configuration-521","content":"update in place (consulted at read time; no reload)","locale":"en"},"4458":{"id":"/en/docs/concepts-implementation-103","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#declarative-configuration-521","content":"`config`","locale":"en"},"4459":{"id":"/en/docs/concepts-implementation-104","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#declarative-configuration-521","content":"hand to the component, which typically diffs and reloads only on a material change. A group's config is its child list, so it gets a keyed diff over child ids, recursing","locale":"en"},"4460":{"id":"/en/docs/concepts-implementation-105","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#declarative-configuration-521","content":"`disabled`","locale":"en"},"4461":{"id":"/en/docs/concepts-implementation-106","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#declarative-configuration-521","content":"unload when set, reload when cleared","locale":"en"},"4462":{"id":"/en/docs/concepts-implementation-107","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#declarative-configuration-521","content":"**Managed realms.** `isolate: true` gives a *local* realm private to the entry, tagged by its id and carried along when the entry moves; `isolate: \"name\"` gives a *global* realm shared by every entry naming that string. A realm is discarded once no entry names it.","locale":"en"},"4463":{"id":"/en/docs/concepts-implementation-108","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#declarative-configuration-521","content":"**Algorithm 7 – realm reassignment with delimiters.** There is one delimiter symbol `δ_k` per key; each context stores a tag under `δ_k`, inherited by descendants and redrawn on each reassignment, so that `γ′[δ_k] = d₁ ⇔ γ′` derives from the entry's context.","locale":"en"},"4464":{"id":"/en/docs/concepts-implementation-109","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#declarative-configuration-521","content":"A dependent gains or loses the binding exactly when the move separates it from the provider.","locale":"en"},"4465":{"id":"/en/docs/concepts-implementation-110","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#declarative-configuration-521","content":"**In kardia:** the declarative loader is the `kardia-loader` crate (entries, groups, realms and a plugin `Catalog`), and file-backed include with two-way sync is `kardia-include`. See Loader and Loader internals.","locale":"en"},"4466":{"id":"/en/docs/concepts-implementation-111","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#hot-module-replacement-522","content":"Because a fiber bounds all of a component's effects, a module that is a component can be replaced through fiber operations alone, with **no developer-annotated acceptance boundaries** (unlike Webpack or Vite).","locale":"en"},"4467":{"id":"/en/docs/concepts-implementation-112","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#hot-module-replacement-522","content":"**Phase 1 – classification (Algorithm 8).** The inputs are `stashed` (the changed files) and `externals` (non-replaceable modules, whose change needs a full restart). A fixed point over `get_imports`: a pending module is *accepted* if one of its imports is accepted, and *declined* if all its imports are declined; leftovers (cycles) default to declined.","locale":"en"},"4468":{"id":"/en/docs/concepts-implementation-113","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#hot-module-replacement-522","content":"**Phase 2 – stale-entry detection (Algorithm 9).** For each entry, collect the transitive imports of `entry.url`, stopping at declined modules; if the tree meets `accepted`, the entry is stale and its tree is folded into `accepted`.","locale":"en"},"4469":{"id":"/en/docs/concepts-implementation-114","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#hot-module-replacement-522","content":"**Phase 3 – transactional reload (Algorithm 10).** Invalidate the caches of accepted modules (backing them up), re-import each stale entry and swap in a fresh fiber; on any error, restore the caches and rebuild every stale entry from the backup, then rethrow. The system never enters a half-reloaded state. (On Node.js both the ESM and the CJS caches are cleared.)","locale":"en"},"4470":{"id":"/en/docs/concepts-implementation-115","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#hot-module-replacement-522","content":"**In kardia:** Rust has no module registry, so `kardia-hmr` keeps its own `ModuleGraph`, loaded from a `ModuleSource` (WebAssembly, dynamic libraries or child processes), and replaces the plugins a changed module exports through `registry.replace`. Changed host modules are reported for a restart instead of being applied. A failed import aborts only its own unit (the plugins whose modules it shares), whose cache entries are restored, while the other units are applied. See Hot reload and Loader internals.","locale":"en"},"4471":{"id":"/en/docs/concepts-implementation-116","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#case-study-koishi-53","content":"Koishi is a chatbot framework, 4+ years old, with more than 4000 community plugins (IM adapters, database drivers, consoles, features); its web console is a second, independent Cordis application in the browser. The model is therefore **expressive** (sufficient for a production system) and **general** (no domain or runtime presupposed).","locale":"en"},"4472":{"id":"/en/docs/concepts-implementation-117","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#case-study-koishi-53","content":"Disabling a plugin from the console reverts its effects in place; HMR re-applies edited plugins on save while preserving caches and connections elsewhere. Authors get ordered cleanup without writing an uninstall path.","locale":"en"},"4473":{"id":"/en/docs/concepts-implementation-118","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#case-study-koishi-53","content":"There is genuine dependency topology (adapters, databases, features). Reconfiguring a provider reactivates only the dependents whose resolved dependency changed; a plugin with an unavailable dependency waits without erroring.","locale":"en"},"4474":{"id":"/en/docs/concepts-implementation-119","page_id":"/en/docs/concepts-implementation","tags":[],"type":"text","url":"/en/docs/concepts-implementation#case-study-koishi-53","content":"**Threats to validity:** a single ecosystem, a single language, observational evidence; measuring overhead and productivity is future work.","locale":"en"},"4475":{"id":"/en/docs/concepts-metatheory","page_id":"/en/docs/concepts-metatheory","type":"page","content":"Metatheory and extensions","breadcrumbs":["kardia Documentation","Concepts"],"tags":[],"url":"/en/docs/concepts-metatheory","locale":"en"},"4476":{"id":"/en/docs/concepts-metatheory-0","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory","content":"Paper §4.3–4.4: preservation, recovery exactness, ordering, resolution coherence, progress and confluence, and the extensions for asynchrony, failure, isolation and configuration.","locale":"en"},"4477":{"id":"/en/docs/concepts-metatheory-1","page_id":"/en/docs/concepts-metatheory","type":"heading","tags":[],"url":"/en/docs/concepts-metatheory#setup-43-definition-58","content":"Setup (§4.3, Definition 58)","locale":"en"},"4478":{"id":"/en/docs/concepts-metatheory-2","page_id":"/en/docs/concepts-metatheory","type":"heading","tags":[],"url":"/en/docs/concepts-metatheory#preservation-431","content":"Preservation (§4.3.1)","locale":"en"},"4479":{"id":"/en/docs/concepts-metatheory-3","page_id":"/en/docs/concepts-metatheory","type":"heading","tags":[],"url":"/en/docs/concepts-metatheory#temporal-composability-global-form-432","content":"Temporal composability, global form (§4.3.2)","locale":"en"},"4480":{"id":"/en/docs/concepts-metatheory-4","page_id":"/en/docs/concepts-metatheory","type":"heading","tags":[],"url":"/en/docs/concepts-metatheory#spatial-composability-global-form-433","content":"Spatial composability, global form (§4.3.3)","locale":"en"},"4481":{"id":"/en/docs/concepts-metatheory-5","page_id":"/en/docs/concepts-metatheory","type":"heading","tags":[],"url":"/en/docs/concepts-metatheory#progress-434","content":"Progress (§4.3.4)","locale":"en"},"4482":{"id":"/en/docs/concepts-metatheory-6","page_id":"/en/docs/concepts-metatheory","type":"heading","tags":[],"url":"/en/docs/concepts-metatheory#confluence-435","content":"Confluence (§4.3.5)","locale":"en"},"4483":{"id":"/en/docs/concepts-metatheory-7","page_id":"/en/docs/concepts-metatheory","type":"heading","tags":[],"url":"/en/docs/concepts-metatheory#extensions-44","content":"Extensions (§4.4)","locale":"en"},"4484":{"id":"/en/docs/concepts-metatheory-8","page_id":"/en/docs/concepts-metatheory","type":"heading","tags":[],"url":"/en/docs/concepts-metatheory#asynchrony-and-inertia","content":"Asynchrony and inertia","locale":"en"},"4485":{"id":"/en/docs/concepts-metatheory-9","page_id":"/en/docs/concepts-metatheory","type":"heading","tags":[],"url":"/en/docs/concepts-metatheory#failure","content":"Failure","locale":"en"},"4486":{"id":"/en/docs/concepts-metatheory-10","page_id":"/en/docs/concepts-metatheory","type":"heading","tags":[],"url":"/en/docs/concepts-metatheory#isolation","content":"Isolation","locale":"en"},"4487":{"id":"/en/docs/concepts-metatheory-11","page_id":"/en/docs/concepts-metatheory","type":"heading","tags":[],"url":"/en/docs/concepts-metatheory#configuration","content":"Configuration","locale":"en"},"4488":{"id":"/en/docs/concepts-metatheory-12","page_id":"/en/docs/concepts-metatheory","type":"heading","tags":[],"url":"/en/docs/concepts-metatheory#obligations-the-theory-places-on-an-implementation","content":"Obligations the theory places on an implementation","locale":"en"},"4489":{"id":"/en/docs/concepts-metatheory-13","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory","content":"This page summarises §4.3–4.4 of the paper (arXiv:2608.25512). Each theorem is stated informally, with the practical guarantee it buys and the implementation obligation it implies. The rules it reasons about are on the calculus page.","locale":"en"},"4490":{"id":"/en/docs/concepts-metatheory-14","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory","content":"**In kardia:** several of these theorems are property tests. `crates/kardia-core/tests/model.rs` runs random orchestration sequences of synthetic components (writes to a shared table, each with an exact inverse) under real tokio schedules with random delays. It checks ordering (Theorem 70) during every run, and preservation (Theorem 64), recovery exactness (Theorem 68 / Corollary 69) and confluence (the Active fibers are exactly the support set, Theorem 80) at quiescence. See Testing.","locale":"en"},"4491":{"id":"/en/docs/concepts-metatheory-15","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#setup-43-definition-58","content":"Steps are indexed by `t`; `step^t = r(n)` is the rule applied and the fiber it acts on. Runs start from an empty registry. An **episode** of `n` is a maximal interval during which `installed_n` holds; it opens just after an L-Begin and closes at an L-Unload. Every step factors as `γ^{t+1} = edit^t(Ψ^t(γ^t))`; tables (`σ_m`) move only inside `Ψ`, control fields (`θ, τ, π, d, p, e`, the registry domain) only inside `edit` (except through instantiation). States are compared with a `≃` that keeps all control fields (eq. 54).","locale":"en"},"4492":{"id":"/en/docs/concepts-metatheory-16","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#setup-43-definition-58","content":"**Lemma 59 (lookups in Table 1):**","locale":"en"},"4493":{"id":"/en/docs/concepts-metatheory-17","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#setup-43-definition-58","content":"a table moves only inside a `Ψ` of its own fiber or of a fiber declaring keys it holds (values only, domain unchanged);","locale":"en"},"4494":{"id":"/en/docs/concepts-metatheory-18","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#setup-43-definition-58","content":"`ω_n` is created only by L-Begin and destroyed only by L-Unload, so it is **constant over an episode**;","locale":"en"},"4495":{"id":"/en/docs/concepts-metatheory-19","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#setup-43-definition-58","content":"only L-Unload(n) applies `g_n`;","locale":"en"},"4496":{"id":"/en/docs/concepts-metatheory-20","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#setup-43-definition-58","content":"episodes open by L-Begin and close by L-Unload;","locale":"en"},"4497":{"id":"/en/docs/concepts-metatheory-21","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#setup-43-definition-58","content":"`π, d, p, e` are written once at insertion; `τ` is monotone (only O-Retire writes it, and only to `⊤`).","locale":"en"},"4498":{"id":"/en/docs/concepts-metatheory-22","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#setup-43-definition-58","content":"**Lemma 60 (≃-invariance)**: the rules cannot distinguish `≃`-related states. **Lemma 61 (equivariance)**: results hold up to renaming fiber names. **Lemma 62 (vestigial entries)**: a retired, Inactive, empty, childless entry is invisible to all rules.","locale":"en"},"4499":{"id":"/en/docs/concepts-metatheory-23","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#preservation-431","content":"**Definition 63 – well-formed registry:** (1) parents exist (or are `root`); (2) provisions are pairwise disjoint; (3) an installed fiber's `ω` is total on `d_n` and names existing fibers; (4) every fiber an installed `ω` names is installed.","locale":"en"},"4500":{"id":"/en/docs/concepts-metatheory-24","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#preservation-431","content":"**Theorem 64**: every rule preserves well-formedness. The guard on L-Unload is what carries clauses (3) and (4): no committed view ever names a removed fiber. Consequences: a name freed by O-Remove may be reissued (there are no stale views), and a fiber can be removed as soon as it is Inactive without a separate dependency check.","locale":"en"},"4501":{"id":"/en/docs/concepts-metatheory-25","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#temporal-composability-global-form-432","content":"**Definition 65**: fibers `m, n` are *entangled* when one's provision meets the other's declarations. A run is *pairwise independent* when every pair of fibers is independent, or entangled with only commutative shared keys.","locale":"en"},"4502":{"id":"/en/docs/concepts-metatheory-26","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#temporal-composability-global-form-432","content":"**Lemma 66**: every run is pairwise independent (supplied by witnessed coeffects and Theorem 47, see The context paradigm).","locale":"en"},"4503":{"id":"/en/docs/concepts-metatheory-27","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#temporal-composability-global-form-432","content":"**Lemma 67 (entangled steps)**: while `n`'s episode is open, a provider `m` of `n` takes only identity state maps (the guard blocks its L-Unload); a consumer's steps commute with `g_n`; while `n` is Reloading, entangled fibers take only identity maps.","locale":"en"},"4504":{"id":"/en/docs/concepts-metatheory-28","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#temporal-composability-global-form-432","content":"**Theorem 68 (Recovery exactness)**: applying `n`'s accumulator at any point of its episode leaves every table where the *other* fibers' steps alone would have left it from the episode start:","locale":"en"},"4505":{"id":"/en/docs/concepts-metatheory-29","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#temporal-composability-global-form-432","content":"*Running an inverse withdraws the fiber's contribution and nothing else.*","locale":"en"},"4506":{"id":"/en/docs/concepts-metatheory-30","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#temporal-composability-global-form-432","content":"**Corollary 69 (Terminal recovery)**: after an episode closes, the state equals \"other fibers only\"; in particular `σ_n = ∅` (which is O-Remove's premise).","locale":"en"},"4507":{"id":"/en/docs/concepts-metatheory-31","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#temporal-composability-global-form-432","content":"*Bound:* tables are restored only up to each key's `≃_k`: a monotone allocator is not rewound, heap layout is not restored, a sent message stays sent.","locale":"en"},"4508":{"id":"/en/docs/concepts-metatheory-32","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#spatial-composability-global-form-433","content":"**Theorem 70 (Ordering)**","locale":"en"},"4509":{"id":"/en/docs/concepts-metatheory-33","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#spatial-composability-global-form-433","content":"A fiber begins a transition only where its dependencies are provided (`L-Begin(m) ⇒ γ ⊧ d_m`).","locale":"en"},"4510":{"id":"/en/docs/concepts-metatheory-34","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#spatial-composability-global-form-433","content":"If `m` committed key `k` to provider `n`, then throughout `m`'s episode: `ω_m(k) = n`; `n`'s episode strictly contains `m`'s (`b < b′`, and `u′ < u` if `n` closes), so **a provider outlives its consumers**; the binding `k` stays in `σ_n` and moves only by operations at `k` of fibers declaring `k`.","locale":"en"},"4511":{"id":"/en/docs/concepts-metatheory-35","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#spatial-composability-global-form-433","content":"**Theorem 71 (Resolution coherence)**: every iteration of a transition runs against the one committed resolution `ω`. When the fiber leaves Reloading, either L-Finish lands it Active against `ω`, or L-Divert takes it out and its episode closes with exact recovery. A transition never straddles two resolutions of its coeffects (no glitch *within* a transition; Cordis has no global \"turn\" as FRP has).","locale":"en"},"4512":{"id":"/en/docs/concepts-metatheory-36","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#progress-434","content":"**Definition 72**: precedence `n ≺ m := p_n ∩ d_m ≠ ∅` (`n` may provide a key `m` declares). Acyclicity of `≺` is an **assumption** (a component that declares a key it provides itself violates it).","locale":"en"},"4513":{"id":"/en/docs/concepts-metatheory-37","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#progress-434","content":"**Theorem 73 (Progress)**: assume `≺` is acyclic, iterator length is at most `K`, and there are finitely many names. Then:","locale":"en"},"4514":{"id":"/en/docs/concepts-metatheory-38","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#progress-434","content":"**No deadlock**: a non-quiescent state always admits some lifecycle rule (the chain of Unloading fibers blocked by relied-upon consumers is `≺`-increasing, hence finite, and ends at an unblocked one).","locale":"en"},"4515":{"id":"/en/docs/concepts-metatheory-39","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#progress-434","content":"**Termination**: each fiber takes at most `(K + 3)(V(n) + 1)` steps, where `V(n)`, the number of target turns, is finite.","locale":"en"},"4516":{"id":"/en/docs/concepts-metatheory-40","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#progress-434","content":"Every maximal sequence of lifecycle steps ends quiescent. Finiteness of names requires that no component instantiates itself without bound.","locale":"en"},"4517":{"id":"/en/docs/concepts-metatheory-41","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#confluence-435","content":"**Definition 74 – support set A**: `n ∈ A ⇔ ¬τ_n ∧ (π_n = root ∨ π_n ∈ A) ∧ ∀k ∈ d_n. ∃m ∈ A. k ∈ p_m`, a function of `τ, π, d, p` only. **Lemma 75**: the support relation is well-founded and `A` is unique.","locale":"en"},"4518":{"id":"/en/docs/concepts-metatheory-42","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#confluence-435","content":"**Definition 76 – total on its provision**: a finished activation has installed every key of `p`. **Lemma 77**: at quiescence (with totality), `A` is the set of Active fibers.","locale":"en"},"4519":{"id":"/en/docs/concepts-metatheory-43","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#confluence-435","content":"**Lemma 78 (Transposition)** and **Lemma 79 (Deletion)**: adjacent independent steps can be swapped, and a closed episode (with its instantiations) can be deleted without changing the endpoint.","locale":"en"},"4520":{"id":"/en/docs/concepts-metatheory-44","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#confluence-435","content":"**Theorem 80 (Confluence)**: any run reaching a quiescent state can be reduced to a **canonical** run: the same orchestration steps, then one episode per supported fiber in an order linearising support. Two runs with the same orchestration inputs reach `≃`-related states (up to renaming). *The lifecycle relation has unique normal forms.*","locale":"en"},"4521":{"id":"/en/docs/concepts-metatheory-45","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#confluence-435","content":"> \"The theorem is what licenses reasoning about a Cordis application as though it were statically assembled.\"","locale":"en"},"4522":{"id":"/en/docs/concepts-metatheory-46","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#confluence-435","content":"Adding, removing, replacing and un-replacing components arrives at the state of writing the final composition down at the outset. The theorem speaks about *state*, not about emissions made along the way.","locale":"en"},"4523":{"id":"/en/docs/concepts-metatheory-47","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#asynchrony-and-inertia","content":"In an async host, iterations and inverses are futures that run to completion once started, so the **aborting** alternative of L-Divert is unavailable. Such a host is **inertial**: a fiber whose target turns during an iteration deactivates after that iteration lands. All results quantify over all runs, so they cover inertial runs; Theorem 73 never uses the aborting alternative. Inverses in flight need no counterpart (Unloading is never declined). A deactivation may chain directly back into an activation (implementation: `reload`/`unload` mutual chaining, see Implementation in the paper).","locale":"en"},"4524":{"id":"/en/docs/concepts-metatheory-48","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#asynchrony-and-inertia","content":"**In kardia:** transitions are inertial. An effect body or a plugin's `apply` is spawned and never dropped half-way; disposal waits for it to reach its end or an iteration boundary (`ctx.checkpoint()`, `scope.checkpoint()`, `scope.yield_(..)`), where it can stop with `Interrupted`. See Concurrency and Lifecycle.","locale":"en"},"4525":{"id":"/en/docs/concepts-metatheory-49","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#failure","content":"An iteration may raise: `Γ → Either(Ξ, Γ × (Γ→Γ) × Maybe(ℑ))`. A raise exits Reloading like an aborting L-Divert (chosen by the iteration, not the environment): the fiber unwinds through Unloading with the accumulator built so far, arrives Inactive having installed nothing, and the **error is recorded on the fiber**. L-Begin then requires an error-free fiber: a failed effect is *not retried against an unchanged environment*; `quiet` admits failed fibers; failure does not propagate to the parent (siblings keep running). A retry is a revision (re-insertion without the outcome). Confluence excludes failed fibers. In the implementation this is the state `FAILED`.","locale":"en"},"4526":{"id":"/en/docs/concepts-metatheory-50","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#failure","content":"**In kardia:** a failed fiber is in `FiberState::Failed` and keeps its error (`Fiber::error()`); only `update`, `restart` or `replace` recover it. See Lifecycle.","locale":"en"},"4527":{"id":"/en/docs/concepts-metatheory-51","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#isolation","content":"With realms fixed at insertion, the relaxed calculus is the present one over keys `K × R`: a fiber under realm table `ρ` declares and provides `(k, ρ(k))`; disjointness becomes \"disjoint within a realm\". Reassigning a realm at runtime changes a fiber's interface, so it is handled as a *revision*. Interception needs no extension: metadata is consulted at access time and is in no fiber field.","locale":"en"},"4528":{"id":"/en/docs/concepts-metatheory-52","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#configuration","content":"A component takes a configuration bound into its effect function; one component with two payloads is two components. The declarative layer may **revise** a running fiber (replace its config, reassign realms, disable or re-enable it). Disabling is O-Retire; every other revision is retire → deactivate → remove (children first) → reinsert at the same name. Re-enabling uses this composite rather than resetting `τ` to `⊥` (the monotonicity of `τ` underlies Theorem 80, and a re-enabled orphan would activate with its creator gone). In the implementation, re-enabling an *entry* instantiates a *fresh fiber*: the entry is the identity across revisions, the fiber the identity of one enablement. The shortcuts the loader takes (config handed to the component, a realm moved without reloading the provider) are justified by their *endpoint* (Theorem 80).","locale":"en"},"4529":{"id":"/en/docs/concepts-metatheory-53","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#obligations-the-theory-places-on-an-implementation","content":"Obligation","locale":"en"},"4530":{"id":"/en/docs/concepts-metatheory-54","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#obligations-the-theory-places-on-an-implementation","content":"Source","locale":"en"},"4531":{"id":"/en/docs/concepts-metatheory-55","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#obligations-the-theory-places-on-an-implementation","content":"Disposers must revert exactly their effect (author obligation, unchecked)","locale":"en"},"4532":{"id":"/en/docs/concepts-metatheory-56","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#obligations-the-theory-places-on-an-implementation","content":"Def. 8 witness","locale":"en"},"4533":{"id":"/en/docs/concepts-metatheory-57","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#obligations-the-theory-places-on-an-implementation","content":"Shared keys must be commutative (provider obligation, unchecked)","locale":"en"},"4534":{"id":"/en/docs/concepts-metatheory-58","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#obligations-the-theory-places-on-an-implementation","content":"Def. 46","locale":"en"},"4535":{"id":"/en/docs/concepts-metatheory-59","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#obligations-the-theory-places-on-an-implementation","content":"Single provider per (key, realm)","locale":"en"},"4536":{"id":"/en/docs/concepts-metatheory-60","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#obligations-the-theory-places-on-an-implementation","content":"O-Insert premise","locale":"en"},"4537":{"id":"/en/docs/concepts-metatheory-61","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#obligations-the-theory-places-on-an-implementation","content":"Provider available only while Active","locale":"en"},"4538":{"id":"/en/docs/concepts-metatheory-62","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#obligations-the-theory-places-on-an-implementation","content":"eq. 46","locale":"en"},"4539":{"id":"/en/docs/concepts-metatheory-63","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#obligations-the-theory-places-on-an-implementation","content":"Committed view fixed per episode, read by consumers","locale":"en"},"4540":{"id":"/en/docs/concepts-metatheory-64","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#obligations-the-theory-places-on-an-implementation","content":"Lemma 59(2), Thm 70","locale":"en"},"4541":{"id":"/en/docs/concepts-metatheory-65","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#obligations-the-theory-places-on-an-implementation","content":"Out-of-service mark before any inverse runs","locale":"en"},"4542":{"id":"/en/docs/concepts-metatheory-66","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#obligations-the-theory-places-on-an-implementation","content":"L-Leave","locale":"en"},"4543":{"id":"/en/docs/concepts-metatheory-67","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#obligations-the-theory-places-on-an-implementation","content":"Unload waits for dependents (guard)","locale":"en"},"4544":{"id":"/en/docs/concepts-metatheory-68","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#obligations-the-theory-places-on-an-implementation","content":"L-Unload","locale":"en"},"4545":{"id":"/en/docs/concepts-metatheory-69","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#obligations-the-theory-places-on-an-implementation","content":"Iteration-boundary staleness check","locale":"en"},"4546":{"id":"/en/docs/concepts-metatheory-70","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#obligations-the-theory-places-on-an-implementation","content":"L-Iter/L-Finish premise, Thm 71","locale":"en"},"4547":{"id":"/en/docs/concepts-metatheory-71","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#obligations-the-theory-places-on-an-implementation","content":"Failed fiber not retried until revised","locale":"en"},"4548":{"id":"/en/docs/concepts-metatheory-72","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#obligations-the-theory-places-on-an-implementation","content":"§4.4 Failure","locale":"en"},"4549":{"id":"/en/docs/concepts-metatheory-73","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#obligations-the-theory-places-on-an-implementation","content":"Report dependency cycles (`≺` not acyclic ⇒ permanently inactive)","locale":"en"},"4550":{"id":"/en/docs/concepts-metatheory-74","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#obligations-the-theory-places-on-an-implementation","content":"Thm 73 assumption, §6.5 (Discussion)","locale":"en"},"4551":{"id":"/en/docs/concepts-metatheory-75","page_id":"/en/docs/concepts-metatheory","tags":[],"type":"text","url":"/en/docs/concepts-metatheory#obligations-the-theory-places-on-an-implementation","content":"**In kardia:** dependency cycles are reported when a fiber is inserted. The registry searches the declared `provide`/`inject` of live fibers for a cycle through the new fiber and logs a warning naming it (`dependency cycle: a -> b -> a`); the fiber stays `Pending`. Declared `provide` is metadata only, so a plugin that provides undeclared keys escapes the check. See Lifecycle.","locale":"en"},"4552":{"id":"/en/docs/concepts-reactive-coeffects","page_id":"/en/docs/concepts-reactive-coeffects","type":"page","content":"Reactive coeffects","breadcrumbs":["kardia Documentation","Concepts"],"tags":[],"url":"/en/docs/concepts-reactive-coeffects","locale":"en"},"4553":{"id":"/en/docs/concepts-reactive-coeffects-0","page_id":"/en/docs/concepts-reactive-coeffects","tags":[],"type":"text","url":"/en/docs/concepts-reactive-coeffects","content":"Paper §3.2: the coeffect context, specifications and notification, isolation and interception, which give a single component local spatial composability.","locale":"en"},"4554":{"id":"/en/docs/concepts-reactive-coeffects-1","page_id":"/en/docs/concepts-reactive-coeffects","type":"heading","tags":[],"url":"/en/docs/concepts-reactive-coeffects#coeffect-context-321","content":"Coeffect context (§3.2.1)","locale":"en"},"4555":{"id":"/en/docs/concepts-reactive-coeffects-2","page_id":"/en/docs/concepts-reactive-coeffects","type":"heading","tags":[],"url":"/en/docs/concepts-reactive-coeffects#definition-19--coeffect-context","content":"Definition 19 – coeffect context","locale":"en"},"4556":{"id":"/en/docs/concepts-reactive-coeffects-3","page_id":"/en/docs/concepts-reactive-coeffects","type":"heading","tags":[],"url":"/en/docs/concepts-reactive-coeffects#definition-20--get--set","content":"Definition 20 – get / set","locale":"en"},"4557":{"id":"/en/docs/concepts-reactive-coeffects-4","page_id":"/en/docs/concepts-reactive-coeffects","type":"heading","tags":[],"url":"/en/docs/concepts-reactive-coeffects#specification-and-notification-322","content":"Specification and notification (§3.2.2)","locale":"en"},"4558":{"id":"/en/docs/concepts-reactive-coeffects-5","page_id":"/en/docs/concepts-reactive-coeffects","type":"heading","tags":[],"url":"/en/docs/concepts-reactive-coeffects#definition-21--coeffect-specification","content":"Definition 21 – coeffect specification","locale":"en"},"4559":{"id":"/en/docs/concepts-reactive-coeffects-6","page_id":"/en/docs/concepts-reactive-coeffects","type":"heading","tags":[],"url":"/en/docs/concepts-reactive-coeffects#definition-22--notification","content":"Definition 22 – notification","locale":"en"},"4560":{"id":"/en/docs/concepts-reactive-coeffects-7","page_id":"/en/docs/concepts-reactive-coeffects","type":"heading","tags":[],"url":"/en/docs/concepts-reactive-coeffects#isolation-and-interception-323","content":"Isolation and interception (§3.2.3)","locale":"en"},"4561":{"id":"/en/docs/concepts-reactive-coeffects-8","page_id":"/en/docs/concepts-reactive-coeffects","type":"heading","tags":[],"url":"/en/docs/concepts-reactive-coeffects#realization-definition-23","content":"Realization (Definition 23)","locale":"en"},"4562":{"id":"/en/docs/concepts-reactive-coeffects-9","page_id":"/en/docs/concepts-reactive-coeffects","type":"heading","tags":[],"url":"/en/docs/concepts-reactive-coeffects#coeffect-isolation--definitions-24-25","content":"Coeffect isolation – Definitions 24, 25","locale":"en"},"4563":{"id":"/en/docs/concepts-reactive-coeffects-10","page_id":"/en/docs/concepts-reactive-coeffects","type":"heading","tags":[],"url":"/en/docs/concepts-reactive-coeffects#coeffect-interception--definitions-26-27","content":"Coeffect interception – Definitions 26, 27","locale":"en"},"4564":{"id":"/en/docs/concepts-reactive-coeffects-11","page_id":"/en/docs/concepts-reactive-coeffects","type":"heading","tags":[],"url":"/en/docs/concepts-reactive-coeffects#engineering-take-aways","content":"Engineering take-aways","locale":"en"},"4565":{"id":"/en/docs/concepts-reactive-coeffects-12","page_id":"/en/docs/concepts-reactive-coeffects","tags":[],"type":"text","url":"/en/docs/concepts-reactive-coeffects","content":"This page summarises §3.2 of the paper (arXiv:2608.25512). Definition numbers are the paper's. For the Cordis realisation see Context and reflection and Fiber lifecycle in the Cordis reference.","locale":"en"},"4566":{"id":"/en/docs/concepts-reactive-coeffects-13","page_id":"/en/docs/concepts-reactive-coeffects","tags":[],"type":"text","url":"/en/docs/concepts-reactive-coeffects","content":"Spatial composability is the ability of components to declare dependencies and of the system to resolve, provide and withdraw them at runtime. Dependency satisfaction must be re-evaluated whenever the shared context changes, so that a component activates when its dependencies become available and deactivates when they are withdrawn.","locale":"en"},"4567":{"id":"/en/docs/concepts-reactive-coeffects-14","page_id":"/en/docs/concepts-reactive-coeffects","tags":[],"type":"text","url":"/en/docs/concepts-reactive-coeffects#coeffect-context-321","content":"The paper formalises an inversion-of-control (IoC) container as a coeffect context.","locale":"en"},"4568":{"id":"/en/docs/concepts-reactive-coeffects-15","page_id":"/en/docs/concepts-reactive-coeffects","tags":[],"type":"text","url":"/en/docs/concepts-reactive-coeffects#definition-19--coeffect-context","content":"For a type family `𝒱 : K → Type`, `Σ := (k : K) ⇀ 𝒱_k` is a **finite dependent partial function**. Notation: `σ(k)` application, `σ[k ↦ v]` extension, `σ ∖ k` restriction, `k ∈ dom(σ)` membership. The type family gives each key a static value type.","locale":"en"},"4569":{"id":"/en/docs/concepts-reactive-coeffects-16","page_id":"/en/docs/concepts-reactive-coeffects","tags":[],"type":"text","url":"/en/docs/concepts-reactive-coeffects#definition-19--coeffect-context","content":"**Preconditions:** a dependency may not be provided twice (`k ∉ dom(σ)` for extension) nor revoked if absent (`k ∈ dom(σ)` for restriction). A violated precondition is *signalled as an error and produces no transition* (equivalently, compose in the `Maybe` monad).","locale":"en"},"4570":{"id":"/en/docs/concepts-reactive-coeffects-17","page_id":"/en/docs/concepts-reactive-coeffects","tags":[],"type":"text","url":"/en/docs/concepts-reactive-coeffects#definition-20--get--set","content":"`set(k, v)` **is an effect function** (`𝔈Σ*`). The effect machinery of §3.1 (Revertible effects) therefore applies directly: dependency registrations are tracked and recovered automatically. *\"Coeffect operations are effects, and effects are revertible.\"*","locale":"en"},"4571":{"id":"/en/docs/concepts-reactive-coeffects-18","page_id":"/en/docs/concepts-reactive-coeffects","tags":[],"type":"text","url":"/en/docs/concepts-reactive-coeffects#specification-and-notification-322","content":"Accessing an absent dependency is a runtime failure, so a component should **activate only once all its declared dependencies are present**, instead of accessing them optimistically.","locale":"en"},"4572":{"id":"/en/docs/concepts-reactive-coeffects-19","page_id":"/en/docs/concepts-reactive-coeffects","tags":[],"type":"text","url":"/en/docs/concepts-reactive-coeffects#specification-and-notification-322","content":"**Satisfaction predicate**: `σ ⊧ d := ∀k ∈ d. k ∈ dom(σ)`, decidable because `dom(σ)` is finite.","locale":"en"},"4573":{"id":"/en/docs/concepts-reactive-coeffects-20","page_id":"/en/docs/concepts-reactive-coeffects","tags":[],"type":"text","url":"/en/docs/concepts-reactive-coeffects#specification-and-notification-322","content":"Because every mutation of `σ` passes through effect functions, changes of satisfaction are detectable at each effect boundary: *the effect system guarantees that every coeffect change is observed.*","locale":"en"},"4574":{"id":"/en/docs/concepts-reactive-coeffects-21","page_id":"/en/docs/concepts-reactive-coeffects","tags":[],"type":"text","url":"/en/docs/concepts-reactive-coeffects#definition-21--coeffect-specification","content":"`𝔇Σ := Set(K)`.","locale":"en"},"4575":{"id":"/en/docs/concepts-reactive-coeffects-22","page_id":"/en/docs/concepts-reactive-coeffects","tags":[],"type":"text","url":"/en/docs/concepts-reactive-coeffects#definition-22--notification","content":"An activating transition triggers execution of the component's effects (tracked as in §3.1); a deactivating one triggers recovery through the accumulator.","locale":"en"},"4576":{"id":"/en/docs/concepts-reactive-coeffects-23","page_id":"/en/docs/concepts-reactive-coeffects","tags":[],"type":"text","url":"/en/docs/concepts-reactive-coeffects#definition-22--notification","content":"**Local spatial composability**: a component activates only at a state satisfying its specification (it never reads an absent binding), and every context change is classified against the specification (loss of satisfaction is detected where it happens). Two things are left to the global form (§4.3.3, see Metatheory): withdrawing a binding only *after* the deactivations it causes have finished, and keeping the bindings an activation reads unmoved while it runs.","locale":"en"},"4577":{"id":"/en/docs/concepts-reactive-coeffects-24","page_id":"/en/docs/concepts-reactive-coeffects","tags":[],"type":"text","url":"/en/docs/concepts-reactive-coeffects#isolation-and-interception-323","content":"The flat table cannot bind *different* values to the same logical dependency for different components. The paper adds two extensions.","locale":"en"},"4578":{"id":"/en/docs/concepts-reactive-coeffects-25","page_id":"/en/docs/concepts-reactive-coeffects","tags":[],"type":"text","url":"/en/docs/concepts-reactive-coeffects#realization-definition-23","content":"An effect function on a context admits two realizations:","locale":"en"},"4579":{"id":"/en/docs/concepts-reactive-coeffects-26","page_id":"/en/docs/concepts-reactive-coeffects","tags":[],"type":"text","url":"/en/docs/concepts-reactive-coeffects#realization-definition-23","content":"**In-place**: mutate the context and return a non-trivial inverse; recovery runs the inverse.","locale":"en"},"4580":{"id":"/en/docs/concepts-reactive-coeffects-27","page_id":"/en/docs/concepts-reactive-coeffects","tags":[],"type":"text","url":"/en/docs/concepts-reactive-coeffects#realization-definition-23","content":"**Derived**: leave the input intact and return a *fresh context deriving from it* with the identity inverse; recovery discards the derived context.","locale":"en"},"4581":{"id":"/en/docs/concepts-reactive-coeffects-28","page_id":"/en/docs/concepts-reactive-coeffects","tags":[],"type":"text","url":"/en/docs/concepts-reactive-coeffects#realization-definition-23","content":"In a purely functional setting the two coincide; an imperative host may choose per operation. **Isolation and interception are given derived realization**: they produce a child context whose own table differs from the inherited one, leaving the shared table untouched, so there is nothing to track. Assignment on a derived table overrides the inherited one at that key, so neither operation has a precondition.","locale":"en"},"4582":{"id":"/en/docs/concepts-reactive-coeffects-29","page_id":"/en/docs/concepts-reactive-coeffects","tags":[],"type":"text","url":"/en/docs/concepts-reactive-coeffects#coeffect-isolation--definitions-24-25","content":"The two-layer resolution `k → ρ(k) → σ(ρ(k))` decouples the logical layer from storage. The paper describes this as **runtime ad-hoc polymorphism**: the same key resolves to different values in different contexts, adjustable at runtime (multi-tenant systems, testing, sandboxes). `set` remains an effect function (revertible); `isolate` needs no inverse.","locale":"en"},"4583":{"id":"/en/docs/concepts-reactive-coeffects-30","page_id":"/en/docs/concepts-reactive-coeffects","tags":[],"type":"text","url":"/en/docs/concepts-reactive-coeffects#coeffect-interception--definitions-26-27","content":"Interception attaches cross-cutting **metadata** to dependency access without changing the value.","locale":"en"},"4584":{"id":"/en/docs/concepts-reactive-coeffects-31","page_id":"/en/docs/concepts-reactive-coeffects","tags":[],"type":"text","url":"/en/docs/concepts-reactive-coeffects#coeffect-interception--definitions-26-27","content":"`ι` is the **context-carried** metadata (installed by an enclosing context); `σ(k)` is a *provider function* from metadata to value; the specification `d(k)` is the **component-declared** metadata.","locale":"en"},"4585":{"id":"/en/docs/concepts-reactive-coeffects-32","page_id":"/en/docs/concepts-reactive-coeffects","tags":[],"type":"text","url":"/en/docs/concepts-reactive-coeffects#coeffect-interception--definitions-26-27","content":"On access the system evaluates `σ(k)(d(k) ⊕_k ι(k))`. The merge follows each key's semantics (scalars overwritten, sets unioned) and is **right-biased**: context-carried metadata wins, so an enclosing context can constrain how a component uses a coeffect without modifying the component (used for access control in §6.3, see Discussion and related work).","locale":"en"},"4586":{"id":"/en/docs/concepts-reactive-coeffects-33","page_id":"/en/docs/concepts-reactive-coeffects","tags":[],"type":"text","url":"/en/docs/concepts-reactive-coeffects#engineering-take-aways","content":"Formal notion","locale":"en"},"4587":{"id":"/en/docs/concepts-reactive-coeffects-34","page_id":"/en/docs/concepts-reactive-coeffects","tags":[],"type":"text","url":"/en/docs/concepts-reactive-coeffects#engineering-take-aways","content":"Practical reading","locale":"en"},"4588":{"id":"/en/docs/concepts-reactive-coeffects-35","page_id":"/en/docs/concepts-reactive-coeffects","tags":[],"type":"text","url":"/en/docs/concepts-reactive-coeffects#engineering-take-aways","content":"`Σ` as dependent partial map","locale":"en"},"4589":{"id":"/en/docs/concepts-reactive-coeffects-36","page_id":"/en/docs/concepts-reactive-coeffects","tags":[],"type":"text","url":"/en/docs/concepts-reactive-coeffects#engineering-take-aways","content":"A service registry keyed by name, each key with a fixed value type.","locale":"en"},"4590":{"id":"/en/docs/concepts-reactive-coeffects-37","page_id":"/en/docs/concepts-reactive-coeffects","tags":[],"type":"text","url":"/en/docs/concepts-reactive-coeffects#engineering-take-aways","content":"`set` precondition","locale":"en"},"4591":{"id":"/en/docs/concepts-reactive-coeffects-38","page_id":"/en/docs/concepts-reactive-coeffects","tags":[],"type":"text","url":"/en/docs/concepts-reactive-coeffects#engineering-take-aways","content":"Providing an already provided key is an error (\"single source\").","locale":"en"},"4592":{"id":"/en/docs/concepts-reactive-coeffects-39","page_id":"/en/docs/concepts-reactive-coeffects","tags":[],"type":"text","url":"/en/docs/concepts-reactive-coeffects#engineering-take-aways","content":"`set` is an effect","locale":"en"},"4593":{"id":"/en/docs/concepts-reactive-coeffects-40","page_id":"/en/docs/concepts-reactive-coeffects","tags":[],"type":"text","url":"/en/docs/concepts-reactive-coeffects#engineering-take-aways","content":"`provide(name, value)` returns a disposer and is tracked by the enclosing scope.","locale":"en"},"4594":{"id":"/en/docs/concepts-reactive-coeffects-41","page_id":"/en/docs/concepts-reactive-coeffects","tags":[],"type":"text","url":"/en/docs/concepts-reactive-coeffects#engineering-take-aways","content":"Satisfaction / notify","locale":"en"},"4595":{"id":"/en/docs/concepts-reactive-coeffects-42","page_id":"/en/docs/concepts-reactive-coeffects","tags":[],"type":"text","url":"/en/docs/concepts-reactive-coeffects#engineering-take-aways","content":"A consumer is started only when every injected key is available; every provide/withdraw re-evaluates affected consumers.","locale":"en"},"4596":{"id":"/en/docs/concepts-reactive-coeffects-43","page_id":"/en/docs/concepts-reactive-coeffects","tags":[],"type":"text","url":"/en/docs/concepts-reactive-coeffects#engineering-take-aways","content":"Derived realization","locale":"en"},"4597":{"id":"/en/docs/concepts-reactive-coeffects-44","page_id":"/en/docs/concepts-reactive-coeffects","tags":[],"type":"text","url":"/en/docs/concepts-reactive-coeffects#engineering-take-aways","content":"`ctx.isolate(...)` / `ctx.intercept(...)` return a *new child context object*; there is nothing to undo.","locale":"en"},"4598":{"id":"/en/docs/concepts-reactive-coeffects-45","page_id":"/en/docs/concepts-reactive-coeffects","tags":[],"type":"text","url":"/en/docs/concepts-reactive-coeffects#engineering-take-aways","content":"Realm","locale":"en"},"4599":{"id":"/en/docs/concepts-reactive-coeffects-46","page_id":"/en/docs/concepts-reactive-coeffects","tags":[],"type":"text","url":"/en/docs/concepts-reactive-coeffects#engineering-take-aways","content":"An opaque token per (scope, key); the same token means a shared binding.","locale":"en"},"4600":{"id":"/en/docs/concepts-reactive-coeffects-47","page_id":"/en/docs/concepts-reactive-coeffects","tags":[],"type":"text","url":"/en/docs/concepts-reactive-coeffects#engineering-take-aways","content":"Interception merge","locale":"en"},"4601":{"id":"/en/docs/concepts-reactive-coeffects-48","page_id":"/en/docs/concepts-reactive-coeffects","tags":[],"type":"text","url":"/en/docs/concepts-reactive-coeffects#engineering-take-aways","content":"Declared metadata (in the consumer's `inject` declaration) merged with context metadata; outer → inner, inner wins.","locale":"en"},"4602":{"id":"/en/docs/concepts-reactive-coeffects-49","page_id":"/en/docs/concepts-reactive-coeffects","tags":[],"type":"text","url":"/en/docs/concepts-reactive-coeffects#engineering-take-aways","content":"**In kardia:** a key is the string `Service::NAME` bound to a Rust type through the `Service` trait. `ctx.provide(value)` is a tracked effect returning an `EffectHandle`, and providing a key twice in one realm fails with `KardiaError::AlreadyProvided`. `ctx.isolate(key)` (a fresh private realm), `ctx.isolate_in(key, realm)` (a shared realm) and `ctx.intercept(key, meta)` return a derived `Context`. Declared metadata comes from `Inject::with_meta`, and `Service::merge_intercept` merges it with the context's, outermost first, by default a right-biased shallow merge of JSON objects. See Services.","locale":"en"},"4603":{"id":"/en/docs/concepts-related-work","page_id":"/en/docs/concepts-related-work","type":"page","content":"Discussion and related work","breadcrumbs":["kardia Documentation","Concepts"],"tags":[],"url":"/en/docs/concepts-related-work","locale":"en"},"4604":{"id":"/en/docs/concepts-related-work-0","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work","content":"Paper §6–8: the system boundary, service multiplexing, access control, language requirements, dependency cycles and versioning, co-design with languages and operating systems, related work and the conclusion.","locale":"en"},"4605":{"id":"/en/docs/concepts-related-work-1","page_id":"/en/docs/concepts-related-work","type":"heading","tags":[],"url":"/en/docs/concepts-related-work#system-boundary-61","content":"System boundary (§6.1)","locale":"en"},"4606":{"id":"/en/docs/concepts-related-work-2","page_id":"/en/docs/concepts-related-work","type":"heading","tags":[],"url":"/en/docs/concepts-related-work#service-multiplexing-62","content":"Service multiplexing (§6.2)","locale":"en"},"4607":{"id":"/en/docs/concepts-related-work-3","page_id":"/en/docs/concepts-related-work","type":"heading","tags":[],"url":"/en/docs/concepts-related-work#access-control-and-sandboxing-63","content":"Access control and sandboxing (§6.3)","locale":"en"},"4608":{"id":"/en/docs/concepts-related-work-4","page_id":"/en/docs/concepts-related-work","type":"heading","tags":[],"url":"/en/docs/concepts-related-work#language-independence-and-selection-64-rust","content":"Language independence and selection (§6.4) [Rust]","locale":"en"},"4609":{"id":"/en/docs/concepts-related-work-5","page_id":"/en/docs/concepts-related-work","type":"heading","tags":[],"url":"/en/docs/concepts-related-work#mutual-dependencies-and-component-granularity-65","content":"Mutual dependencies and component granularity (§6.5)","locale":"en"},"4610":{"id":"/en/docs/concepts-related-work-6","page_id":"/en/docs/concepts-related-work","type":"heading","tags":[],"url":"/en/docs/concepts-related-work#dependency-typing-and-versioning-66","content":"Dependency typing and versioning (§6.6)","locale":"en"},"4611":{"id":"/en/docs/concepts-related-work-7","page_id":"/en/docs/concepts-related-work","type":"heading","tags":[],"url":"/en/docs/concepts-related-work#co-design-with-languages-and-operating-systems-67","content":"Co-design with languages and operating systems (§6.7)","locale":"en"},"4612":{"id":"/en/docs/concepts-related-work-8","page_id":"/en/docs/concepts-related-work","type":"heading","tags":[],"url":"/en/docs/concepts-related-work#related-work-7","content":"Related work (§7)","locale":"en"},"4613":{"id":"/en/docs/concepts-related-work-9","page_id":"/en/docs/concepts-related-work","type":"heading","tags":[],"url":"/en/docs/concepts-related-work#conclusion-8","content":"Conclusion (§8)","locale":"en"},"4614":{"id":"/en/docs/concepts-related-work-10","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work","content":"This page summarises §6–8 of the paper (arXiv:2608.25512): theory and design guidance. The paper's notes that bear on a Rust port are marked **\\[Rust]** in the source summary; here each is followed by an \"In kardia\" callout saying how kardia realises it.","locale":"en"},"4615":{"id":"/en/docs/concepts-related-work-11","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#system-boundary-61","content":"The boundary divides the environment into locations **inside** (the system can modify them exclusively *and* restore them, so they are tracked and revertible) and **outside** (either ability fails, so the operation acts as `id_Γ` and is untracked).","locale":"en"},"4616":{"id":"/en/docs/concepts-related-work-12","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#system-boundary-61","content":"**Coeffects move the boundary** by reifying an external location behind operations that each have an inverse. The boundary is drawn *per location*, not per medium (a private scratch file is inside; a shared path is outside).","locale":"en"},"4617":{"id":"/en/docs/concepts-related-work-13","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#system-boundary-61","content":"**Acquisition vs. emission.** Reaching outside happens in two stages: *acquisition* installs a record inside the boundary (`open` → descriptor, `malloc` → block, `fork` → child), which is revertible; *emission* pushes data through that channel (`write`, `send`) and crosses outside, which is not revertible.","locale":"en"},"4618":{"id":"/en/docs/concepts-related-work-14","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#system-boundary-61","content":"**Withholding and compensation.** Recovering an emission requires either withholding it until the producing state is certain (the output-commit problem) or compensation (delete the created file, refund the charge) up to an application-supplied, coarser equivalence. Compensations compose LIFO like inverses, but the commutation metatheory (Metatheory) must be re-established against the coarser relation.","locale":"en"},"4619":{"id":"/en/docs/concepts-related-work-15","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#service-multiplexing-62","content":"Coeffects echo OSGi services: providers publish under an interface, and consumers bind. Multiple implementations can be realised as:","locale":"en"},"4620":{"id":"/en/docs/concepts-related-work-16","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#service-multiplexing-62","content":"**Exclusive binding**: at most one is bound at a time; switching unloads one provider and loads another, perturbing every consumer.","locale":"en"},"4621":{"id":"/en/docs/concepts-related-work-17","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#service-multiplexing-62","content":"**Service broker**: a central service is injected by both the backing providers and the consumers; providers *register with the broker* through revertible effects; consumers see no change when a backing provider changes.","locale":"en"},"4622":{"id":"/en/docs/concepts-related-work-18","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#service-multiplexing-62","content":"The broker enables **load balancing** (policy-driven dispatch; scale by loading and unloading providers), **rolling updates** (load the new provider, shift traffic, unload the old one once drained: quiescence/tranquility), and **cross-process invocation** (each process hosts its own context; RPC preserves the interface; it must be designed against an *asynchronous* contract).","locale":"en"},"4623":{"id":"/en/docs/concepts-related-work-19","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#service-multiplexing-62","content":"**\\[Rust]** The broker pattern is the recommended way to get many providers per key within the single-provider calculus.","locale":"en"},"4624":{"id":"/en/docs/concepts-related-work-20","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#service-multiplexing-62","content":"**In kardia:** one key has one provider per realm (a second `ctx.provide` fails with `KardiaError::AlreadyProvided`). A broker is an ordinary service whose registry is an `IdTable`; a backing provider registers with it through an effect created on its own fiber (`svc.caller().effect(..)`), so the registration is withdrawn when that provider unloads. kardia has no separate broker service for guests: each guest fiber's `GuestService` is its own RPC endpoint, and its calls are synchronous rather than the asynchronous contract above, so a hung guest blocks its caller. See Services and Guest plugins.","locale":"en"},"4625":{"id":"/en/docs/concepts-related-work-21","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#access-control-and-sandboxing-63","content":"**Capability-based access control.** Proxy-mediated access only allows declared dependencies (an undeclared access is an error). `inject` acts as a capability request, the context proxy as a capability mediator. Because declarations are static, the orchestrator can review them at load time.","locale":"en"},"4626":{"id":"/en/docs/concepts-related-work-22","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#access-control-and-sandboxing-63","content":"**Fine-grained policy through interception**: for example, a filesystem dependency carrying metadata about readable and writable paths, checked by the provider. It is adjustable from the context without modifying the provider; it affects how a dependency is used, not whether it is satisfied, so it can change at runtime without a reload.","locale":"en"},"4627":{"id":"/en/docs/concepts-related-work-23","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#access-control-and-sandboxing-63","content":"**Sandboxing** untrusted code needs an execution boundary beyond the language (SFI, a separate runtime, a sandboxed process, a container); the untrusted component reaches host dependencies through a *bridge*, itself an ordinary fiber whose capabilities can be attenuated.","locale":"en"},"4628":{"id":"/en/docs/concepts-related-work-24","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#language-independence-and-selection-64-rust","content":"**Temporal requirements:** closures (an inverse is a captured value), plus a way to introduce and retract a component's code at runtime:","locale":"en"},"4629":{"id":"/en/docs/concepts-related-work-25","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#language-independence-and-selection-64-rust","content":"managed runtimes: a programmatic module registry (Node `require.cache`; ESM has no public eviction API);","locale":"en"},"4630":{"id":"/en/docs/concepts-related-work-26","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#language-independence-and-selection-64-rust","content":"**native code: explicit dynamic linking and unlinking** (`dlopen`/`dlclose`, `LoadLibrary`/`FreeLibrary`);","locale":"en"},"4631":{"id":"/en/docs/concepts-related-work-27","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#language-independence-and-selection-64-rust","content":"**WebAssembly**: an instance is released when a native embedder (for example **Wasmtime**) drops it.","locale":"en"},"4632":{"id":"/en/docs/concepts-related-work-28","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#language-independence-and-selection-64-rust","content":"In all cases loading is an effect whose inverses undo the registrations the module introduced.","locale":"en"},"4633":{"id":"/en/docs/concepts-related-work-29","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#language-independence-and-selection-64-rust","content":"**In kardia:** `kardia-hmr` loads guest modules through three backends, each running a guest plugin through a bridge plugin that instantiates the guest once per fiber and drops the instance when the fiber is disposed. `WasmSource` runs core WebAssembly modules on Wasmtime (sandboxed, one store per fiber). `DylibSource` loads dynamic libraries but never unloads them (no `dlclose`): unloading Rust code is unsound once it has registered thread-local destructors or handed out `'static` references, so each version is loaded from a fresh copy of the file. `ProcessSource` runs one child process per fiber and kills it after `dispose`. See Guest plugins and Hot reload.","locale":"en"},"4634":{"id":"/en/docs/concepts-related-work-30","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#language-independence-and-selection-64-rust","content":"**Spatial requirements:** a dependency-injection mechanism at two levels:","locale":"en"},"4635":{"id":"/en/docs/concepts-related-work-31","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#language-independence-and-selection-64-rust","content":"**type level**: a well-typed dependency access; the context type must record each key's coeffect. *Typeclasses (Haskell) and **traits (Rust)** let a provider extend the context type from its own module through an instance/`impl`*; TypeScript uses module augmentation.","locale":"en"},"4636":{"id":"/en/docs/concepts-related-work-32","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#language-independence-and-selection-64-rust","content":"**runtime level**: access must be dynamically mediated (a JavaScript `Proxy`, Python descriptors, or reflection at the cost of type safety).","locale":"en"},"4637":{"id":"/en/docs/concepts-related-work-33","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#language-independence-and-selection-64-rust","content":"**Metaprogramming** supplies both together: *compile-time metaprogramming (for example **Rust procedural macros**, Scala macros, Zig comptime) emits, for each dependency, a typed declaration together with an accessor, dispensing with a general-purpose interception primitive.*","locale":"en"},"4638":{"id":"/en/docs/concepts-related-work-34","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#language-independence-and-selection-64-rust","content":"**In kardia:** the `Service` trait binds a type to its key (`#[derive(Service)]`), and a service crate extends what a consumer can do with an extension trait on `Svc<S>` (for example `TimerExt` for `Svc<Timer>`), which coherence allows because the trait is local. Access is mediated at runtime by `ctx.get::<S>()` against the committed view, without a proxy. The `#[plugin]` macro supplies the compile-time half: a plugin function taking `Injected<(A, B)>` declares `A` and `B`, and accessing anything else through it does not compile. See Plugins, Services and API design.","locale":"en"},"4639":{"id":"/en/docs/concepts-related-work-35","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#mutual-dependencies-and-component-granularity-65","content":"A dependency cycle leaves the involved components **permanently inactive**. Unlike a concurrency deadlock it is *predictable from the declarations*, so a runtime can report it at load time. Most cycles decompose: for example, server ↔ access-controller becomes `server-core`, `access-control-core`, `request-mediation` (depending on both cores) and `policy-management` (depending on both). The cost is a potentially quadratic number of integration components, mitigated by package bundling, convention-based wiring and scaffolding.","locale":"en"},"4640":{"id":"/en/docs/concepts-related-work-36","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#mutual-dependencies-and-component-granularity-65","content":"**In kardia:** the registry reports a cycle when a fiber is inserted: it searches the declared `provide`/`inject` of live fibers and logs a warning naming the cycle; the fiber stays `Pending`. See Lifecycle.","locale":"en"},"4641":{"id":"/en/docs/concepts-related-work-37","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#dependency-typing-and-versioning-66","content":"Linking is purely **nominal** (by key). There are two problems across independently built components:","locale":"en"},"4642":{"id":"/en/docs/concepts-related-work-38","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#dependency-typing-and-versioning-66","content":"**interface drift**: the provider changes the interface behind `k` between versions;","locale":"en"},"4643":{"id":"/en/docs/concepts-related-work-39","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#dependency-typing-and-versioning-66","content":"**key collision**: unrelated providers choose the same key name.","locale":"en"},"4644":{"id":"/en/docs/concepts-related-work-40","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#dependency-typing-and-versioning-66","content":"Approaches:","locale":"en"},"4645":{"id":"/en/docs/concepts-related-work-41","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#dependency-typing-and-versioning-66","content":"**key namespacing** `K × P` (by package; eliminates collisions, couples to a registry);","locale":"en"},"4646":{"id":"/en/docs/concepts-related-work-42","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#dependency-typing-and-versioning-66","content":"**peer dependencies** with semver ranges through the package manager (Cordis's current approach; relies on semver discipline and one version per package);","locale":"en"},"4647":{"id":"/en/docs/concepts-related-work-43","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#dependency-typing-and-versioning-66","content":"**structural compatibility** predicates (width subtyping is easy; behavioural contracts are hard; bounded quantification is undecidable).","locale":"en"},"4648":{"id":"/en/docs/concepts-related-work-44","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#dependency-typing-and-versioning-66","content":"This is an open problem.","locale":"en"},"4649":{"id":"/en/docs/concepts-related-work-45","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#dependency-typing-and-versioning-66","content":"**\\[Rust]** Rust's `TypeId`/type-keyed services give collision-freedom *within one binary* (a form of key namespacing), but across dynamically loaded modules `TypeId` is not stable, so keys must then be strings plus an ABI/version tag.","locale":"en"},"4650":{"id":"/en/docs/concepts-related-work-46","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#dependency-typing-and-versioning-66","content":"**In kardia:** keys are strings (`Service::NAME`) everywhere, because configuration names services. A binding holds its value as `dyn Any`, and a typed access downcasts it, failing with `AccessError::TypeMismatch`, which detects collisions between unrelated types within one binary. Guest modules do not share Rust types with the host: they provide and read services by string key, as JSON views with JSON calls, through the JSON guest ABI. That ABI carries no version tag. See Services and Guest plugins.","locale":"en"},"4651":{"id":"/en/docs/concepts-related-work-47","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#co-design-with-languages-and-operating-systems-67","content":"**Languages:** make the context implicit again (for ergonomics, and to prevent a component from reaching another component's context through a closure or a global, which would leak effects out of its lifecycle); give the compiler syntax for effects (compile an effect iterator into one state machine holding the inverses in its frame instead of a closure per step); admit the coeffect specification into the type system (report cycles at compile time; structural dependency comparison à la row types).","locale":"en"},"4652":{"id":"/en/docs/concepts-related-work-48","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#co-design-with-languages-and-operating-systems-67","content":"**Operating systems:** make the declared coeffect specification the whole of what a component can reach (like WASM imports), provide isolation and interception natively, and provide OS resources (memory, file descriptors) as coeffects so that acquisitions are recorded once by the party that hands them out; transactional or copy-on-write storage can make some emissions revertible.","locale":"en"},"4653":{"id":"/en/docs/concepts-related-work-49","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#related-work-7","content":"Area","locale":"en"},"4654":{"id":"/en/docs/concepts-related-work-50","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#related-work-7","content":"Representative work","locale":"en"},"4655":{"id":"/en/docs/concepts-related-work-51","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#related-work-7","content":"Distinction from Cordis","locale":"en"},"4656":{"id":"/en/docs/concepts-related-work-52","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#related-work-7","content":"Monadic effect systems","locale":"en"},"4657":{"id":"/en/docs/concepts-related-work-53","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#related-work-7","content":"ZIO, Effect-TS, fp-ts","locale":"en"},"4658":{"id":"/en/docs/concepts-related-work-54","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#related-work-7","content":"Require writing inside the effect type; a withdrawn service leaves its effects in place. Cordis is an overlay on ordinary code and pairs every effect with an inverse.","locale":"en"},"4659":{"id":"/en/docs/concepts-related-work-55","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#related-work-7","content":"Algebraic effects as capabilities","locale":"en"},"4660":{"id":"/en/docs/concepts-related-work-56","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#related-work-7","content":"Effekt","locale":"en"},"4661":{"id":"/en/docs/concepts-related-work-57","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#related-work-7","content":"Purpose (interpretation vs. tracking and reversion) and setting (static vs. runtime).","locale":"en"},"4662":{"id":"/en/docs/concepts-related-work-58","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#related-work-7","content":"Reversible effect semantics","locale":"en"},"4663":{"id":"/en/docs/concepts-related-work-59","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#related-work-7","content":"Heunen et al. (dagger/inverse arrows)","locale":"en"},"4664":{"id":"/en/docs/concepts-related-work-60","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#related-work-7","content":"Global two-sided reversibility vs. a per-atomic-effect one-sided inverse supplied at application.","locale":"en"},"4665":{"id":"/en/docs/concepts-related-work-61","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#related-work-7","content":"Graded types","locale":"en"},"4666":{"id":"/en/docs/concepts-related-work-62","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#related-work-7","content":"Granule, coeffects for Java-like languages","locale":"en"},"4667":{"id":"/en/docs/concepts-related-work-63","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#related-work-7","content":"Static annotations over fixed scopes.","locale":"en"},"4668":{"id":"/en/docs/concepts-related-work-64","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#related-work-7","content":"Context-oriented programming","locale":"en"},"4669":{"id":"/en/docs/concepts-related-work-65","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#related-work-7","content":"COP layers","locale":"en"},"4670":{"id":"/en/docs/concepts-related-work-66","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#related-work-7","content":"Changes method dispatch in dynamic extents; no tracking or reversion; activation is not dependency-driven. Cordis can express only COP's global, value-driven fragment.","locale":"en"},"4671":{"id":"/en/docs/concepts-related-work-67","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#related-work-7","content":"Aspect-oriented programming","locale":"en"},"4672":{"id":"/en/docs/concepts-related-work-68","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#related-work-7","content":"AspectJ, dynamic AOP","locale":"en"},"4673":{"id":"/en/docs/concepts-related-work-69","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#related-work-7","content":"Oblivious quantification vs. declared coeffects; Cordis's crosscutting is bound to a component's lifecycle.","locale":"en"},"4674":{"id":"/en/docs/concepts-related-work-70","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#related-work-7","content":"Stateful forward migration","locale":"en"},"4675":{"id":"/en/docs/concepts-related-work-71","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#related-work-7","content":"Quiescence/tranquility, DSU (Ginseng, Kitsune), Erlang `code_change`, Webpack/Vite HMR","locale":"en"},"4676":{"id":"/en/docs/concepts-related-work-72","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#related-work-7","content":"Migrate state forward through hand-written functions; Cordis reverts and reapplies from a clean slate (in-memory state survives only in longer-lived dependencies; DSU-style migration on top of revertible effects is future work), but needs no migration code and supports full unloading.","locale":"en"},"4677":{"id":"/en/docs/concepts-related-work-73","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#related-work-7","content":"Developer-authored recovery","locale":"en"},"4678":{"id":"/en/docs/concepts-related-work-74","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#related-work-7","content":"OSGi/IDE unload callbacks, Command pattern, sagas, effect-handler finalizers, event sourcing, React `useEffect`","locale":"en"},"4679":{"id":"/en/docs/concepts-related-work-75","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#related-work-7","content":"The inverse is an unenforced duty decoupled from the operation; `useEffect` pairs them but is not composable (top level only, no async or iterator).","locale":"en"},"4680":{"id":"/en/docs/concepts-related-work-76","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#related-work-7","content":"Statically scoped reversal","locale":"en"},"4681":{"id":"/en/docs/concepts-related-work-77","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#related-work-7","content":"STM, reversible computing (Janus), RCCS, linear types, **RAII, Rust ownership**","locale":"en"},"4682":{"id":"/en/docs/concepts-related-work-78","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#related-work-7","content":"Scope and reach are fixed statically. Cordis treats lexical resource management as *complementary*, appropriate for local resources within a component.","locale":"en"},"4683":{"id":"/en/docs/concepts-related-work-79","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#related-work-7","content":"Interposed reclamation","locale":"en"},"4684":{"id":"/en/docs/concepts-related-work-80","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#related-work-7","content":"Nooks, shadow drivers, Akeso","locale":"en"},"4685":{"id":"/en/docs/concepts-related-work-81","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#related-work-7","content":"The platform fixes what can be recorded; Cordis lets components introduce their own effects with inverses and propagates removal to dependents.","locale":"en"},"4686":{"id":"/en/docs/concepts-related-work-82","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#related-work-7","content":"Initialization-time DI","locale":"en"},"4687":{"id":"/en/docs/concepts-related-work-83","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#related-work-7","content":"Spring, Guice, Angular, Inversify, Vue provide/inject, React Context","locale":"en"},"4688":{"id":"/en/docs/concepts-related-work-84","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#related-work-7","content":"No reactive re-resolution, no lifecycle management.","locale":"en"},"4689":{"id":"/en/docs/concepts-related-work-85","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#related-work-7","content":"Availability-reactive components","locale":"en"},"4690":{"id":"/en/docs/concepts-related-work-86","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#related-work-7","content":"OSGi Declarative Services, iPOJO, R-OSGi","locale":"en"},"4691":{"id":"/en/docs/concepts-related-work-87","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#related-work-7","content":"The closest precedent, but with hand-written, synchronous deactivation callbacks. Cordis reverts automatically and runs asynchronous teardown to completion (inertial Unloading).","locale":"en"},"4692":{"id":"/en/docs/concepts-related-work-88","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#related-work-7","content":"Value-level reactivity","locale":"en"},"4693":{"id":"/en/docs/concepts-related-work-89","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#related-work-7","content":"FRP, signals","locale":"en"},"4694":{"id":"/en/docs/concepts-related-work-90","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#related-work-7","content":"Value granularity and glitch freedom per turn; Cordis is component-granular with an asynchronous lifecycle. Complementary (a coeffect may carry signals).","locale":"en"},"4695":{"id":"/en/docs/concepts-related-work-91","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#related-work-7","content":"**\\[Rust] note on RAII:** the paper explicitly positions Rust's ownership/RAII as *statically scoped* reversal: complementary, not a substitute. A Rust port should therefore *not* try to make a component's lifetime a lexical scope; component lifetime is dynamic and governed by the fiber state machine, while `Drop` remains useful for resources local to one effect.","locale":"en"},"4696":{"id":"/en/docs/concepts-related-work-92","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#related-work-7","content":"**In kardia:** an `EffectHandle` does not dispose its effect on `Drop`; an effect lives until its fiber unloads or it is disposed explicitly, so a component's lifetime is never tied to a Rust scope. Inside an effect, ordinary `Drop` types still clean up local resources. See Effects and Lifecycle.","locale":"en"},"4697":{"id":"/en/docs/concepts-related-work-93","page_id":"/en/docs/concepts-related-work","tags":[],"type":"text","url":"/en/docs/concepts-related-work#conclusion-8","content":"Revertible effects give local temporal composability (Revertible effects); reactive coeffects give local spatial composability (Reactive coeffects); the context paradigm and observational equivalence give independence (The context paradigm); the calculus (A calculus of dynamic composition) lifts both to whole systems with preservation, recovery exactness, ordering, coherence, progress and confluence (Metatheory). Cordis realises this (Implementation in the paper); Koishi validates it. The future validation target is **self-evolving agent harnesses**, which stress complete recovery under rapid replacement and dependency coordination under frequent topological change.","locale":"en"},"4698":{"id":"/en/docs/concepts-revertible-effects","page_id":"/en/docs/concepts-revertible-effects","type":"page","content":"Revertible effects","breadcrumbs":["kardia Documentation","Concepts"],"tags":[],"url":"/en/docs/concepts-revertible-effects","locale":"en"},"4699":{"id":"/en/docs/concepts-revertible-effects-0","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects","content":"Paper §3.1: effects paired with inverses, the effect context, effect functions and effect iterators, which give a single component local temporal composability.","locale":"en"},"4700":{"id":"/en/docs/concepts-revertible-effects-1","page_id":"/en/docs/concepts-revertible-effects","type":"heading","tags":[],"url":"/en/docs/concepts-revertible-effects#from-impure-functions-to-context-transformations-311","content":"From impure functions to context transformations (§3.1.1)","locale":"en"},"4701":{"id":"/en/docs/concepts-revertible-effects-2","page_id":"/en/docs/concepts-revertible-effects","type":"heading","tags":[],"url":"/en/docs/concepts-revertible-effects#definition-1--twisted-composition","content":"Definition 1 – twisted composition","locale":"en"},"4702":{"id":"/en/docs/concepts-revertible-effects-3","page_id":"/en/docs/concepts-revertible-effects","type":"heading","tags":[],"url":"/en/docs/concepts-revertible-effects#definition-2--effect-context","content":"Definition 2 – effect context","locale":"en"},"4703":{"id":"/en/docs/concepts-revertible-effects-4","page_id":"/en/docs/concepts-revertible-effects","type":"heading","tags":[],"url":"/en/docs/concepts-revertible-effects#definition-3--track","content":"Definition 3 – track","locale":"en"},"4704":{"id":"/en/docs/concepts-revertible-effects-5","page_id":"/en/docs/concepts-revertible-effects","type":"heading","tags":[],"url":"/en/docs/concepts-revertible-effects#definition-6--recover","content":"Definition 6 – recover","locale":"en"},"4705":{"id":"/en/docs/concepts-revertible-effects-6","page_id":"/en/docs/concepts-revertible-effects","type":"heading","tags":[],"url":"/en/docs/concepts-revertible-effects#effect-functions-312","content":"Effect functions (§3.1.2)","locale":"en"},"4706":{"id":"/en/docs/concepts-revertible-effects-7","page_id":"/en/docs/concepts-revertible-effects","type":"heading","tags":[],"url":"/en/docs/concepts-revertible-effects#definition-8--effect-function-and-witnessed-effect-function","content":"Definition 8 – effect function and witnessed effect function","locale":"en"},"4707":{"id":"/en/docs/concepts-revertible-effects-8","page_id":"/en/docs/concepts-revertible-effects","type":"heading","tags":[],"url":"/en/docs/concepts-revertible-effects#definition-9--effect-composition-","content":"Definition 9 – effect composition ⋄","locale":"en"},"4708":{"id":"/en/docs/concepts-revertible-effects-9","page_id":"/en/docs/concepts-revertible-effects","type":"heading","tags":[],"url":"/en/docs/concepts-revertible-effects#definition-12--effect-lifting-to-the-effect-context","content":"Definition 12 – effect (lifting to the effect context)","locale":"en"},"4709":{"id":"/en/docs/concepts-revertible-effects-10","page_id":"/en/docs/concepts-revertible-effects","type":"heading","tags":[],"url":"/en/docs/concepts-revertible-effects#effect-iterators-313","content":"Effect iterators (§3.1.3)","locale":"en"},"4710":{"id":"/en/docs/concepts-revertible-effects-11","page_id":"/en/docs/concepts-revertible-effects","type":"heading","tags":[],"url":"/en/docs/concepts-revertible-effects#definition-17--effect-iterator","content":"Definition 17 – effect iterator","locale":"en"},"4711":{"id":"/en/docs/concepts-revertible-effects-12","page_id":"/en/docs/concepts-revertible-effects","type":"heading","tags":[],"url":"/en/docs/concepts-revertible-effects#definition-18--effect-iterator-transformation","content":"Definition 18 – effect iterator transformation","locale":"en"},"4712":{"id":"/en/docs/concepts-revertible-effects-13","page_id":"/en/docs/concepts-revertible-effects","type":"heading","tags":[],"url":"/en/docs/concepts-revertible-effects#what-local-temporal-composability-means","content":"What local temporal composability means","locale":"en"},"4713":{"id":"/en/docs/concepts-revertible-effects-14","page_id":"/en/docs/concepts-revertible-effects","type":"heading","tags":[],"url":"/en/docs/concepts-revertible-effects#engineering-take-aways","content":"Engineering take-aways","locale":"en"},"4714":{"id":"/en/docs/concepts-revertible-effects-15","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects","content":"This page summarises §3.1 of the paper (arXiv:2608.25512). Definition and theorem numbers are the paper's. For how Cordis implements effects, see Effects in the Cordis reference; for kardia's Rust design, see Effects in the guide and API design.","locale":"en"},"4715":{"id":"/en/docs/concepts-revertible-effects-16","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects","content":"Temporal composability requires that every modification a component makes be **trackable** and **recoverable**. The paper models an effect as a function `Γ → Γ × (Γ → Γ)`: given the current context it returns the modified context *and* an explicit inverse. Returning the inverse to the runtime makes the effect trackable; supplying it makes the effect revertible.","locale":"en"},"4716":{"id":"/en/docs/concepts-revertible-effects-17","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#from-impure-functions-to-context-transformations-311","content":"Any impure `f : X ⇝ Y` is rewritten into a pure `f : Γ × X → Γ × Y` over a context type `Γ`. For a fixed input `x`, the side effect is the endomorphism `γ ↦ pr₁(f(γ, x)) : Γ → Γ`. Effects therefore live in the **monoid of transformations** `(Γ → Γ, ∘, id_Γ)`:","locale":"en"},"4717":{"id":"/en/docs/concepts-revertible-effects-18","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#from-impure-functions-to-context-transformations-311","content":"closure: sequential composition of effects is an effect;","locale":"en"},"4718":{"id":"/en/docs/concepts-revertible-effects-19","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#from-impure-functions-to-context-transformations-311","content":"associativity: bracketing does not matter;","locale":"en"},"4719":{"id":"/en/docs/concepts-revertible-effects-20","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#from-impure-functions-to-context-transformations-311","content":"identity: `id_Γ` is the unit.","locale":"en"},"4720":{"id":"/en/docs/concepts-revertible-effects-21","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#from-impure-functions-to-context-transformations-311","content":"An undo for `f` is a **left inverse** `g` (`g ∘ f = id`, never required of `f ∘ g`); the paper simply calls it *the inverse*.","locale":"en"},"4721":{"id":"/en/docs/concepts-revertible-effects-22","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#definition-1--twisted-composition","content":"Forwards compose normally, inverses in the opposite order. This makes `(Γ→Γ) × (Γ→Γ)` a monoid **`𝔗Γ`** (the product of the transformation monoid with its opposite), with unit `(id, id)`.","locale":"en"},"4722":{"id":"/en/docs/concepts-revertible-effects-23","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#definition-2--effect-context","content":"`∂Γ := Γ × (Γ → Γ)`, a pair `(γ, φ)`:","locale":"en"},"4723":{"id":"/en/docs/concepts-revertible-effects-24","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#definition-2--effect-context","content":"`γ`: the current state;","locale":"en"},"4724":{"id":"/en/docs/concepts-revertible-effects-25","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#definition-2--effect-context","content":"`φ`: the **accumulator**, the composite of inverses so far; it recovers the initial state.","locale":"en"},"4725":{"id":"/en/docs/concepts-revertible-effects-26","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#definition-2--effect-context","content":"The initial effect context is `(γ₀, id)`. Iterating gives the tower `Γ, ∂Γ, ∂²Γ, …`.","locale":"en"},"4726":{"id":"/en/docs/concepts-revertible-effects-27","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#definition-3--track","content":"**Theorem 4**: tracking leaves the forward behaviour untouched: `pr₁ ∘ track(f,g) = f ∘ pr₁`.","locale":"en"},"4727":{"id":"/en/docs/concepts-revertible-effects-28","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#definition-3--track","content":"**Theorem 5**: `track` is a monoid homomorphism `𝔗Γ → (∂Γ → ∂Γ)`: tracking pairs one at a time equals tracking their twisted composite.","locale":"en"},"4728":{"id":"/en/docs/concepts-revertible-effects-29","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#definition-6--recover","content":"Apply the accumulator, then reset it.","locale":"en"},"4729":{"id":"/en/docs/concepts-revertible-effects-30","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#definition-6--recover","content":"**Theorem 7**: for `g(f(γ)) = γ`: `recover(track(f,g)(γ,φ)) = recover(γ,φ)`. A tracked step whose inverse reverts it does not move the recovery target. The **soundness invariant** of a state is `φ(γ) = γ₀`; every state reached from `(γ₀, id)` by such steps satisfies it, and `recover` carries it back to `(γ₀, id)`.","locale":"en"},"4730":{"id":"/en/docs/concepts-revertible-effects-31","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#definition-6--recover","content":"By Theorem 5 the same holds for whole sequences (eq. 11).","locale":"en"},"4731":{"id":"/en/docs/concepts-revertible-effects-32","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#effect-functions-312","content":"`track`/`recover` have two limitations:","locale":"en"},"4732":{"id":"/en/docs/concepts-revertible-effects-33","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#effect-functions-312","content":"`track(f, g)` fixes `g` before the state is seen: a single uniform inverse must work at every state. Real effects only need an inverse *for the state where they were applied* (for example \"remove the entry I just added, with the id I just drew\").","locale":"en"},"4733":{"id":"/en/docs/concepts-revertible-effects-34","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#effect-functions-312","content":"`recover` is all-or-nothing: you cannot undo one effect and keep the others.","locale":"en"},"4734":{"id":"/en/docs/concepts-revertible-effects-35","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#effect-functions-312","content":"The fixes: return the inverse at the point of application (input side, `Γ → ∂Γ`), and make the lifted effect itself return an inverse (output side, `∂Γ → ∂²Γ`). Both have the same shape.","locale":"en"},"4735":{"id":"/en/docs/concepts-revertible-effects-36","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#definition-8--effect-function-and-witnessed-effect-function","content":"`𝔈Γ := Γ → Γ × (Γ → Γ)`, with `e(γ) = (δ, g)`: new context `δ`, inverse `g`.","locale":"en"},"4736":{"id":"/en/docs/concepts-revertible-effects-37","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#definition-8--effect-function-and-witnessed-effect-function","content":"`𝔈Γ*` additionally carries a **witness** `(δ, g) = e(γ) ⇒ g(δ) = γ`: the inverse reverts the effect *at the state where it was applied*. A uniform inverse with `g ∘ f = id` is a special case.","locale":"en"},"4737":{"id":"/en/docs/concepts-revertible-effects-38","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#definition-9--effect-composition-","content":"Run `g` then `f`, and compose the inverses so that `f`'s inverse runs first.","locale":"en"},"4738":{"id":"/en/docs/concepts-revertible-effects-39","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#definition-9--effect-composition-","content":"**Theorem 10**: `(𝔈Γ, ⋄)` is a monoid with unit `η(γ) = (γ, id)`; `(f,g) ↦ γ ↦ (f(γ), g)` is a homomorphism `𝔗Γ → 𝔈Γ`.","locale":"en"},"4739":{"id":"/en/docs/concepts-revertible-effects-40","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#definition-9--effect-composition-","content":"**Theorem 11**: `𝔈Γ*` is a submonoid (witnessing survives composition), and uniform inverses land in it.","locale":"en"},"4740":{"id":"/en/docs/concepts-revertible-effects-41","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#definition-12--effect-lifting-to-the-effect-context","content":"The returned inverse is itself a *track* of the swapped pair: undoing is an effect (transform by `g`), and undoing the undo is performing the effect again (`pr₁ ∘ e`).","locale":"en"},"4741":{"id":"/en/docs/concepts-revertible-effects-42","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#definition-12--effect-lifting-to-the-effect-context","content":"**Theorem 13**: `effect(f) ⋄ effect(g) = effect(f ⋄ g)`.","locale":"en"},"4742":{"id":"/en/docs/concepts-revertible-effects-43","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#definition-12--effect-lifting-to-the-effect-context","content":"**Theorem 14**: projections commute: the lifted forward and inverse maps act on the state exactly as `f` and `g`.","locale":"en"},"4743":{"id":"/en/docs/concepts-revertible-effects-44","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#definition-12--effect-lifting-to-the-effect-context","content":"**Theorem 15**: for a witnessed `e`: `g′(Δ) = (γ, φ ∘ g ∘ f)`. The *state* is recovered exactly; the *accumulator* is restored if and only if `g ∘ f = id`; in every case `(φ ∘ g ∘ f)(γ) = φ(γ)`, so the soundness invariant is preserved. Hence `effect` does **not** carry `𝔈Γ*` into `𝔈*∂Γ` in general, but reverting never moves the recovery target.","locale":"en"},"4744":{"id":"/en/docs/concepts-revertible-effects-45","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#effect-iterators-313","content":"A component's loading is not one effect but a **sequence**.","locale":"en"},"4745":{"id":"/en/docs/concepts-revertible-effects-46","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#effect-iterators-313","content":"**Theorem 16**: applying `e₁…eₙ ∈ 𝔈Γ*` from `(γ₀, id)` and reverting in **reverse order**, every revert recovers the state its application ran against, and every intermediate state satisfies the soundness invariant. LIFO needs nothing more.","locale":"en"},"4746":{"id":"/en/docs/concepts-revertible-effects-47","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#definition-17--effect-iterator","content":"Each iteration yields `(δ, g, o)`: the new context, the inverse, and the continuation (`Nothing` = done, `Just(i)` = next).","locale":"en"},"4747":{"id":"/en/docs/concepts-revertible-effects-48","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#definition-18--effect-iterator-transformation","content":"The accumulator becomes `φ ∘ g₁ ∘ … ∘ g_k`, which reverts in LIFO order (Theorem 16).","locale":"en"},"4748":{"id":"/en/docs/concepts-revertible-effects-49","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#definition-18--effect-iterator-transformation","content":"`effect^iter` lands in the same `∂Γ → ∂²Γ` as `effect`, so **an iterator is an effect** and composes anywhere an effect can (nesting).","locale":"en"},"4749":{"id":"/en/docs/concepts-revertible-effects-50","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#definition-18--effect-iterator-transformation","content":"The `Maybe(ℑ)` continuation makes a **boundary** available between any two iterations: at a boundary the accumulator recovers exactly the iterations so far. This is the hook used later for *interruption* (L-Divert, see the calculus) and *cancellation*.","locale":"en"},"4750":{"id":"/en/docs/concepts-revertible-effects-51","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#definition-18--effect-iterator-transformation","content":"The iterator is a **reified delimited continuation**. Mainstream languages expose it through `yield`, so the model \"maps directly onto the generators they already provide\".","locale":"en"},"4751":{"id":"/en/docs/concepts-revertible-effects-52","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#definition-18--effect-iterator-transformation","content":"A plain effect function embeds as an iterator whose first iteration yields `Nothing` (eq. 19).","locale":"en"},"4752":{"id":"/en/docs/concepts-revertible-effects-53","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#definition-18--effect-iterator-transformation","content":"**In kardia:** an effect body receives an `EffectScope`. `scope.defer(..)` collects an inverse without a boundary; `scope.yield_(disposer)` collects one and marks an iteration boundary, and `scope.checkpoint()` marks a boundary alone. Both return `Err(Interrupted)` once the effect has been disposed, so `?` ends the body at the boundary, keeping only the inverses collected so far. See Effects.","locale":"en"},"4753":{"id":"/en/docs/concepts-revertible-effects-54","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#what-local-temporal-composability-means","content":"> For every sequence of effect functions a component applies, the accumulator recovers the context it began at (Theorem 7), and reverting the sequence hands each inverse the state its own application ran against (Theorem 16). Loading a component is running one iterator and accumulating its inverses in `φ`; unloading it is applying `φ`.","locale":"en"},"4754":{"id":"/en/docs/concepts-revertible-effects-55","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#what-local-temporal-composability-means","content":"Two things are deliberately **left out** here and supplied later by *independence* (§3.4, see The context paradigm): reverting out of the order the accumulator imposes, and sequences that interleave the effects of other components.","locale":"en"},"4755":{"id":"/en/docs/concepts-revertible-effects-56","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#engineering-take-aways","content":"Formal notion","locale":"en"},"4756":{"id":"/en/docs/concepts-revertible-effects-57","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#engineering-take-aways","content":"Practical reading","locale":"en"},"4757":{"id":"/en/docs/concepts-revertible-effects-58","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#engineering-take-aways","content":"Effect function returns inverse","locale":"en"},"4758":{"id":"/en/docs/concepts-revertible-effects-59","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#engineering-take-aways","content":"Every registration API returns a disposer created *at the point of registration* (it can capture the id it just drew).","locale":"en"},"4759":{"id":"/en/docs/concepts-revertible-effects-60","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#engineering-take-aways","content":"Witness","locale":"en"},"4760":{"id":"/en/docs/concepts-revertible-effects-61","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#engineering-take-aways","content":"An obligation on the author: the disposer must undo exactly that registration. Not checked at runtime.","locale":"en"},"4761":{"id":"/en/docs/concepts-revertible-effects-62","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#engineering-take-aways","content":"`⋄` / twisted composition","locale":"en"},"4762":{"id":"/en/docs/concepts-revertible-effects-63","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#engineering-take-aways","content":"Disposers of a composite effect run in reverse order of their creation.","locale":"en"},"4763":{"id":"/en/docs/concepts-revertible-effects-64","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#engineering-take-aways","content":"`effect` returns an inverse at the next level","locale":"en"},"4764":{"id":"/en/docs/concepts-revertible-effects-65","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#engineering-take-aways","content":"`ctx.effect(...)` itself returns a disposer, and that disposer is registered in the *enclosing* scope's accumulator: effects nest.","locale":"en"},"4765":{"id":"/en/docs/concepts-revertible-effects-66","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#engineering-take-aways","content":"Iterator boundary","locale":"en"},"4766":{"id":"/en/docs/concepts-revertible-effects-67","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#engineering-take-aways","content":"A multi-step setup can be cancelled *between* steps, keeping only the inverses of completed steps.","locale":"en"},"4767":{"id":"/en/docs/concepts-revertible-effects-68","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#engineering-take-aways","content":"Soundness invariant","locale":"en"},"4768":{"id":"/en/docs/concepts-revertible-effects-69","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#engineering-take-aways","content":"Disposing twice is forbidden: an inverse applied at a state no application produced reverts nothing meaningful (the implementation enforces \"at most once\").","locale":"en"},"4769":{"id":"/en/docs/concepts-revertible-effects-70","page_id":"/en/docs/concepts-revertible-effects","tags":[],"type":"text","url":"/en/docs/concepts-revertible-effects#engineering-take-aways","content":"**In kardia:** `ctx.effect(label, |scope| async { .. })` and `ctx.effect_sync(..)` return an `EffectHandle` registered on the current fiber's accumulator; `scope.adopt(handle)` moves a nested effect under an enclosing one. A `Disposer` wraps an `FnOnce`, so \"at most once\" is enforced by the type system. See Effects and API design.","locale":"en"},"4770":{"id":"/en/docs/concepts","page_id":"/en/docs/concepts","type":"page","content":"Concepts","breadcrumbs":["kardia Documentation","Concepts"],"tags":[],"url":"/en/docs/concepts","locale":"en"},"4771":{"id":"/en/docs/concepts-0","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts","content":"The theory behind kardia: the paper's problem statement, its contributions, how its sections map to the pages of this section, and its vocabulary.","locale":"en"},"4772":{"id":"/en/docs/concepts-1","page_id":"/en/docs/concepts","type":"heading","tags":[],"url":"/en/docs/concepts#problem-statement","content":"Problem statement","locale":"en"},"4773":{"id":"/en/docs/concepts-2","page_id":"/en/docs/concepts","type":"heading","tags":[],"url":"/en/docs/concepts#motivating-examples-12","content":"Motivating examples (§1.2)","locale":"en"},"4774":{"id":"/en/docs/concepts-3","page_id":"/en/docs/concepts","type":"heading","tags":[],"url":"/en/docs/concepts#core-idea","content":"Core idea","locale":"en"},"4775":{"id":"/en/docs/concepts-4","page_id":"/en/docs/concepts","type":"heading","tags":[],"url":"/en/docs/concepts#pages-in-this-section","content":"Pages in this section","locale":"en"},"4776":{"id":"/en/docs/concepts-5","page_id":"/en/docs/concepts","type":"heading","tags":[],"url":"/en/docs/concepts#preliminaries-2-in-brief","content":"Preliminaries (§2) in brief","locale":"en"},"4777":{"id":"/en/docs/concepts-6","page_id":"/en/docs/concepts","type":"heading","tags":[],"url":"/en/docs/concepts#glossary","content":"Glossary","locale":"en"},"4778":{"id":"/en/docs/concepts-7","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts","content":"kardia implements the model of the paper *A Programming Paradigm for Spatiotemporal Composability* (arXiv:2608.25512; 92 pages; Shi, Zhang and Cui; Peking University and DeepSeek-AI). This section summarises the paper's theory: its problem statement, contributions and vocabulary, then one page per part of the paper. Definition, theorem, lemma and algorithm numbers are always the paper's.","locale":"en"},"4779":{"id":"/en/docs/concepts-8","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts","content":"This section does not describe the Cordis code base (see the Cordis reference) or kardia's Rust design (see Development). Where a concept has a direct counterpart in kardia, an \"In kardia\" callout says so and links the relevant page.","locale":"en"},"4780":{"id":"/en/docs/concepts-9","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#problem-statement","content":"Static composition (function calls, imports, inheritance) is fixed at compile time. Plugin systems and *self-evolving agent harnesses* need **dynamic composition**: components are loaded, unloaded and reconfigured while the process keeps running. The paper argues that this has two orthogonal dimensions beyond the algebraic aspects of composition (§1.1):","locale":"en"},"4781":{"id":"/en/docs/concepts-10","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#problem-statement","content":"Dimension","locale":"en"},"4782":{"id":"/en/docs/concepts-11","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#problem-statement","content":"Requirement","locale":"en"},"4783":{"id":"/en/docs/concepts-12","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#problem-statement","content":"Static analogue","locale":"en"},"4784":{"id":"/en/docs/concepts-13","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#problem-statement","content":"**Temporal composability**","locale":"en"},"4785":{"id":"/en/docs/concepts-14","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#problem-statement","content":"When a component is removed, every modification it made to the shared environment is completely and safely reversed (resources, event registrations, state mutations), in an orderly way.","locale":"en"},"4786":{"id":"/en/docs/concepts-15","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#problem-statement","content":"Lexical scoping: RAII, bracket patterns","locale":"en"},"4787":{"id":"/en/docs/concepts-16","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#problem-statement","content":"**Spatial composability**","locale":"en"},"4788":{"id":"/en/docs/concepts-17","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#problem-statement","content":"Components declare, discover and resolve dependencies on one another in a structured, verifiable way; lifecycles are coordinated as dependencies appear, disappear or change identity.","locale":"en"},"4789":{"id":"/en/docs/concepts-18","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#problem-statement","content":"Module import resolution","locale":"en"},"4790":{"id":"/en/docs/concepts-19","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#motivating-examples-12","content":"**VSCode**: extensions cannot be unloaded individually (87 of the top 100 contain code and require an extension-host restart); `deactivate` is only a shutdown hook and separates disposal from creation. `extensionDependencies` is barely used (7 of the top 100), and inter-extension APIs are untyped (`exports: any`).","locale":"en"},"4791":{"id":"/en/docs/concepts-20","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#motivating-examples-12","content":"**Agent harnesses**: a harness that rewrites its own components continuously cannot afford a restart per modification, and naive code replacement silently breaks dependents.","locale":"en"},"4792":{"id":"/en/docs/concepts-21","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#motivating-examples-12","content":"**Coarse-grained workaround**: OS processes give temporal composability per process; container orchestrators give spatial composability per service. Both discard in-process state on restart and cannot express in-address-space dependencies; the granularity is wrong.","locale":"en"},"4793":{"id":"/en/docs/concepts-22","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#core-idea","content":"Effect systems describe how a computation **modifies** its environment; coeffect systems describe what it **requires** from its environment. Both are classically *static* (checked over lexically fixed scopes). The paper **reifies** both as runtime objects:","locale":"en"},"4794":{"id":"/en/docs/concepts-23","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#core-idea","content":"**Revertible effects** (§3.1): every context transformation is paired with an inverse that the runtime holds. Tracking and recovery are monoid homomorphisms, so the context is recovered upon removal, which gives *local temporal composability*.","locale":"en"},"4795":{"id":"/en/docs/concepts-24","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#core-idea","content":"**Reactive coeffects** (§3.2): a component declares the keys it requires (a *specification*); every context change is classified against it as *activating*, *deactivating* or *neutral*, which drives activation and deactivation. This gives *local spatial composability*.","locale":"en"},"4796":{"id":"/en/docs/concepts-25","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#core-idea","content":"**The context paradigm** (§3.3): the effect context and the coeffect context are unified into one context type `Γ∞`, and *every* effect and coeffect is mediated through it. This induces an **observational equivalence `≃`** under which the effects of distinct components become **independent** (§3.4).","locale":"en"},"4797":{"id":"/en/docs/concepts-26","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#core-idea","content":"**A calculus of dynamic composition** (§4): a component is a triple `(d, p, e)` (dependencies, provisions, effect iterator); its instantiations are **fibers**; nine rules (3 orchestration, 6 lifecycle) move fibers through `Inactive → Reloading → Active → Unloading`. The metatheory proves preservation, recovery exactness, ordering, resolution coherence, progress (no deadlock and termination) and **confluence** (the quiescent state equals a from-scratch static load of the final configuration).","locale":"en"},"4798":{"id":"/en/docs/concepts-27","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#core-idea","content":"**Cordis** (§5): a TypeScript meta-framework, made of a core library (effect tracking and coeffect resolution) and a declarative loader with configuration reconciliation and hot module replacement. Case study: **Koishi**, a chatbot framework with more than 4000 community plugins (Koishi uses Cordis v3; the paper describes v4).","locale":"en"},"4799":{"id":"/en/docs/concepts-28","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#pages-in-this-section","content":"Paper section","locale":"en"},"4800":{"id":"/en/docs/concepts-29","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#pages-in-this-section","content":"Topic","locale":"en"},"4801":{"id":"/en/docs/concepts-30","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#pages-in-this-section","content":"Page","locale":"en"},"4802":{"id":"/en/docs/concepts-31","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#pages-in-this-section","content":"§1–2","locale":"en"},"4803":{"id":"/en/docs/concepts-32","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#pages-in-this-section","content":"Motivation, effects and coeffects preliminaries","locale":"en"},"4804":{"id":"/en/docs/concepts-33","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#pages-in-this-section","content":"this page","locale":"en"},"4805":{"id":"/en/docs/concepts-34","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#pages-in-this-section","content":"§3.1","locale":"en"},"4806":{"id":"/en/docs/concepts-35","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#pages-in-this-section","content":"Revertible effects (effect context, track/recover, effect functions, effect iterators)","locale":"en"},"4807":{"id":"/en/docs/concepts-36","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#pages-in-this-section","content":"Revertible effects","locale":"en"},"4808":{"id":"/en/docs/concepts-37","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#pages-in-this-section","content":"§3.2","locale":"en"},"4809":{"id":"/en/docs/concepts-38","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#pages-in-this-section","content":"Reactive coeffects (coeffect context, specification and notification, isolation, interception)","locale":"en"},"4810":{"id":"/en/docs/concepts-39","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#pages-in-this-section","content":"Reactive coeffects","locale":"en"},"4811":{"id":"/en/docs/concepts-40","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#pages-in-this-section","content":"§3.3–3.4","locale":"en"},"4812":{"id":"/en/docs/concepts-41","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#pages-in-this-section","content":"Unified context, coeffect operations, observational equivalence, independence, commutativity","locale":"en"},"4813":{"id":"/en/docs/concepts-42","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#pages-in-this-section","content":"The context paradigm","locale":"en"},"4814":{"id":"/en/docs/concepts-43","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#pages-in-this-section","content":"§4.1–4.2","locale":"en"},"4815":{"id":"/en/docs/concepts-44","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#pages-in-this-section","content":"Components, fibers, registry, the nine rules, guard, confinement","locale":"en"},"4816":{"id":"/en/docs/concepts-45","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#pages-in-this-section","content":"A calculus of dynamic composition","locale":"en"},"4817":{"id":"/en/docs/concepts-46","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#pages-in-this-section","content":"§4.3–4.4","locale":"en"},"4818":{"id":"/en/docs/concepts-47","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#pages-in-this-section","content":"Metatheory, extensions (asynchrony, failure, isolation, configuration)","locale":"en"},"4819":{"id":"/en/docs/concepts-48","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#pages-in-this-section","content":"Metatheory and extensions","locale":"en"},"4820":{"id":"/en/docs/concepts-49","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#pages-in-this-section","content":"§5","locale":"en"},"4821":{"id":"/en/docs/concepts-50","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#pages-in-this-section","content":"Implementation as described by the paper (Algorithms 1–10), loader, HMR, Koishi","locale":"en"},"4822":{"id":"/en/docs/concepts-51","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#pages-in-this-section","content":"Implementation in the paper","locale":"en"},"4823":{"id":"/en/docs/concepts-52","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#pages-in-this-section","content":"§6–8","locale":"en"},"4824":{"id":"/en/docs/concepts-53","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#pages-in-this-section","content":"Discussion, related work, conclusion","locale":"en"},"4825":{"id":"/en/docs/concepts-54","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#pages-in-this-section","content":"Discussion and related work","locale":"en"},"4826":{"id":"/en/docs/concepts-55","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#pages-in-this-section","content":"<Card title=\"Revertible effects\" href=\"/docs/concepts-revertible-effects\" description=\"Every effect returns its inverse; accumulated LIFO, the inverses recover the context a component started from.\" />","locale":"en"},"4827":{"id":"/en/docs/concepts-56","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#pages-in-this-section","content":"<Card title=\"Reactive coeffects\" href=\"/docs/concepts-reactive-coeffects\" description=\"Components declare the keys they need and activate or deactivate as the context gains or loses them.\" />","locale":"en"},"4828":{"id":"/en/docs/concepts-57","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#pages-in-this-section","content":"<Card title=\"The context paradigm\" href=\"/docs/concepts-context-paradigm\" description=\"One context mediates everything, so effects of different components are independent up to observational equivalence.\" />","locale":"en"},"4829":{"id":"/en/docs/concepts-58","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#pages-in-this-section","content":"<Card title=\"A calculus of dynamic composition\" href=\"/docs/concepts-calculus\" description=\"Fibers, the registry and the nine rules, with the guard that makes providers outlive their consumers.\" />","locale":"en"},"4830":{"id":"/en/docs/concepts-59","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#pages-in-this-section","content":"<Card title=\"Metatheory and extensions\" href=\"/docs/concepts-metatheory\" description=\"Preservation, recovery exactness, ordering, coherence, progress and confluence; asynchrony, failure, isolation, configuration.\" />","locale":"en"},"4831":{"id":"/en/docs/concepts-60","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#pages-in-this-section","content":"<Card title=\"Implementation in the paper\" href=\"/docs/concepts-implementation\" description=\"Table 2 and Algorithms 1–10: how the paper says Cordis realises the calculus, the loader and HMR.\" />","locale":"en"},"4832":{"id":"/en/docs/concepts-61","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#pages-in-this-section","content":"<Card title=\"Discussion and related work\" href=\"/docs/concepts-related-work\" description=\"System boundary, brokers, access control, language requirements, versioning, related work, with notes on Rust.\" />","locale":"en"},"4833":{"id":"/en/docs/concepts-62","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#preliminaries-2-in-brief","content":"**Effects.** Judgments `Γ ⊢ t : T ! effect`. Monadic effects (Moggi, Wadler) encapsulate effectful computation in `T(A)` with unit `η` and multiplication `μ`. Algebraic effects (Plotkin and Power) declare operation signatures; effect handlers (Plotkin and Pretnar) interpret them with delimited continuations (Koka, Eff, OCaml 5).","locale":"en"},"4834":{"id":"/en/docs/concepts-63","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#preliminaries-2-in-brief","content":"**Coeffects.** Judgments `Γ @ coeffect ⊢ t : T` annotate the *context*. Comonads `(D, ε, δ)` (Uustalu and Vene) structure context-dependent computation; Petricek et al. propose coeffects as a unified static analysis; graded coeffects use a pre-ordered semiring to quantify usage.","locale":"en"},"4835":{"id":"/en/docs/concepts-64","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#preliminaries-2-in-brief","content":"**Gap.** Both are static instruments over lexically fixed scopes. No fixed lexical scope delimits a plugin loaded after deployment, and no compile-time context anticipates dependencies arising from runtime configuration. The paper therefore *reifies* the structures, so that a runtime can operate on them and establish dynamically what these systems guarantee statically.","locale":"en"},"4836":{"id":"/en/docs/concepts-65","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"The paper's vocabulary:","locale":"en"},"4837":{"id":"/en/docs/concepts-66","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"Term","locale":"en"},"4838":{"id":"/en/docs/concepts-67","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"Meaning","locale":"en"},"4839":{"id":"/en/docs/concepts-68","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"Context type `Γ`","locale":"en"},"4840":{"id":"/en/docs/concepts-69","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"Runtime-operable reification of the typing context; `Γ∞ = μΓ. Γ × (Γ→Γ) × Σ`.","locale":"en"},"4841":{"id":"/en/docs/concepts-70","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"Effect context `∂Γ`","locale":"en"},"4842":{"id":"/en/docs/concepts-71","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"`Γ × (Γ→Γ)`: a state plus an *accumulator* (composite of inverses).","locale":"en"},"4843":{"id":"/en/docs/concepts-72","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"Accumulator `φ`","locale":"en"},"4844":{"id":"/en/docs/concepts-73","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"Function that recovers the context to its initial state; LIFO composite of inverses.","locale":"en"},"4845":{"id":"/en/docs/concepts-74","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"Effect function `𝔈Γ`","locale":"en"},"4846":{"id":"/en/docs/concepts-75","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"`Γ → Γ × (Γ→Γ)`: returns the new state and a per-state inverse. Witnessed (`𝔈Γ*`) when the inverse provably reverts at the applied state.","locale":"en"},"4847":{"id":"/en/docs/concepts-76","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"Effect iterator `ℑΓ`","locale":"en"},"4848":{"id":"/en/docs/concepts-77","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"`μℑ. Γ → Γ × (Γ→Γ) × Maybe(ℑ)`: a sequence of effects with a boundary between consecutive iterations; a reified delimited continuation (generators).","locale":"en"},"4849":{"id":"/en/docs/concepts-78","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"Coeffect context `Σ`","locale":"en"},"4850":{"id":"/en/docs/concepts-79","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"Finite dependent partial map `(k:K) ⇀ V_k`.","locale":"en"},"4851":{"id":"/en/docs/concepts-80","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"Specification `d`","locale":"en"},"4852":{"id":"/en/docs/concepts-81","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"`Set(K)`: keys a component requires.","locale":"en"},"4853":{"id":"/en/docs/concepts-82","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"Provision `p`","locale":"en"},"4854":{"id":"/en/docs/concepts-83","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"`Set(K)`: keys a component may install.","locale":"en"},"4855":{"id":"/en/docs/concepts-84","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"`notify_d(σ, σ′)`","locale":"en"},"4856":{"id":"/en/docs/concepts-85","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"Classification of a transition: activating / deactivating / neutral.","locale":"en"},"4857":{"id":"/en/docs/concepts-86","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"Isolation realm","locale":"en"},"4858":{"id":"/en/docs/concepts-87","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"`ρ : K ⇀ R`; key → realm → value (two-layer resolution).","locale":"en"},"4859":{"id":"/en/docs/concepts-88","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"Interception metadata","locale":"en"},"4860":{"id":"/en/docs/concepts-89","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"Per-key monoid `(M_k, ⊕_k, ε_k)`; merged as component-declared `⊕` context-carried (right-biased).","locale":"en"},"4861":{"id":"/en/docs/concepts-90","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"Coeffect operations `𝒜_k`","locale":"en"},"4862":{"id":"/en/docs/concepts-91","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"Operations a value at key `k` offers; they induce the observational equivalence `≃_k`.","locale":"en"},"4863":{"id":"/en/docs/concepts-92","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"Commutative key","locale":"en"},"4864":{"id":"/en/docs/concepts-93","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"All operations at the key are pairwise independent; a *witnessed coeffect* carries that proof.","locale":"en"},"4865":{"id":"/en/docs/concepts-94","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"Component `ℭΓ`","locale":"en"},"4866":{"id":"/en/docs/concepts-95","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"Triple `(d, p, e)`.","locale":"en"},"4867":{"id":"/en/docs/concepts-96","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"Fiber","locale":"en"},"4868":{"id":"/en/docs/concepts-97","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"Instantiation `⟨d, p, e, π, σ, τ, θ⟩` (parent, own table, retirement flag, lifecycle state).","locale":"en"},"4869":{"id":"/en/docs/concepts-98","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"Lifecycle state `θ`","locale":"en"},"4870":{"id":"/en/docs/concepts-99","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"`Inactive \\| Reloading(i,g,ω) \\| Active(g,ω) \\| Unloading(g,ω)`.","locale":"en"},"4871":{"id":"/en/docs/concepts-100","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"Committed view `ω`","locale":"en"},"4872":{"id":"/en/docs/concepts-101","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"Map from declared keys to the *names of providing fibers* at commit time.","locale":"en"},"4873":{"id":"/en/docs/concepts-102","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"Target view","locale":"en"},"4874":{"id":"/en/docs/concepts-103","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"What `ω` should be now (`⊥` if retired or unsatisfied).","locale":"en"},"4875":{"id":"/en/docs/concepts-104","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"Guard (`relied_n`)","locale":"en"},"4876":{"id":"/en/docs/concepts-105","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"L-Unload may fire only when no installed fiber's committed view names `n`.","locale":"en"},"4877":{"id":"/en/docs/concepts-106","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"Quiescent","locale":"en"},"4878":{"id":"/en/docs/concepts-107","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"Every fiber settled at its target.","locale":"en"},"4879":{"id":"/en/docs/concepts-108","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"Support set `A`","locale":"en"},"4880":{"id":"/en/docs/concepts-109","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"Fibers that are not retired, whose parent is supported, and whose declared keys are provided by supported fibers.","locale":"en"},"4881":{"id":"/en/docs/concepts-110","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"Inertia","locale":"en"},"4882":{"id":"/en/docs/concepts-111","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"Asynchronous hosts cannot abort an iteration in flight; only the *landing* alternative of L-Divert is available.","locale":"en"},"4883":{"id":"/en/docs/concepts-112","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"System boundary","locale":"en"},"4884":{"id":"/en/docs/concepts-113","page_id":"/en/docs/concepts","tags":[],"type":"text","url":"/en/docs/concepts#glossary","content":"Locations the system can exclusively modify and restore lie inside; others lie outside (emissions cross it).","locale":"en"},"4885":{"id":"/en/docs/development-concurrency","page_id":"/en/docs/development-concurrency","type":"page","content":"Concurrency and execution model","breadcrumbs":["kardia Documentation","Development"],"tags":[],"url":"/en/docs/development-concurrency","locale":"en"},"4886":{"id":"/en/docs/development-concurrency-0","page_id":"/en/docs/development-concurrency","tags":[],"type":"text","url":"/en/docs/development-concurrency","content":"How kardia reproduces JavaScript's run-to-completion atomicity with one lock per root, critical sections that return actions, and spawned transitions.","locale":"en"},"4887":{"id":"/en/docs/development-concurrency-1","page_id":"/en/docs/development-concurrency","type":"heading","tags":[],"url":"/en/docs/development-concurrency#why","content":"Why the model matters","locale":"en"},"4888":{"id":"/en/docs/development-concurrency-2","page_id":"/en/docs/development-concurrency","type":"heading","tags":[],"url":"/en/docs/development-concurrency#model","content":"Chosen model","locale":"en"},"4889":{"id":"/en/docs/development-concurrency-3","page_id":"/en/docs/development-concurrency","type":"heading","tags":[],"url":"/en/docs/development-concurrency#lock-ordering","content":"Lock ordering","locale":"en"},"4890":{"id":"/en/docs/development-concurrency-4","page_id":"/en/docs/development-concurrency","tags":[],"type":"text","url":"/en/docs/development-concurrency","content":"This page is decision **D1** of the guiding decisions: a `Send + Sync` core with one state lock per root, in which no user code runs while the lock is held.","locale":"en"},"4891":{"id":"/en/docs/development-concurrency-5","page_id":"/en/docs/development-concurrency","tags":[],"type":"text","url":"/en/docs/development-concurrency#why","content":"Cordis's correctness rests on JavaScript's run-to-completion semantics: code between two `await`s is atomic. Many algorithms (inertia in `_setEpoch`, `_initTask ??=` in the loader, \"assign options synchronously then commit\") depend on this. A Rust port must reproduce *that atomicity*, not JS's single-threadedness per se.","locale":"en"},"4892":{"id":"/en/docs/development-concurrency-6","page_id":"/en/docs/development-concurrency","tags":[],"type":"text","url":"/en/docs/development-concurrency#model","content":"All mutable runtime state of one root lives in `Root { state: parking_lot::Mutex<State>, … }`.","locale":"en"},"4893":{"id":"/en/docs/development-concurrency-7","page_id":"/en/docs/development-concurrency","tags":[],"type":"text","url":"/en/docs/development-concurrency#model","content":"**Porting rule:** every synchronous segment of the TS code becomes **one critical section** on `State`. Nothing awaits while holding the lock, and **no user code is called while holding the lock** (plugin `apply`, disposers, event listeners, availability checks).","locale":"en"},"4894":{"id":"/en/docs/development-concurrency-8","page_id":"/en/docs/development-concurrency","tags":[],"type":"text","url":"/en/docs/development-concurrency#model","content":"Critical sections are written as functions `fn step(&mut State, …) -> Actions`, where `Actions` is a small list of deferred work: `Spawn(Transition)`, `Emit(InternalEvent)`, `Wake(Notify)`, `RunDisposers(Vec<Disposer>)`. A tiny driver executes the actions after releasing the lock. This keeps the state machine **pure and unit-testable** and removes the reentrancy hazards JS hides (in TS, `_updateState` synchronously emits `internal/status` to user listeners from inside the state machine).","locale":"en"},"4895":{"id":"/en/docs/development-concurrency-9","page_id":"/en/docs/development-concurrency","tags":[],"type":"text","url":"/en/docs/development-concurrency#model","content":"Transitions (`reload`, `unload`) are spawned tokio tasks. The paper's footnote 2 anticipates this: *\"with lazy scheduling (e.g. … Rust futures) the host must spawn the task for it to progress.\"*","locale":"en"},"4896":{"id":"/en/docs/development-concurrency-10","page_id":"/en/docs/development-concurrency","tags":[],"type":"text","url":"/en/docs/development-concurrency#model","content":"Handles (`Context`, `Fiber`, `Svc<S>`) are `Send + Sync`; plugin futures must be `Send`. Users can freely `tokio::spawn` inside plugins (and tie the `JoinHandle` to an effect).","locale":"en"},"4897":{"id":"/en/docs/development-concurrency-11","page_id":"/en/docs/development-concurrency","tags":[],"type":"text","url":"/en/docs/development-concurrency#model","content":"Tests run on a `current_thread` runtime with `tokio::time::pause()` for deterministic interleavings (the analogue of vitest fake timers); production may use the multi-threaded runtime. Testing describes which runtime each test suite uses today.","locale":"en"},"4898":{"id":"/en/docs/development-concurrency-12","page_id":"/en/docs/development-concurrency","tags":[],"type":"text","url":"/en/docs/development-concurrency#model","content":"In `kardia-core` (`root.rs`), the root is the private `RootInner { state: Mutex<State>, changed: Notify, logger: Mutex<LoggerState> }`. A critical section is `RootInner::run(|st: &mut State| …)`: it pushes `Action`s onto `State::actions` instead of returning them. The actions are `Reload(FiberId)` and `Unload(FiberId)` (spawn the transition), `Emit(..)` (deliver an event to listeners), `Log { .. }` (report an error through the logger) and `Drop(..)` (values released under the lock are dropped after it, since their destructors are user code). Instead of per-action `Wake(Notify)`, every critical section wakes all waiters on the root-wide `changed` notifier after unlocking. Disposers are not run as an action: the unload transition runs them itself, outside the lock (see Lifecycle algorithms).","locale":"en"},"4899":{"id":"/en/docs/development-concurrency-13","page_id":"/en/docs/development-concurrency","tags":[],"type":"text","url":"/en/docs/development-concurrency#model","content":"**Alternative considered:** a `!Send` design (`Rc<RefCell<..>>` on a `LocalSet`) mirrors JS most literally and was recommended by one analysis pass for the loader. It is rejected for the core because it would force every plugin and service in the ecosystem to be `!Send`-compatible (no `tokio::spawn`, awkward with most async libraries), while the lock-plus-actions discipline above preserves the same atomicity with comparable complexity. If profiling later shows lock contention on the access hot path, committed views (immutable per episode) can be published through `arc-swap` without changing semantics.","locale":"en"},"4900":{"id":"/en/docs/development-concurrency-14","page_id":"/en/docs/development-concurrency","tags":[],"type":"text","url":"/en/docs/development-concurrency#lock-ordering","content":"`core::State` is the innermost lock. Higher layers (`loader` tree state, `include` IO state) have their own mutexes and may call into core only **after releasing** their own lock or while holding it **only if core never calls back into them under its lock** (which D1 guarantees).","locale":"en"},"4901":{"id":"/en/docs/development-concurrency-15","page_id":"/en/docs/development-concurrency","tags":[],"type":"text","url":"/en/docs/development-concurrency#lock-ordering","content":"Rule of thumb: *take at most one lock at a time*.","locale":"en"},"4902":{"id":"/en/docs/development-contributing","page_id":"/en/docs/development-contributing","type":"page","content":"Contributing","breadcrumbs":["kardia Documentation","Development"],"tags":[],"url":"/en/docs/development-contributing","locale":"en"},"4903":{"id":"/en/docs/development-contributing-0","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing","content":"How to work on kardia: building and testing, the xtask commands, CI, releasing to crates.io and npm, and the documentation site.","locale":"en"},"4904":{"id":"/en/docs/development-contributing-1","page_id":"/en/docs/development-contributing","type":"heading","tags":[],"url":"/en/docs/development-contributing#building","content":"Building and testing","locale":"en"},"4905":{"id":"/en/docs/development-contributing-2","page_id":"/en/docs/development-contributing","type":"heading","tags":[],"url":"/en/docs/development-contributing#js","content":"The npm packages","locale":"en"},"4906":{"id":"/en/docs/development-contributing-3","page_id":"/en/docs/development-contributing","type":"heading","tags":[],"url":"/en/docs/development-contributing#xtask","content":"Repository tasks: `cargo xtask`","locale":"en"},"4907":{"id":"/en/docs/development-contributing-4","page_id":"/en/docs/development-contributing","type":"heading","tags":[],"url":"/en/docs/development-contributing#ci","content":"CI","locale":"en"},"4908":{"id":"/en/docs/development-contributing-5","page_id":"/en/docs/development-contributing","type":"heading","tags":[],"url":"/en/docs/development-contributing#releases","content":"Releases","locale":"en"},"4909":{"id":"/en/docs/development-contributing-6","page_id":"/en/docs/development-contributing","type":"heading","tags":[],"url":"/en/docs/development-contributing#npm-releases","content":"npm releases","locale":"en"},"4910":{"id":"/en/docs/development-contributing-7","page_id":"/en/docs/development-contributing","type":"heading","tags":[],"url":"/en/docs/development-contributing#npm-setup","content":"One-time setup","locale":"en"},"4911":{"id":"/en/docs/development-contributing-8","page_id":"/en/docs/development-contributing","type":"heading","tags":[],"url":"/en/docs/development-contributing#credentials","content":"Secrets, variables and credentials","locale":"en"},"4912":{"id":"/en/docs/development-contributing-9","page_id":"/en/docs/development-contributing","type":"heading","tags":[],"url":"/en/docs/development-contributing#site","content":"Documentation site","locale":"en"},"4913":{"id":"/en/docs/development-contributing-10","page_id":"/en/docs/development-contributing","type":"heading","tags":[],"url":"/en/docs/development-contributing#content","content":"Content","locale":"en"},"4914":{"id":"/en/docs/development-contributing-11","page_id":"/en/docs/development-contributing","type":"heading","tags":[],"url":"/en/docs/development-contributing#deployment","content":"Deployment","locale":"en"},"4915":{"id":"/en/docs/development-contributing-12","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing","content":"kardia is developed at github.com/licyk/kardia. This page covers the Rust workspace, the npm packages under `js/`, their CI and releases, and this documentation site.","locale":"en"},"4916":{"id":"/en/docs/development-contributing-13","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing","content":"The repository's `AGENTS.md` has the code rules. In short: breaking refactors are allowed, with no compatibility layers; validate external data once, at the boundary, and tolerate unknown fields; no complexity for speculative races or edge cases without agreement first; keep main functions on the normal flow, with details in small helpers below; comment only non-obvious constraints; regenerate generated files instead of editing them; test the real implementation with few mocks; follow the repository's existing tools and workflows; extract a function only when it is reused, complex or a nameable concept.","locale":"en"},"4917":{"id":"/en/docs/development-contributing-14","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#building","content":"The WASM guest test builds its fixture as a WebAssembly module, so install the target first: `rustup target add wasm32-unknown-unknown`.","locale":"en"},"4918":{"id":"/en/docs/development-contributing-15","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#building","content":"Some tests build fixture crates with cargo while they run, so the first run takes a little longer.","locale":"en"},"4919":{"id":"/en/docs/development-contributing-16","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#building","content":"The minimum supported Rust version of the crates is 1.85 (`rust-version` in the workspace `Cargo.toml`); CI uses a pinned, newer toolchain (below).","locale":"en"},"4920":{"id":"/en/docs/development-contributing-17","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#building","content":"How the tests are organised, and which runtime each suite uses, is on Testing.","locale":"en"},"4921":{"id":"/en/docs/development-contributing-18","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#js","content":"`js/` is a Bun workspace of the `@kardiajs/*` packages (TypeScript and Tauri), outside the Cargo workspace:","locale":"en"},"4922":{"id":"/en/docs/development-contributing-19","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#js","content":"The packages import each other by name. Type checking and tests resolve those names to the sources (`tsconfig.json` paths, `vitest.config.ts` aliases), so they need no build first; the build resolves them to the built packages.","locale":"en"},"4923":{"id":"/en/docs/development-contributing-20","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#js","content":"Inside a package, modules import each other by absolute path: `import { Fiber } from \"#/fiber\"`. `#/` is a subpath import, mapped in each `package.json` (`\"imports\": { \"#/*\": { \"source\": \"./src/*.ts\", \"types\": \"./lib/*.d.ts\", \"default\": \"./lib/*.js\" } }`). Node, TypeScript and bundlers resolve it per package, so the published `lib/` works as `tsc` emits it; type checking and tests resolve it to the sources through the `source` condition (`customConditions` in `tsconfig.json`, `ssr.resolve.conditions` in `vitest.config.ts`). The `@/` alias of `site/` would not survive into a published package, since `tsc` does not rewrite path aliases.","locale":"en"},"4924":{"id":"/en/docs/development-contributing-21","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#js","content":"The build copies the repository's `LICENSE` and `js/NOTICE` (the MIT notice of Cordis) into each package, since npm only ships files inside a package directory; the copies are gitignored.","locale":"en"},"4925":{"id":"/en/docs/development-contributing-22","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#js","content":"Packages require each other as peers (`\"@kardiajs/core\": \"^0.1\"`), so an app has one copy of the runtime.","locale":"en"},"4926":{"id":"/en/docs/development-contributing-23","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#xtask","content":"The `xtask` crate (`xtask/`, a workspace member that is never published) holds the repository's own tasks; `.cargo/config.toml` makes them `cargo xtask <command>`.","locale":"en"},"4927":{"id":"/en/docs/development-contributing-24","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#xtask","content":"Command","locale":"en"},"4928":{"id":"/en/docs/development-contributing-25","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#xtask","content":"What it does","locale":"en"},"4929":{"id":"/en/docs/development-contributing-26","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#xtask","content":"`cargo xtask arch`","locale":"en"},"4930":{"id":"/en/docs/development-contributing-27","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#xtask","content":"Checks the module structure: every `lib.rs` and `mod.rs` (in `crates/*/src`, `crates/*/tests` and `xtask/src`) only declares modules, re-exports, and holds docs and attributes. Implementation (functions, types, traits, `impl` blocks, constants, statics, `macro_rules!`, inline test modules) lives in a file of its own, re-exported from the entry file. Inline modules that only re-export (such as `kardia::prelude`) and proc-macro entry points, which Rust requires at the crate root, are allowed. It lists each violation with its file, line and kind, and fails if there is any. CI runs it.","locale":"en"},"4931":{"id":"/en/docs/development-contributing-28","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#xtask","content":"`cargo xtask version <patch\\|minor\\|major> [--dry-run]`","locale":"en"},"4932":{"id":"/en/docs/development-contributing-29","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#xtask","content":"Bumps the workspace version (`0.1.3` → `0.1.4` / `0.2.0` / `1.0.0`) in `[workspace.package]`, in the `kardia-*` entries of `[workspace.dependencies]`, and in `Cargo.lock`. When the requirement users write changes (a minor or major bump before 1.0, a major bump after), it also updates the `kardia = \"0.x\"` snippets of the README and these docs. It does not commit.","locale":"en"},"4933":{"id":"/en/docs/development-contributing-30","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#xtask","content":"`cargo xtask tag [--version X.Y.Z \\| --name NAME] [--message TEXT] [--push] [--remote NAME] [--dry-run]`","locale":"en"},"4934":{"id":"/en/docs/development-contributing-31","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#xtask","content":"Creates an annotated tag on `HEAD`: `v<workspace version>` by default. `--version` must equal the workspace version (a `v*` tag releases it), and `--name` creates any other tag. It refuses an uncommitted working tree and a tag that already exists, locally or (with `--push`) on the remote. `--push` pushes the tag (to `origin`, or `--remote`).","locale":"en"},"4935":{"id":"/en/docs/development-contributing-32","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#xtask","content":"`cargo xtask js-version <patch\\|minor\\|major> [--dry-run]`","locale":"en"},"4936":{"id":"/en/docs/development-contributing-33","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#xtask","content":"Bumps the version of the npm packages, which share one version of their own: `version` in each `js/packages/*/package.json`, the `^` ranges they require of each other when the requirement changes, and `js/bun.lock` (`bun install`). It refuses packages at different versions. It does not commit.","locale":"en"},"4937":{"id":"/en/docs/development-contributing-34","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#xtask","content":"`cargo xtask js-tag [same options as tag]`","locale":"en"},"4938":{"id":"/en/docs/development-contributing-35","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#xtask","content":"Like `tag`, for the npm packages: `js-v<version>` by default, which starts the npm release.","locale":"en"},"4939":{"id":"/en/docs/development-contributing-36","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#ci","content":"The repository has five workflows, each for one part of it, so that a change runs only the checks it needs and a release tests a commit once.","locale":"en"},"4940":{"id":"/en/docs/development-contributing-37","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#ci","content":"Workflow","locale":"en"},"4941":{"id":"/en/docs/development-contributing-38","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#ci","content":"Runs on","locale":"en"},"4942":{"id":"/en/docs/development-contributing-39","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#ci","content":"Does","locale":"en"},"4943":{"id":"/en/docs/development-contributing-40","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#ci","content":"`ci.yml` (Rust)","locale":"en"},"4944":{"id":"/en/docs/development-contributing-41","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#ci","content":"pushes to `main` and pull requests, except changes only to `site/`, `js/`, Markdown, `LICENSE`, `NOTICE` and the hosting files; manual runs; called by Release","locale":"en"},"4945":{"id":"/en/docs/development-contributing-42","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#ci","content":"fmt, clippy, `cargo xtask arch`, the test suite","locale":"en"},"4946":{"id":"/en/docs/development-contributing-43","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#ci","content":"`js.yml` (npm packages)","locale":"en"},"4947":{"id":"/en/docs/development-contributing-44","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#ci","content":"pushes to `main` and pull requests that change `js/` or `crates/kardia-bridge/`; manual runs; called by npm release","locale":"en"},"4948":{"id":"/en/docs/development-contributing-45","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#ci","content":"the packages' types, tests and build; the bridge's end-to-end test against the Rust host","locale":"en"},"4949":{"id":"/en/docs/development-contributing-46","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#ci","content":"`site.yml` (docs)","locale":"en"},"4950":{"id":"/en/docs/development-contributing-47","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#ci","content":"pushes to `main` and pull requests that change `site/`; manual runs","locale":"en"},"4951":{"id":"/en/docs/development-contributing-48","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#ci","content":"the site's types, tests and build; outside pull requests, the deploy (below)","locale":"en"},"4952":{"id":"/en/docs/development-contributing-49","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#ci","content":"`release.yml`","locale":"en"},"4953":{"id":"/en/docs/development-contributing-50","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#ci","content":"`v*` tags; manual runs","locale":"en"},"4954":{"id":"/en/docs/development-contributing-51","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#ci","content":"publishes to crates.io (below)","locale":"en"},"4955":{"id":"/en/docs/development-contributing-52","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#ci","content":"`npm-release.yml`","locale":"en"},"4956":{"id":"/en/docs/development-contributing-53","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#ci","content":"`js-v*` tags (which `v*` does not match); manual runs","locale":"en"},"4957":{"id":"/en/docs/development-contributing-54","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#ci","content":"publishes to npm (below)","locale":"en"},"4958":{"id":"/en/docs/development-contributing-55","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#ci","content":"CI's steps:","locale":"en"},"4959":{"id":"/en/docs/development-contributing-56","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#ci","content":"Check out the repository.","locale":"en"},"4960":{"id":"/en/docs/development-contributing-57","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#ci","content":"Install Rust **1.99.1** (`dtolnay/rust-toolchain@1.99.1`) with `rustfmt`, `clippy` and the `wasm32-unknown-unknown` target. The toolchain is pinned because the compile-error snapshots of `kardia-macros` (trybuild tests) depend on the compiler version.","locale":"en"},"4961":{"id":"/en/docs/development-contributing-58","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#ci","content":"Restore the cargo cache (`Swatinem/rust-cache`).","locale":"en"},"4962":{"id":"/en/docs/development-contributing-59","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#ci","content":"`cargo fmt --all --check`","locale":"en"},"4963":{"id":"/en/docs/development-contributing-60","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#ci","content":"`cargo clippy --workspace --all-targets -- -D warnings`","locale":"en"},"4964":{"id":"/en/docs/development-contributing-61","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#ci","content":"`cargo xtask arch`","locale":"en"},"4965":{"id":"/en/docs/development-contributing-62","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#ci","content":"`cargo test --workspace`","locale":"en"},"4966":{"id":"/en/docs/development-contributing-63","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#ci","content":"A newer push cancels an older CI run of the same branch or pull request. Tags never start CI.","locale":"en"},"4967":{"id":"/en/docs/development-contributing-64","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#ci","content":"A change to","locale":"en"},"4968":{"id":"/en/docs/development-contributing-65","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#ci","content":"Runs","locale":"en"},"4969":{"id":"/en/docs/development-contributing-66","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#ci","content":"a docs page (`site/`)","locale":"en"},"4970":{"id":"/en/docs/development-contributing-67","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#ci","content":"`site.yml` only","locale":"en"},"4971":{"id":"/en/docs/development-contributing-68","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#ci","content":"the README, `AGENTS.md`, the licence","locale":"en"},"4972":{"id":"/en/docs/development-contributing-69","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#ci","content":"nothing","locale":"en"},"4973":{"id":"/en/docs/development-contributing-70","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#ci","content":"Rust code, tests, `Cargo.*`, `xtask/`, a workflow other than `site.yml` and the js ones","locale":"en"},"4974":{"id":"/en/docs/development-contributing-71","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#ci","content":"`ci.yml`","locale":"en"},"4975":{"id":"/en/docs/development-contributing-72","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#ci","content":"`js/`","locale":"en"},"4976":{"id":"/en/docs/development-contributing-73","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#ci","content":"`js.yml` only","locale":"en"},"4977":{"id":"/en/docs/development-contributing-74","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#ci","content":"`crates/kardia-bridge/`","locale":"en"},"4978":{"id":"/en/docs/development-contributing-75","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#ci","content":"`ci.yml` and `js.yml`","locale":"en"},"4979":{"id":"/en/docs/development-contributing-76","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#ci","content":"a version bump, then its tag","locale":"en"},"4980":{"id":"/en/docs/development-contributing-77","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#ci","content":"`ci.yml` once; `release.yml` reuses that run","locale":"en"},"4981":{"id":"/en/docs/development-contributing-78","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#ci","content":"an npm version bump, then its `js-v*` tag","locale":"en"},"4982":{"id":"/en/docs/development-contributing-79","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#ci","content":"`js.yml` on the push, and again as the release's checks","locale":"en"},"4983":{"id":"/en/docs/development-contributing-80","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#releases","content":"All crates share one version, `version` under `[workspace.package]` in the root `Cargo.toml` (the `[workspace.dependencies]` entries of the kardia crates carry it too).","locale":"en"},"4984":{"id":"/en/docs/development-contributing-81","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#releases","content":"`cargo xtask version patch` (or `minor`, `major`), then commit and push: `git commit -am \"chore(release): kardia 0.1.1\"`, `git push`. The push runs CI.","locale":"en"},"4985":{"id":"/en/docs/development-contributing-82","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#releases","content":"`cargo xtask tag --push` tags the commit `v0.1.1` and pushes the tag, which starts `.github/workflows/release.yml`.","locale":"en"},"4986":{"id":"/en/docs/development-contributing-83","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#releases","content":"Release checks that the tag names the workspace version. It then finds CI's run of the tagged commit and waits for it if it is still running: a passed run is reused, a failed one stops the release. Only when there is no usable run (a commit CI never ran on, or a run a newer push cancelled) does Release call `ci.yml` itself as its checks. Each released commit is tested once.","locale":"en"},"4987":{"id":"/en/docs/development-contributing-84","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#releases","content":"It publishes every crate whose new version is not on crates.io yet, in dependency order (`cargo publish --workspace`; `xtask` is never published), then creates a GitHub release for the tag, with notes since the previous `v*` tag.","locale":"en"},"4988":{"id":"/en/docs/development-contributing-85","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#releases","content":"The publish step is **resumable**:","locale":"en"},"4989":{"id":"/en/docs/development-contributing-86","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#releases","content":"Before each attempt, it asks the crates.io API which `name@version` pairs already exist and excludes those crates, so a crate is never published twice.","locale":"en"},"4990":{"id":"/en/docs/development-contributing-87","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#releases","content":"crates.io lets an account create only a few new crates at once and then one every ten minutes. When `cargo publish` fails with `429 Too Many Requests`, the workflow waits 610 seconds and tries again, up to eight attempts; any other failure fails the step. A release that adds new crates waits out this limit.","locale":"en"},"4991":{"id":"/en/docs/development-contributing-88","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#releases","content":"The workflow can also be started by hand (`workflow_dispatch`) on a branch to resume a release that stopped part-way.","locale":"en"},"4992":{"id":"/en/docs/development-contributing-89","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#releases","content":"It publishes with the `CARGO_REGISTRY_TOKEN` repository secret.","locale":"en"},"4993":{"id":"/en/docs/development-contributing-90","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#npm-releases","content":"The `@kardiajs/*` packages share one version, apart from the crates' (they start at 0.1.0). The bridge's protocol has a version of its own (`PROTOCOL` on both sides): a client opening a session with another version is refused with an `invalid` error, so a host and a client from different releases fail clearly instead of misbehaving.","locale":"en"},"4994":{"id":"/en/docs/development-contributing-91","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#npm-releases","content":"`cargo xtask js-version patch` (or `minor`, `major`), then commit and push: `git commit -am \"chore(release): @kardiajs 0.1.1\"`, `git push`.","locale":"en"},"4995":{"id":"/en/docs/development-contributing-92","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#npm-releases","content":"`cargo xtask js-tag --push` tags the commit `js-v0.1.1` and pushes the tag, which starts `.github/workflows/npm-release.yml`.","locale":"en"},"4996":{"id":"/en/docs/development-contributing-93","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#npm-releases","content":"The workflow checks that every package is at the tagged version, runs `js.yml` as its checks, builds the packages, and publishes core, timer, bridge, tauri and vue, in that order, skipping a version npm already has (so a manual run resumes a release that stopped part-way). It then creates a GitHub release for the tag, with notes since the previous `js-v*` tag.","locale":"en"},"4997":{"id":"/en/docs/development-contributing-94","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#npm-releases","content":"It publishes with **npm trusted publishing**: the publish job's `id-token: write` permission lets it mint a short-lived OIDC token that npm accepts for packages whose trusted publisher names this repository and workflow. No npm token is stored anywhere, and npm attaches a provenance statement to each version automatically (this needs the repository to stay public).","locale":"en"},"4998":{"id":"/en/docs/development-contributing-95","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#npm-setup","content":"**npmjs.com, organization.** Create the free organization `kardiajs` (the `kardia` package name and the `@kardia` scope belong to others), and add the maintainers' accounts. Enable two-factor authentication on them.","locale":"en"},"4999":{"id":"/en/docs/development-contributing-96","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#npm-setup","content":"**npmjs.com, first publish.** npm configures a trusted publisher in a package's settings, so each package must exist first. From a machine logged in with `npm login`: `cd js && bun install && bun run build`, then `npm publish --access public` in `packages/core`, `timer`, `bridge`, `tauri` and `vue`, in that order. This publishes the first version without provenance; later versions come from CI. A package added later, such as `@kardiajs/vue`, needs this step, and its own trusted publisher, before its first CI release.","locale":"en"},"5000":{"id":"/en/docs/development-contributing-97","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#npm-setup","content":"**GitHub, environment.** In the repository's *Settings → Environments*, create `npm`. Optionally restrict its deployments to `js-v*` tags and add required reviewers: the publish job waits for them.","locale":"en"},"5001":{"id":"/en/docs/development-contributing-98","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#npm-setup","content":"**npmjs.com, trusted publishers.** In each package's *Settings → Trusted publishing*, add a GitHub Actions publisher: organization or user `licyk`, repository `kardia`, workflow `npm-release.yml`, environment `npm`. The fields are case-sensitive and npm checks them only at publish time. A new trusted publisher must publish within two days, or it expires and has to be recreated, so release a version (step 5) right after.","locale":"en"},"5002":{"id":"/en/docs/development-contributing-99","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#npm-setup","content":"**First CI release.** Bump and tag as above. When it has published, set each package's *Publishing access* to \"Require two-factor authentication and disallow tokens\", so only the trusted publisher (and maintainers with 2FA) can publish.","locale":"en"},"5003":{"id":"/en/docs/development-contributing-100","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#credentials","content":"Where","locale":"en"},"5004":{"id":"/en/docs/development-contributing-101","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#credentials","content":"Name","locale":"en"},"5005":{"id":"/en/docs/development-contributing-102","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#credentials","content":"Used by","locale":"en"},"5006":{"id":"/en/docs/development-contributing-103","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#credentials","content":"Notes","locale":"en"},"5007":{"id":"/en/docs/development-contributing-104","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#credentials","content":"GitHub, repository secret","locale":"en"},"5008":{"id":"/en/docs/development-contributing-105","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#credentials","content":"`CARGO_REGISTRY_TOKEN`","locale":"en"},"5009":{"id":"/en/docs/development-contributing-106","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#credentials","content":"`release.yml`","locale":"en"},"5010":{"id":"/en/docs/development-contributing-107","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#credentials","content":"crates.io API token with the publish scopes; existing","locale":"en"},"5011":{"id":"/en/docs/development-contributing-108","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#credentials","content":"GitHub, repository secret","locale":"en"},"5012":{"id":"/en/docs/development-contributing-109","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#credentials","content":"`GITEE_RSA_PRIVATE_KEY`","locale":"en"},"5013":{"id":"/en/docs/development-contributing-110","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#credentials","content":"`site.yml`","locale":"en"},"5014":{"id":"/en/docs/development-contributing-111","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#credentials","content":"deploy key that pushes the site to `gh-pages`; existing","locale":"en"},"5015":{"id":"/en/docs/development-contributing-112","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#credentials","content":"GitHub, environment","locale":"en"},"5016":{"id":"/en/docs/development-contributing-113","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#credentials","content":"`npm`","locale":"en"},"5017":{"id":"/en/docs/development-contributing-114","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#credentials","content":"`npm-release.yml` (publish job)","locale":"en"},"5018":{"id":"/en/docs/development-contributing-115","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#credentials","content":"holds no secret: it names the trusted publisher's environment and carries any protection rules","locale":"en"},"5019":{"id":"/en/docs/development-contributing-116","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#credentials","content":"GitHub, repository variables","locale":"en"},"5020":{"id":"/en/docs/development-contributing-117","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#credentials","content":"none","locale":"en"},"5021":{"id":"/en/docs/development-contributing-118","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#credentials","content":"GitHub, workflow token","locale":"en"},"5022":{"id":"/en/docs/development-contributing-119","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#credentials","content":"`GITHUB_TOKEN`","locale":"en"},"5023":{"id":"/en/docs/development-contributing-120","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#credentials","content":"the release jobs","locale":"en"},"5024":{"id":"/en/docs/development-contributing-121","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#credentials","content":"provided by Actions; the jobs ask for `contents: write` (GitHub release) and `id-token: write` (npm) only where needed","locale":"en"},"5025":{"id":"/en/docs/development-contributing-122","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#credentials","content":"npmjs.com","locale":"en"},"5026":{"id":"/en/docs/development-contributing-123","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#credentials","content":"organization `kardiajs`, a trusted publisher per package, the 2FA-and-no-tokens policy","locale":"en"},"5027":{"id":"/en/docs/development-contributing-124","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#credentials","content":"npm","locale":"en"},"5028":{"id":"/en/docs/development-contributing-125","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#credentials","content":"configured on npmjs.com, not in GitHub","locale":"en"},"5029":{"id":"/en/docs/development-contributing-126","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#credentials","content":"There is no `NPM_TOKEN`. If trusted publishing ever has to be bypassed, a granular npm access token limited to the `@kardiajs` packages, stored as an `npm` environment secret, would be the fallback; the workflow does not use one.","locale":"en"},"5030":{"id":"/en/docs/development-contributing-127","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#site","content":"This site lives in `site/`: Fumadocs on TanStack Start (React), built with Vite and Tailwind CSS, with Bun as the package manager and script runner. It is outside the Cargo workspace, so `cargo` commands are unaffected.","locale":"en"},"5031":{"id":"/en/docs/development-contributing-128","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#site","content":"`bun.lock` is committed; `bun install --frozen-lockfile` installs exactly the locked versions, as the deployment workflow does.","locale":"en"},"5032":{"id":"/en/docs/development-contributing-129","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#content","content":"Pages are MDX files in `site/content/docs/`, with flat slugs grouped by prefix (`guide-*`, `concepts-*`, `reference-*`, `development-*`).","locale":"en"},"5033":{"id":"/en/docs/development-contributing-130","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#content","content":"The site is bilingual. Chinese is the default language: `<slug>.mdx`, served without a prefix. English is `<slug>.en.mdx`, served under `/en/`. Every page exists in both languages, and a test checks it.","locale":"en"},"5034":{"id":"/en/docs/development-contributing-131","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#content","content":"The sidebar order and its section headings come from `meta.json` (Chinese) and `meta.en.json` (English). Both must list the same slugs in the same order; a test checks that too.","locale":"en"},"5035":{"id":"/en/docs/development-contributing-132","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#content","content":"Links between pages use `/docs/<slug>` (the site adds `/en` itself). Besides Fumadocs' defaults, pages can use the `Cards`, `Callout`, `Steps`, `Tabs`, `Accordions` and `Mermaid` components without imports.","locale":"en"},"5036":{"id":"/en/docs/development-contributing-133","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#content","content":"Code, identifiers, configuration examples and the paper's notation stay as they are in both languages.","locale":"en"},"5037":{"id":"/en/docs/development-contributing-134","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#deployment","content":"`.github/workflows/site.yml` checks and deploys the site; Rust's checks do not run for a docs-only change. A pull request that touches `site/` gets the types, tests and build. A push to `main` that touches `site/` also builds the site with `VITE_BASE_PATH=/kardia/` and publishes the output to the `gh-pages` branch (with the `GITEE_RSA_PRIVATE_KEY` deploy key), which GitHub Pages serves at **https\\://licyk.github.io/kardia/**. Deploys run one at a time.","locale":"en"},"5038":{"id":"/en/docs/development-contributing-135","page_id":"/en/docs/development-contributing","tags":[],"type":"text","url":"/en/docs/development-contributing#deployment","content":"The base path is only for GitHub Pages, which serves the site under `/kardia/`; without `VITE_BASE_PATH`, the build serves from `/`.","locale":"en"},"5039":{"id":"/en/docs/development-design","page_id":"/en/docs/development-design","type":"page","content":"API design","breadcrumbs":["kardia Documentation","Development"],"tags":[],"url":"/en/docs/development-design","locale":"en"},"5040":{"id":"/en/docs/development-design-0","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design","content":"The design of kardia's API: services, keys and checked access, caller attribution, effects and interruption, plugins and configuration, the lifecycle state machine, events, the logger and the built-in plugin crates.","locale":"en"},"5041":{"id":"/en/docs/development-design-1","page_id":"/en/docs/development-design","type":"heading","tags":[],"url":"/en/docs/development-design#services","content":"Services, keys and access","locale":"en"},"5042":{"id":"/en/docs/development-design-2","page_id":"/en/docs/development-design","type":"heading","tags":[],"url":"/en/docs/development-design#service-trait","content":"The `Service` trait","locale":"en"},"5043":{"id":"/en/docs/development-design-3","page_id":"/en/docs/development-design","type":"heading","tags":[],"url":"/en/docs/development-design#providing","content":"Providing","locale":"en"},"5044":{"id":"/en/docs/development-design-4","page_id":"/en/docs/development-design","type":"heading","tags":[],"url":"/en/docs/development-design#accessing","content":"Accessing (Algorithm 6)","locale":"en"},"5045":{"id":"/en/docs/development-design-5","page_id":"/en/docs/development-design","type":"heading","tags":[],"url":"/en/docs/development-design#caller-attribution","content":"Caller attribution (D4)","locale":"en"},"5046":{"id":"/en/docs/development-design-6","page_id":"/en/docs/development-design","type":"heading","tags":[],"url":"/en/docs/development-design#mixins","content":"Associated properties and mixins","locale":"en"},"5047":{"id":"/en/docs/development-design-7","page_id":"/en/docs/development-design","type":"heading","tags":[],"url":"/en/docs/development-design#effects","content":"Effects (D5, D6)","locale":"en"},"5048":{"id":"/en/docs/development-design-8","page_id":"/en/docs/development-design","type":"heading","tags":[],"url":"/en/docs/development-design#effects-api","content":"API","locale":"en"},"5049":{"id":"/en/docs/development-design-9","page_id":"/en/docs/development-design","type":"heading","tags":[],"url":"/en/docs/development-design#effects-semantics","content":"Semantics (from `fiber.ts:292-357`)","locale":"en"},"5050":{"id":"/en/docs/development-design-10","page_id":"/en/docs/development-design","type":"heading","tags":[],"url":"/en/docs/development-design#interruption","content":"Interruption and cancellation safety (D6)","locale":"en"},"5051":{"id":"/en/docs/development-design-11","page_id":"/en/docs/development-design","type":"heading","tags":[],"url":"/en/docs/development-design#plugins","content":"Plugins, configuration and the lifecycle","locale":"en"},"5052":{"id":"/en/docs/development-design-12","page_id":"/en/docs/development-design","type":"heading","tags":[],"url":"/en/docs/development-design#plugin-trait","content":"Plugin trait","locale":"en"},"5053":{"id":"/en/docs/development-design-13","page_id":"/en/docs/development-design","type":"heading","tags":[],"url":"/en/docs/development-design#configuration","content":"Configuration (D7)","locale":"en"},"5054":{"id":"/en/docs/development-design-14","page_id":"/en/docs/development-design","type":"heading","tags":[],"url":"/en/docs/development-design#lifecycle","content":"The lifecycle state machine (`lifecycle.rs`)","locale":"en"},"5055":{"id":"/en/docs/development-design-15","page_id":"/en/docs/development-design","type":"heading","tags":[],"url":"/en/docs/development-design#instantiation","content":"Instantiation (O-Insert / O-Retire)","locale":"en"},"5056":{"id":"/en/docs/development-design-16","page_id":"/en/docs/development-design","type":"heading","tags":[],"url":"/en/docs/development-design#replace","content":"Registry replace","locale":"en"},"5057":{"id":"/en/docs/development-design-17","page_id":"/en/docs/development-design","type":"heading","tags":[],"url":"/en/docs/development-design#fiber-handle","content":"`Fiber` handle API","locale":"en"},"5058":{"id":"/en/docs/development-design-18","page_id":"/en/docs/development-design","type":"heading","tags":[],"url":"/en/docs/development-design#events","content":"Events, logger and built-in services","locale":"en"},"5059":{"id":"/en/docs/development-design-19","page_id":"/en/docs/development-design","type":"heading","tags":[],"url":"/en/docs/development-design#typed-events","content":"Typed events","locale":"en"},"5060":{"id":"/en/docs/development-design-20","page_id":"/en/docs/development-design","type":"heading","tags":[],"url":"/en/docs/development-design#logger","content":"Logger","locale":"en"},"5061":{"id":"/en/docs/development-design-21","page_id":"/en/docs/development-design","type":"heading","tags":[],"url":"/en/docs/development-design#built-ins","content":"Built-in plugin crates","locale":"en"},"5062":{"id":"/en/docs/development-design-22","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design","content":"This page covers the public API of `kardia-core` and the built-in plugin crates: services and access (decisions D3, D4), effects (D5, D6), plugins, configuration and the lifecycle (D7), and events, the logger and built-in services. The data structures these operate on are on Core data structures. For a user-oriented introduction, see the guide pages Plugins, Services and Effects.","locale":"en"},"5063":{"id":"/en/docs/development-design-23","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design","content":"The signatures below are the plan's design. Most of them exist in the code under the same names; where a name, a parameter or a return type changed, a note under the sketch gives the current API. The deliberate behavioural departures are listed on Status and deviations.","locale":"en"},"5064":{"id":"/en/docs/development-design-24","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#service-trait","content":"(Associated type defaults are not stable; the implementation will put `Meta` on a separate `trait Intercepted: Service` with a blanket \"no metadata\" default.)","locale":"en"},"5065":{"id":"/en/docs/development-design-25","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#service-trait","content":"In the code there is neither a `Meta` type nor `Mergeable` / `Intercepted`. Interception metadata stays JSON: `trait Service: Any + Send + Sync { const NAME: &'static str; fn merge_intercept(values: Vec<Value>) -> Value { merge_shallow(values) } }`, where the values come outermost first and the default is a right-biased shallow merge of JSON objects. A service reads typed metadata with `ctx.intercept_meta::<T>(key)`. `#[derive(Service)]` (from `kardia-macros`) implements the trait; `#[service(name = \"database\")]` sets the key, which defaults to the hyphenated type name.","locale":"en"},"5066":{"id":"/en/docs/development-design-26","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#providing","content":"Semantics follow `ReflectService.provide` exactly:","locale":"en"},"5067":{"id":"/en/docs/development-design-27","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#providing","content":"a tracked effect;","locale":"en"},"5068":{"id":"/en/docs/development-design-28","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#providing","content":"single source per realm (`AlreadyProvided { key, by }`);","locale":"en"},"5069":{"id":"/en/docs/development-design-29","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#providing","content":"notify immediately only if the providing fiber is `Active`, otherwise on its transition to `Active`;","locale":"en"},"5070":{"id":"/en/docs/development-design-30","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#providing","content":"the inverse removes the binding, notifies the realm, **waits until `dependents` is empty**, then removes the provision.","locale":"en"},"5071":{"id":"/en/docs/development-design-31","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#providing","content":"In-place overwrite (`reflect.set`) is offered as `ctx.replace_value::<S>(..)` and, as in Cordis and the paper, is *not* observed by dependents.","locale":"en"},"5072":{"id":"/en/docs/development-design-32","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#providing","content":"In the code, `provide` and `provide_arc` return `kardia_core::Result<EffectHandle>` (the error is `kardia_core::Error`, which wraps `KardiaError::AlreadyProvided` and the other variants). Further variants: `provide_as` / `provide_arc_as` (any value under an explicit key), `provide_checked` (with an availability predicate) and `provide_serialized_as` (a value with a JSON view for expressions and tooling). `ctx.replace_value` was not implemented: `KardiaError::NotProvided` and `ForeignBinding` are declared for it but no API returns them. Retiring a provider unbinds its live provisions at once (see Retired providers).","locale":"en"},"5073":{"id":"/en/docs/development-design-33","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#accessing","content":"`get` implements `locate`:","locale":"en"},"5074":{"id":"/en/docs/development-design-34","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#accessing","content":"own provisions in the same realm;","locale":"en"},"5075":{"id":"/en/docs/development-design-35","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#accessing","content":"walk fibers upward;","locale":"en"},"5076":{"id":"/en/docs/development-design-36","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#accessing","content":"stop at an isolation boundary;","locale":"en"},"5077":{"id":"/en/docs/development-design-37","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#accessing","content":"the first fiber whose `committed` has the key returns it;","locale":"en"},"5078":{"id":"/en/docs/development-design-38","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#accessing","content":"a fiber that declares the key without a committed impl → `Inactive`;","locale":"en"},"5079":{"id":"/en/docs/development-design-39","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#accessing","content":"reaching the root → root has **unchecked** access to the live store (as in Cordis).","locale":"en"},"5080":{"id":"/en/docs/development-design-40","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#accessing","content":"Reading the committed view (not the store) keeps a dependency readable during the consumer's own teardown (Theorem 70).","locale":"en"},"5081":{"id":"/en/docs/development-design-41","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#accessing","content":"Typed declarations: `Plugin::Inject` can be a tuple of service types (`(Database, Cache)`), implemented with `macro_rules!` over tuples, producing both the runtime `InjectSpec` and a typed accessor `ctx.deps::<P::Inject>() -> Result<(Svc<Database>, Svc<Cache>)>`. This is the first, macro-free step towards the compile-time mediation the paper suggests (§5.1.4, §6.4).","locale":"en"},"5082":{"id":"/en/docs/development-design-42","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#accessing","content":"In the code: `get` and `AccessError` are as sketched. `try_get_live` is `live::<S>()` (and `live_as::<T>(key)`); `get_dyn` is `get_as::<T>(key)` for a typed value under a name, and `view(key)` for the JSON view of a service, which the loader's expressions use. Typed declarations use the `Deps` trait (implemented with `macro_rules!` for tuples of up to eight services): `Inject::of::<(Database, Cache)>()` builds the runtime declaration, and `ctx.deps::<(Database, Cache)>()` returns `(Svc<Database>, Svc<Cache>)`. `Plugin` has no `Inject` associated type; it declares with `fn inject() -> Inject`. The compile-time step is `Injected<D>`, used by `#[plugin]` (see Checked typed access).","locale":"en"},"5083":{"id":"/en/docs/development-design-43","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#caller-attribution","content":"Effects created *on behalf of the caller* use `svc.caller().effect(..)`: they land in the caller's fiber, exactly what Cordis's tracker achieves with `this.ctx`.","locale":"en"},"5084":{"id":"/en/docs/development-design-44","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#caller-attribution","content":"A service resolves *its own* dependencies through the `Context` it stored at construction (its def site), so no shadow contexts are needed.","locale":"en"},"5085":{"id":"/en/docs/development-design-45","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#caller-attribution","content":"Service crates expose caller-aware APIs as **extension traits on `Svc<S>`** (allowed by coherence because the trait is local):","locale":"en"},"5086":{"id":"/en/docs/development-design-46","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#caller-attribution","content":"Interception metadata is resolved at access time per Def. 27 / `resolveIntercept`: `[declared inject meta, outer…, inner]` merged right-biased.","locale":"en"},"5087":{"id":"/en/docs/development-design-47","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#caller-attribution","content":"In the code, `Svc<T>` holds the value `Arc<T>`, the caller `Context`, the `key`, the `impl_id` and the providing fiber, with `caller()`, `key()`, `impl_id()`, `arc()`, `provider()` and `logger()`. `intercept()` is `meta() -> Value` (merged with `S::merge_intercept`) and `intercepts() -> Vec<Value>` (the unmerged list, declared `inject` metadata first). The timer's `TimerExt::timeout` returns `Result<EffectHandle>` and registers `self.caller().effect_sync(\"ctx.timeout()\", …)`. Service-to-service calls follow the def site, unlike TS (see Service-to-service calls).","locale":"en"},"5088":{"id":"/en/docs/development-design-48","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#mixins","content":"Cordis's `foo.bar` associated services and `ctx.mixin` are JS-object conveniences. In Rust: a service named `foo.bar` is just another key; \"extending another plugin's type\" is done with extension traits (compile time) or with a registry service built on `IdTable` (runtime). No accessor/mixin layer is ported.","locale":"en"},"5089":{"id":"/en/docs/development-design-49","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#effects-api","content":"In the code (`effect.rs`, `fiber.rs`):","locale":"en"},"5090":{"id":"/en/docs/development-design-50","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#effects-api","content":"`Disposer` is a struct consumed when it runs (`Disposer::new(FnOnce())`, `fallible(FnOnce() -> Result<()>)`, `future(..)`, `try_future(..)`); its closure runs synchronously when disposal starts and may return a future that finishes the work. Panics are caught and reported as errors.","locale":"en"},"5091":{"id":"/en/docs/development-design-51","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#effects-api","content":"Labels are `impl Into<String>`. `effect_sync` takes `FnOnce(&EffectScope) -> Result<()>`: the body collects its inverses on the scope instead of returning one. `effect` takes `FnOnce(EffectScope) -> Fut` with `Fut: Future<Output = Result<()>>`; the body is spawned. Both return `kardia_core::Result<EffectHandle>`.","locale":"en"},"5092":{"id":"/en/docs/development-design-52","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#effects-api","content":"`on_dispose` returns `Result<EffectHandle>`; `ctx.defer(label, disposer)` registers an arbitrary `Disposer`.","locale":"en"},"5093":{"id":"/en/docs/development-design-53","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#effects-api","content":"`ctx.checkpoint()`, `scope.checkpoint()` and `scope.yield_(d)` are synchronous: `ctx.checkpoint()?`, `scope.yield_(d)?`. `EffectScope` methods take `&self` (the scope is `Clone`), and there is a `defer_fn` shorthand; `adopt` takes `impl Into<EffectHandle>` (a `Fiber` converts).","locale":"en"},"5094":{"id":"/en/docs/development-design-54","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#effects-api","content":"`EffectHandle::dispose()` returns a `Disposal`, a future of `Result<()>` that can also be dropped; `ready()` returns a future of `Result<()>`. The handle also has `label()`, `is_active()` and `meta()`.","locale":"en"},"5095":{"id":"/en/docs/development-design-55","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#effects-semantics","content":"`assert_active`: effects on a removed fiber fail with `KardiaError::InactiveEffect`.","locale":"en"},"5096":{"id":"/en/docs/development-design-56","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#effects-semantics","content":"Inside one effect: disposers run **sequentially in reverse order**.","locale":"en"},"5097":{"id":"/en/docs/development-design-57","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#effects-semantics","content":"Ownership transfer: a nested `EffectHandle` created inside an effect is registered on the fiber; `scope.adopt(h)` moves it under the outer effect (the TS `collect` → `_disposables.delete`).","locale":"en"},"5098":{"id":"/en/docs/development-design-58","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#effects-semantics","content":"A failing effect body disposes what it collected; synchronous errors propagate to the caller, async ones are logged and reported via `ready()`.","locale":"en"},"5099":{"id":"/en/docs/development-design-59","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#effects-semantics","content":"Fiber unload drains the accumulator in reverse insertion order and runs the disposers **concurrently** (`join_all`), logging failures and panics (`catch_unwind`), because Cordis tests require sibling effects to clean up concurrently (`service-dispose.spec.ts`). Ordered teardown is obtained by grouping steps in one effect.","locale":"en"},"5100":{"id":"/en/docs/development-design-60","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#effects-semantics","content":"`EffectHandle` is a non-owning handle: dropping it does **not** dispose. Component lifetime is dynamic and governed by the fiber, which is exactly where the paper distinguishes Cordis from RAII (§7.3: lexical scoping is complementary, for resources local to one effect; inside a disposer, ordinary `Drop` types are fine).","locale":"en"},"5101":{"id":"/en/docs/development-design-61","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#interruption","content":"Rust *can* cancel a future by dropping it, something JS cannot, so a Rust host could offer the paper's *aborting* L-Divert. The plan deliberately does **not** drop in-flight `apply` futures: a future dropped between \"acquire resource\" and \"register its disposer\" would leak exactly what temporal composability promises to recover. Instead:","locale":"en"},"5102":{"id":"/en/docs/development-design-62","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#interruption","content":"the host is **inertial** (paper §4.4): a stale load lands, then unloads;","locale":"en"},"5103":{"id":"/en/docs/development-design-63","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#interruption","content":"explicit boundaries, `scope.yield_(..).await?` and `ctx.checkpoint().await?`, return `Err(Interrupted)` when the fiber's target changed since the load began (the TS `while (runner.epoch === oldEpoch)` check). Returning `Interrupted` from `apply` is not a failure; the fiber unloads what it registered.","locale":"en"},"5104":{"id":"/en/docs/development-design-64","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#interruption","content":"This is the loader's outer-fiber pattern (`yield () => {}` after import) made explicit.","locale":"en"},"5105":{"id":"/en/docs/development-design-65","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#interruption","content":"The boundaries are synchronous in the code (`scope.yield_(..)?`, `ctx.checkpoint()?`). `ctx.checkpoint()` fails once the load has been superseded (the fiber's target no longer equals the target of its episode) or the fiber was retired; `scope.checkpoint()` fails once the effect has been disposed. Async effect bodies are spawned and never dropped half-way; disposal waits for the body to reach its end or a boundary.","locale":"en"},"5106":{"id":"/en/docs/development-design-66","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#plugin-trait","content":"Erased form stored in runtimes: `PluginDef { key: RuntimeKey, name, inject: Arc<InjectSpec>, provide, decode: fn(&Value) -> Result<ErasedConfig, ValidationError>, apply: Arc<dyn Fn(Context, ErasedConfig) -> BoxFuture<'static, Result<(), PluginError>> + Send + Sync> }`. `RuntimeKey` is `TypeId::of::<P>()` for typed plugins and a pointer identity for closure plugins (dynamic modules add their own key kind, see Loader internals).","locale":"en"},"5107":{"id":"/en/docs/development-design-67","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#plugin-trait","content":"In the code (`plugin.rs`, `registry.rs`):","locale":"en"},"5108":{"id":"/en/docs/development-design-68","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#plugin-trait","content":"`Plugin` has `const NAME`, `type Config`, `fn inject() -> Inject` (default: empty), `fn provide() -> Vec<Key>` (default: empty) and `fn apply(ctx: Context, config: Arc<Self::Config>) -> impl Future<Output = Result<()>> + Send`. `Inject` (ordered keys, each with optional interception metadata) replaces `InjectSet` / `InjectSpec`.","locale":"en"},"5109":{"id":"/en/docs/development-design-69","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#plugin-trait","content":"`ctx.plugin::<P>(config)`, `ctx.plugin_value::<P>(value)`, `ctx.plugin_def(&def, value)` and `ctx.inject(inject, f)` return `kardia_core::Result<Fiber>`; the closure of `inject` is `Fn(Context) -> Fut`. `ctx.plugin::<P>(config)` requires `P::Config: Serialize`: the typed config is serialized to a `Value` and decoded like any other configuration, so a `Deserialize`-only config is passed as JSON with `plugin_value`.","locale":"en"},"5110":{"id":"/en/docs/development-design-70","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#plugin-trait","content":"`PluginDef` is a cheap clone of `Arc<{ key, name: Option<String>, inject, provide, tags, decode, apply }>`, built with `PluginDef::of::<P>()`, `PluginDef::new(apply)` or `PluginDef::typed(apply)` and refined with `.name(..)`, `.inject(..)`, `.provides(..)`, `.tag(..)`, `.validate_with(..)`. `RuntimeKey` is `Type(TypeId)` or `Def(u64)` (a counter-assigned identity for closure-based definitions). Dynamic modules reuse `Def`; they add no key kind of their own.","locale":"en"},"5111":{"id":"/en/docs/development-design-71","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#configuration","content":"Configuration arrives as `serde_json::Value` (from files, the loader API, or `plugin_value`) and is decoded **once** per (re)load attempt with `serde_path_to_error`, producing `ValidationError { issues: Vec<Issue { path, message }> }`, the analogue of Standard Schema issues. Unknown fields are tolerated unless the plugin opts into `deny_unknown_fields` (repository rule: tolerate unknown fields).","locale":"en"},"5112":{"id":"/en/docs/development-design-72","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#configuration","content":"`Fiber::update(value)`:","locale":"en"},"5113":{"id":"/en/docs/development-design-73","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#configuration","content":"validate first (a rejected config leaves the running instance untouched);","locale":"en"},"5114":{"id":"/en/docs/development-design-74","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#configuration","content":"emit `ConfigCommitted` (loader write-back) unless `no_save`;","locale":"en"},"5115":{"id":"/en/docs/development-design-75","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#configuration","content":"offer the new config to the plugin's **update hook**;","locale":"en"},"5116":{"id":"/en/docs/development-design-76","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#configuration","content":"if no hook accepts it, `restart()` (`revision += 1` → new target → unload → reload).","locale":"en"},"5117":{"id":"/en/docs/development-design-77","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#configuration","content":"Hook registration is an effect: `ctx.on_config_update::<P>(|new| async { …; Ok(Handled::Yes) })`.","locale":"en"},"5118":{"id":"/en/docs/development-design-78","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#configuration","content":"In the code, `Fiber::update(value)` and `Fiber::update_with(value, no_save)` return `Result<Settle>`: validation errors are returned at once, and the `Settle` future resolves when the update has taken effect (`db.update(json!(..))?.await?`). The update hook is `ctx.on_update::<C>(|new: &C| -> bool)` (returning `true` takes the update over, no restart) or `ctx.on_update_with::<C>(..)` (returning the future that `update` resolves with); `C` is the plugin's decoded configuration type. Before a plugin's own decoding, the configuration passes through the root's config hooks (`ctx.on_config(..)`), which the loader uses to evaluate expressions.","locale":"en"},"5119":{"id":"/en/docs/development-design-79","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#lifecycle","content":"A faithful port of `_checkImpl` / `_refresh` / `_setEpoch` / `_reload` / `_unload` / `_updateState`, split into pure critical sections returning actions:","locale":"en"},"5120":{"id":"/en/docs/development-design-80","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#lifecycle","content":"`begin` sets the state, creates the `inertia` shared future, and, on leaving `Active`, emits notifications for every provision still bound (L-Leave before any inverse).","locale":"en"},"5121":{"id":"/en/docs/development-design-81","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#lifecycle","content":"`finish_reload`: if the target is unchanged → `Active` (or `Failed` if the apply errored; the error is recorded only if still current, so a superseded failure only cleans up); otherwise chain into `unload`.","locale":"en"},"5122":{"id":"/en/docs/development-design-82","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#lifecycle","content":"`finish_unload`: drop self from each committed impl's `dependents` and wake providers whose set became empty; then `Inactive` (→ `Pending`/`Failed`/`Disposed` by `settled_state()`) or chain into `reload` if the target is no longer ⊥.","locale":"en"},"5123":{"id":"/en/docs/development-design-83","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#lifecycle","content":"`wait_until` uses `Notify` with `Notified::enable()` registered *before* releasing the lock (no lost wake-ups).","locale":"en"},"5124":{"id":"/en/docs/development-design-84","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#lifecycle","content":"The code splits the work slightly differently (`lifecycle.rs`). `refresh` computes the target and calls `set_target`, the port of `_setEpoch`, which records it and, unless the fiber has failed or a transition is in flight (`inertia: bool`), calls `begin_reload` (commit ω := resolved, register as dependent, record the episode, queue `Action::Reload`) or `begin_unload` (queue `Action::Unload`) and updates the state; `update_state` emits `StatusChanged` and, on entering or leaving `Active`, notifies the consumers of the fiber's live provisions. The spawned `reload` first yields (to coalesce superseded updates), then reads the plugin and its configuration (`prepare_execute`), resolves the configuration through the config hooks, runs `apply` with `catch_unwind`, and calls `finish_reload`. `unload` waits until no binding of the fiber has dependents, drains the accumulator newest first (`start_drain`), disposes all effects concurrently with `join_all`, logs failures, and calls `finish_unload`. `wait_until` registers `Notified::enable()` on the root-wide notifier before checking the predicate.","locale":"en"},"5125":{"id":"/en/docs/development-design-85","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#instantiation","content":"`ctx.plugin(..)` creates `FiberData` (fresh `FiberId`, child `Scope`), resolves injections, and registers on the **parent** fiber an effect whose body inserts the fiber into its runtime and runs `refresh`, and whose inverse marks it removed, forces the target to ⊥, awaits the transition chain and settles to `Disposed` (TS `fiber.ts:178-206`). Unloading a parent therefore cascades to children through the parent's accumulator; re-enabling creates a *fresh* fiber (paper §4.4, Configuration).","locale":"en"},"5126":{"id":"/en/docs/development-design-86","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#replace","content":"`registry.replace(old, new)` (aliases + `_replace` on each fiber: new runtime, new inject, re-resolve, clear error, `revision += 1`, refresh) is ported as is; it is the primitive behind HMR and is useful on its own (swapping an implementation behind live fibers).","locale":"en"},"5127":{"id":"/en/docs/development-design-87","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#replace","content":"In the code: `ctx.registry().replace(&old_def, &new_def) -> Vec<Fiber>` returns the fibers moved to the new definition, and each moved fiber emits `Replaced`.","locale":"en"},"5128":{"id":"/en/docs/development-design-88","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#fiber-handle","content":"In the code (`fiber.rs`): `context()` returns `&Context`. `settled()` and `restart()` return a `Settle` (a boxed future of `kardia_core::Result<()>`), `dispose()` a `Disposal` (a future of `Result<()>`; disposing the root fiber restarts it, reverting everything registered on it), and `update(config)` / `update_with(config, no_save)` a `Result<Settle>`. There are also `config()`, `inject()`, `error()`, `runtime()`, `def()`, `name()`, `parent()`, `is_removed()`, `is_root()`, `effect_handle()` and `effect_count()`. `ctx.fiber()` returns the fiber of a context.","locale":"en"},"5129":{"id":"/en/docs/development-design-89","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#typed-events","content":"Listeners are stored in an `IdTable` per event `TypeId`; registration is an effect of the listener's fiber.","locale":"en"},"5130":{"id":"/en/docs/development-design-90","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#typed-events","content":"Dispatch snapshots the table and skips removed listeners.","locale":"en"},"5131":{"id":"/en/docs/development-design-91","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#typed-events","content":"Optional realm filtering (`E: Scoped`) reproduces `Context.filter` for `ServiceChanged`.","locale":"en"},"5132":{"id":"/en/docs/development-design-92","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#typed-events","content":"Waterfall-style extension points (`internal/config`, `internal/get`, `internal/update`) are replaced by **explicit hook traits** (config transform hook for the loader, update hook per fiber, commit hook) rather than stringly-typed events.","locale":"en"},"5133":{"id":"/en/docs/development-design-93","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#typed-events","content":"Internal events: `PluginInserted/Removed`, `StatusChanged { fiber, old, new }`, `ServiceChanged { key, realm }`, `ConfigCommitted { fiber, value }`, `Replaced { fiber }`.","locale":"en"},"5134":{"id":"/en/docs/development-design-94","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#typed-events","content":"In the code (`events.rs`): `trait Event: Any + Send + Sync { type Output: Bailable; fn filter(&self, listener: &Context) -> bool { true } }`. `Bailable` (implemented for `()`, `bool`, `Option<T>` and `Result<T, Error>`) says which results stop a `bail` / `serial` dispatch and which count as failures of a `parallel` one. `filter` replaces `E: Scoped`: `ServiceChanged` reaches only listeners whose context resolves the key to the same realm. Listeners are kept in a `Vec` per `TypeId`. `on` returns `Result<EffectHandle>`; there are also `on_prepend`, `on_async`, `once` and `listener_count`. The hooks are `ctx.on_config(..)` (config transform), `ctx.on_update::<C>(..)` (update hook per fiber), and the `ConfigCommitted` event as the commit point. `ConfigCommitted` carries `{ fiber, config }`. `serial` returns `Result<Option<E::Output>>`: a panicking listener stops it with the panic as the error, while `emit` and `bail` log a panicking listener, synchronous or asynchronous, and continue (see Events).","locale":"en"},"5135":{"id":"/en/docs/development-design-95","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#logger","content":"`Logger` is a core service:","locale":"en"},"5136":{"id":"/en/docs/development-design-96","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#logger","content":"`ctx.logger(name)` → `Logger { name, level, fiber }` (name defaults to the calling fiber's runtime name, overridable by interception metadata `{ name, level }`);","locale":"en"},"5137":{"id":"/en/docs/development-design-97","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#logger","content":"`Exporter` trait objects registered via `logger.exporter(e)` **as effects**;","locale":"en"},"5138":{"id":"/en/docs/development-design-98","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#logger","content":"ring buffer of the last 1000 `Message { sn, ts, name, level, args }`.","locale":"en"},"5139":{"id":"/en/docs/development-design-99","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#logger","content":"Format strings use Rust formatting (`format_args!`) instead of printf directives. A `tracing` bridge (a `tracing_subscriber::Layer` feeding exporters) can be added in `kardia-logger-console`; it is not required by core.","locale":"en"},"5140":{"id":"/en/docs/development-design-100","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#logger","content":"In the code (`logger.rs`): `ctx.logger()` takes no name (it is named by `intercept(\"logger\", { name })` or after the fiber's plugin), `ctx.logger_named(name)` names it explicitly, and `svc.logger()` logs on a caller's behalf. Levels are `error`, `warn`, `info` and `debug`, and each takes `impl Display`, so `format_args!(..)` works directly. Exporters are registered with `ctx.add_exporter(Arc<dyn Exporter>)`, an effect of the current fiber; `Exporter::export(&Message)` and an optional per-name `level`. `Message` is `{ sn, ts, name, level, text, fiber }`: the text is already formatted (see Logger). The buffer holds 1000 messages by default (`ctx.log_buffer()`, `ctx.set_log_buffer_size(n)`). No `tracing` bridge has been added.","locale":"en"},"5141":{"id":"/en/docs/development-design-101","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#built-ins","content":"Crate","locale":"en"},"5142":{"id":"/en/docs/development-design-102","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#built-ins","content":"Port of","locale":"en"},"5143":{"id":"/en/docs/development-design-103","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#built-ins","content":"Rust building blocks","locale":"en"},"5144":{"id":"/en/docs/development-design-104","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#built-ins","content":"`kardia-timer`","locale":"en"},"5145":{"id":"/en/docs/development-design-105","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#built-ins","content":"`plugin-timer`","locale":"en"},"5146":{"id":"/en/docs/development-design-106","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#built-ins","content":"`tokio::time::{sleep, interval}`, `JoinHandle::abort` as disposers; `timeout(d) -> Result<(), Disposed>` future; `interval(d) -> impl Stream`; `throttle/debounce` handles","locale":"en"},"5147":{"id":"/en/docs/development-design-107","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#built-ins","content":"`kardia-logger-console`","locale":"en"},"5148":{"id":"/en/docs/development-design-108","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#built-ins","content":"`plugin-logger-console`","locale":"en"},"5149":{"id":"/en/docs/development-design-109","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#built-ins","content":"ANSI colours, label alignment, level map","locale":"en"},"5150":{"id":"/en/docs/development-design-110","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#built-ins","content":"`kardia-fs`","locale":"en"},"5151":{"id":"/en/docs/development-design-111","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#built-ins","content":"`plugin-fs-node`","locale":"en"},"5152":{"id":"/en/docs/development-design-112","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#built-ins","content":"`notify` (watch parent dir for single files), `globset` + ported last-match-wins/ancestor predicate","locale":"en"},"5153":{"id":"/en/docs/development-design-113","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#built-ins","content":"The timer API in the code (`TimerExt` on `Svc<Timer>`): `timeout(delay, callback)` and `interval(delay, callback)` are effects returning `Result<EffectHandle>`; `sleep(delay)` is the future that fails with `Disposed` if the caller is disposed first; `ticks(delay)` returns `Ticks`, whose `tick().await` resolves on the next tick (instead of a `Stream`); `throttle` and `debounce` return `Scheduled<A>` handles. `ctx.timer()` (`TimerContext`) is shorthand for `ctx.get::<Timer>()`.","locale":"en"},"5154":{"id":"/en/docs/development-lifecycle","page_id":"/en/docs/development-lifecycle","type":"page","content":"Core data structures","breadcrumbs":["kardia Documentation","Development"],"tags":[],"url":"/en/docs/development-lifecycle","locale":"en"},"5155":{"id":"/en/docs/development-lifecycle-0","page_id":"/en/docs/development-lifecycle","tags":[],"type":"text","url":"/en/docs/development-lifecycle","content":"Identifiers, scope overlays, bindings, fibers, targets and committed views, IdTable and dependency-cycle detection in kardia-core.","locale":"en"},"5156":{"id":"/en/docs/development-lifecycle-1","page_id":"/en/docs/development-lifecycle","type":"heading","tags":[],"url":"/en/docs/development-lifecycle#identifiers","content":"Identifiers (`key.rs`)","locale":"en"},"5157":{"id":"/en/docs/development-lifecycle-2","page_id":"/en/docs/development-lifecycle","type":"heading","tags":[],"url":"/en/docs/development-lifecycle#scope","content":"Scope overlays (`scope.rs`): derived realization and live re-parenting","locale":"en"},"5158":{"id":"/en/docs/development-lifecycle-3","page_id":"/en/docs/development-lifecycle","type":"heading","tags":[],"url":"/en/docs/development-lifecycle#bindings","content":"Bindings (`store.rs`)","locale":"en"},"5159":{"id":"/en/docs/development-lifecycle-4","page_id":"/en/docs/development-lifecycle","type":"heading","tags":[],"url":"/en/docs/development-lifecycle#fibers","content":"Fibers (`fiber.rs`)","locale":"en"},"5160":{"id":"/en/docs/development-lifecycle-5","page_id":"/en/docs/development-lifecycle","type":"heading","tags":[],"url":"/en/docs/development-lifecycle#id-table","content":"`IdTable<T>`: commutative-by-construction registry","locale":"en"},"5161":{"id":"/en/docs/development-lifecycle-6","page_id":"/en/docs/development-lifecycle","type":"heading","tags":[],"url":"/en/docs/development-lifecycle#cycle-detection","content":"Dependency-cycle detection (D9)","locale":"en"},"5162":{"id":"/en/docs/development-lifecycle-7","page_id":"/en/docs/development-lifecycle","tags":[],"type":"text","url":"/en/docs/development-lifecycle","content":"The core data structures of `kardia-core`: the state the lifecycle runs on. Fibers live in a registry arena addressed by never-reused ids, and every cross reference (parent, dependents, committed view) is an id, never a pointer (decision **D2** of the guiding decisions). The algorithms that move a fiber through its states (refresh, reload, unload, instantiation) are on the API design page under The lifecycle state machine.","locale":"en"},"5163":{"id":"/en/docs/development-lifecycle-8","page_id":"/en/docs/development-lifecycle","tags":[],"type":"text","url":"/en/docs/development-lifecycle","content":"The sketches on this page are the plan's design. The code keeps their meaning but not always their shape; a note under each sketch gives the current names and fields in `crates/kardia-core/src`.","locale":"en"},"5164":{"id":"/en/docs/development-lifecycle-9","page_id":"/en/docs/development-lifecycle","tags":[],"type":"text","url":"/en/docs/development-lifecycle#identifiers","content":"Never-reused ids implement the paper's atomic generative names and make \"replaced by an equal value\" observable (Def. 53).","locale":"en"},"5165":{"id":"/en/docs/development-lifecycle-10","page_id":"/en/docs/development-lifecycle","tags":[],"type":"text","url":"/en/docs/development-lifecycle#identifiers","content":"In the code: `Key`, `RealmId`, `ImplId` and `FiberId` exist as sketched (`FiberId::ROOT` is `0`, `RealmId::new()` creates a fresh realm). `RealmId` prints as `realm#n`; the readable labels `svc#id` / `svc@label` belong to the loader's realms. There is no `EffectId`: effects are `EffectCell`s held in an `IdTable`, whose ids are plain `u64`.","locale":"en"},"5166":{"id":"/en/docs/development-lifecycle-11","page_id":"/en/docs/development-lifecycle","tags":[],"type":"text","url":"/en/docs/development-lifecycle#scope","content":"This replaces JS prototype chains (`Object.create`, `setPrototypeOf`, `swap`). Own vs. inherited is explicit.","locale":"en"},"5167":{"id":"/en/docs/development-lifecycle-12","page_id":"/en/docs/development-lifecycle","tags":[],"type":"text","url":"/en/docs/development-lifecycle#scope","content":"In the code, a `Scope` is one node of a context's derivation chain: `Scope { parent: RwLock<Option<Arc<Scope>>>, kind: ScopeKind }`, with `ScopeKind::{Fiber(FiberId), Isolate(Key, RealmId), Intercept(Key, Value), Overlay(Arc<Overlay>)}`. Every derived context (a fiber's own context, `isolate`, `intercept`, `extend`) adds a node; re-pointing a parent moves everything below it. The loader's mutable per-entry tables are public `Overlay` nodes (`set_isolations`, `set_intercepts`), and the entry marker is an `Overlay::tagged(tag)` found again with `Context::tag()`. Because scope nodes carry their fiber, the fiber chain of an access is read off the derivation chain (see Re-pointable contexts).","locale":"en"},"5168":{"id":"/en/docs/development-lifecycle-13","page_id":"/en/docs/development-lifecycle","tags":[],"type":"text","url":"/en/docs/development-lifecycle#bindings","content":"The `type_id` check refers to paper §6.6.","locale":"en"},"5169":{"id":"/en/docs/development-lifecycle-14","page_id":"/en/docs/development-lifecycle","tags":[],"type":"text","url":"/en/docs/development-lifecycle#bindings","content":"In the code, both structs live in `state.rs`:","locale":"en"},"5170":{"id":"/en/docs/development-lifecycle-15","page_id":"/en/docs/development-lifecycle","tags":[],"type":"text","url":"/en/docs/development-lifecycle#bindings","content":"`Impl` has `key`, `realm`, `provider`, `provider_scope`, `value`, `check: Option<Check>`, `view: Option<View>` (a JSON reading of the value, for expressions and tooling) and `dependents`. It has no `id` (bindings are keyed by `ImplId` in `State::impls`), no `type_id` (a collision surfaces as `AccessError::TypeMismatch` when the value fails to downcast), and no `released` notifier (the unload guard waits on the root-wide notifier). `Check` is `Arc<dyn Fn(&[Value]) -> bool + Send + Sync>`: it receives the consumer's interception metadata for the key and runs under the lock, so it must not call into the runtime.","locale":"en"},"5171":{"id":"/en/docs/development-lifecycle-16","page_id":"/en/docs/development-lifecycle","tags":[],"type":"text","url":"/en/docs/development-lifecycle#bindings","content":"`State` has `fibers`, `runtimes: IndexMap<RuntimeKey, RuntimeData>` (registration order), `aliases: HashMap<RuntimeKey, PluginDef>`, `impls: HashMap<ImplId, Impl>` (every binding that still exists, live or withdrawn but still referenced), `store: HashMap<RealmId, ImplId>` (the live binding of each realm, the paper's Σ), `root_realms`, `listeners` (per event `TypeId`), `config_hooks`, id counters and the queued `actions`. There is no `props` table: accessors and mixins are not ported (see Associated properties).","locale":"en"},"5172":{"id":"/en/docs/development-lifecycle-17","page_id":"/en/docs/development-lifecycle","tags":[],"type":"text","url":"/en/docs/development-lifecycle#fibers","content":"`FiberState` is the paper's θ. A fiber in `Failed` recovers only through `update`, `restart` or `replace`.","locale":"en"},"5173":{"id":"/en/docs/development-lifecycle-18","page_id":"/en/docs/development-lifecycle","tags":[],"type":"text","url":"/en/docs/development-lifecycle#fibers","content":"In the code (`state.rs` and `fiber.rs`), `FiberState` and `Target` are as sketched, except that `Target::Epoch::providers` is a `Vec<ImplId>` (the workspace does not use `smallvec`). `FiberData` differs:","locale":"en"},"5174":{"id":"/en/docs/development-lifecycle-19","page_id":"/en/docs/development-lifecycle","tags":[],"type":"text","url":"/en/docs/development-lifecycle#fibers","content":"No `id` (it is the key of `State::fibers`), `runtime: Option<RuntimeKey>` (the root fiber has none), `inject: Inject`.","locale":"en"},"5175":{"id":"/en/docs/development-lifecycle-20","page_id":"/en/docs/development-lifecycle","tags":[],"type":"text","url":"/en/docs/development-lifecycle#fibers","content":"`config: Value` is the source configuration as given; it is decoded once per load attempt, not stored typed.","locale":"en"},"5176":{"id":"/en/docs/development-lifecycle-21","page_id":"/en/docs/development-lifecycle","tags":[],"type":"text","url":"/en/docs/development-lifecycle#fibers","content":"`episode: Option<Target>`: the target the current episode was loaded for, which the iteration checkpoints compare with.","locale":"en"},"5177":{"id":"/en/docs/development-lifecycle-22","page_id":"/en/docs/development-lifecycle","tags":[],"type":"text","url":"/en/docs/development-lifecycle#fibers","content":"`committed: Option<HashMap<Key, ImplId>>`; there is no `CommittedView` type.","locale":"en"},"5178":{"id":"/en/docs/development-lifecycle-23","page_id":"/en/docs/development-lifecycle","tags":[],"type":"text","url":"/en/docs/development-lifecycle#fibers","content":"`inertia: bool`: a transition is in flight. Waiting (`Fiber::settled()`, the unload guard) uses `RootInner::wait_until` on the root-wide notifier instead of a per-fiber `unload_gate` or `watch` channel.","locale":"en"},"5179":{"id":"/en/docs/development-lifecycle-24","page_id":"/en/docs/development-lifecycle","tags":[],"type":"text","url":"/en/docs/development-lifecycle#fibers","content":"`error: Option<Error>`.","locale":"en"},"5180":{"id":"/en/docs/development-lifecycle-25","page_id":"/en/docs/development-lifecycle","tags":[],"type":"text","url":"/en/docs/development-lifecycle#fibers","content":"`provisions: Vec<ImplId>`, plus `draining` and `withdrawn` (provisions withdrawn during a drain stay visible to the fiber's descendants until the drain is over).","locale":"en"},"5181":{"id":"/en/docs/development-lifecycle-26","page_id":"/en/docs/development-lifecycle","tags":[],"type":"text","url":"/en/docs/development-lifecycle#fibers","content":"`disposables: IdTable<Arc<EffectCell>>`, `update_hooks: IdTable<Arc<UpdateHook>>`, and `retire: Option<Arc<EffectCell>>` (the effect on the parent that instantiated the fiber, O-Insert).","locale":"en"},"5182":{"id":"/en/docs/development-lifecycle-27","page_id":"/en/docs/development-lifecycle","tags":[],"type":"text","url":"/en/docs/development-lifecycle#id-table","content":"The `DisposableList` design (insert returns a fresh id; remove by id; `drain_rev()` returns LIFO order) is exported publicly as `kardia_core::IdTable<T>`. It is what paper §3.4.2 calls a commutative key: service authors should build their registries (routes, listeners, commands) on it.","locale":"en"},"5183":{"id":"/en/docs/development-lifecycle-28","page_id":"/en/docs/development-lifecycle","tags":[],"type":"text","url":"/en/docs/development-lifecycle#cycle-detection","content":"On insertion, compute whether the precedence relation ≺ (`p_n ∩ d_m ≠ ∅`, from declared `provide`/`inject`) closes a cycle among non-disposed fibers in the same realm; if so, log a warning naming the cycle and leave the fiber `Pending` (behaviour otherwise unchanged). It only reads declarations, so it can be computed eagerly (paper §6.5). Declared `provide` is metadata only (as in Cordis); a plugin that provides undeclared keys simply escapes the check.","locale":"en"},"5184":{"id":"/en/docs/development-lifecycle-29","page_id":"/en/docs/development-lifecycle","tags":[],"type":"text","url":"/en/docs/development-lifecycle#cycle-detection","content":"Implemented in `registry.rs` (`warn_cycle`): a depth-first search along \"depends on a declared provider\" edges, logging `dependency cycle: a -> b -> …` at warning level.","locale":"en"},"5185":{"id":"/en/docs/development-loader","page_id":"/en/docs/development-loader","type":"page","content":"Loader, include and dynamic modules","breadcrumbs":["kardia Documentation","Development"],"tags":[],"url":"/en/docs/development-loader","locale":"en"},"5186":{"id":"/en/docs/development-loader-0","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader","content":"Internals of kardia-loader, kardia-include and kardia-hmr: the Rust adaptations of the Cordis loader, the file-backed include and the hot-reload algorithm with its module backends.","locale":"en"},"5187":{"id":"/en/docs/development-loader-1","page_id":"/en/docs/development-loader","type":"heading","tags":[],"url":"/en/docs/development-loader#loader","content":"`kardia-loader`","locale":"en"},"5188":{"id":"/en/docs/development-loader-2","page_id":"/en/docs/development-loader","type":"heading","tags":[],"url":"/en/docs/development-loader#include","content":"`kardia-include`","locale":"en"},"5189":{"id":"/en/docs/development-loader-3","page_id":"/en/docs/development-loader","type":"heading","tags":[],"url":"/en/docs/development-loader#hmr","content":"Dynamic modules and HMR (`kardia-hmr`)","locale":"en"},"5190":{"id":"/en/docs/development-loader-4","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader","content":"How the Cordis loader, include and HMR packages are ported: the data model, the entry state machine, file sync and the module graph. For how to use them, see the guide pages Loader, Hot reload and Guest plugins; for the TypeScript originals, see Loader, Include and group and HMR in the Cordis reference.","locale":"en"},"5191":{"id":"/en/docs/development-loader-5","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#loader","content":"Port of `packages/loader` with these Rust adaptations:","locale":"en"},"5192":{"id":"/en/docs/development-loader-6","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#loader","content":"Topic","locale":"en"},"5193":{"id":"/en/docs/development-loader-7","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#loader","content":"Adaptation","locale":"en"},"5194":{"id":"/en/docs/development-loader-8","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#loader","content":"**Data model**","locale":"en"},"5195":{"id":"/en/docs/development-loader-9","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#loader","content":"`EntryOptions` as a serde struct with `#[serde(flatten)] extra: IndexMap<String, Value>` (tolerate unknown keys); `Option<Option<T>>`/`Value::Null` for \"delete on merge\"; `IsolateLabel::{Private, Shared(String)}`; `Disabled::{Bool, Expr}`.","locale":"en"},"5196":{"id":"/en/docs/development-loader-10","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#loader","content":"**Id-addressed documents instead of object identity**","locale":"en"},"5197":{"id":"/en/docs/development-loader-11","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#loader","content":"TS relies on `entry.options === group.data[i]`; Rust keeps the group's `Vec<EntryOptions>` authoritative and entries hold ids; \"came from the file\" is a provenance flag, not `===`.","locale":"en"},"5198":{"id":"/en/docs/development-loader-12","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#loader","content":"**Entry state machine**","locale":"en"},"5199":{"id":"/en/docs/development-loader-13","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#loader","content":"`update / _patchContext / _reconcile / init / _init / _start` ported 1:1 with the \"re-check after every await\" style (`fn still_current(&self, snap) -> bool`), `_initTask` as `Option<Shared<..>>`.","locale":"en"},"5200":{"id":"/en/docs/development-loader-14","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#loader","content":"**Two fibers per entry with `inject`**","locale":"en"},"5201":{"id":"/en/docs/development-loader-15","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#loader","content":"The outer dependency holder + the inner plugin are kept: the outer `apply` resolves the plugin from the catalog, hits `ctx.checkpoint().await?`, then starts the inner fiber.","locale":"en"},"5202":{"id":"/en/docs/development-loader-16","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#loader","content":"**Catalog**","locale":"en"},"5203":{"id":"/en/docs/development-loader-17","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#loader","content":"Replaces module import: `Catalog::register::<P>()` / `register_alias(\"@cordisjs/plugin-group\", Group)`; a missing name yields `ModuleNotFound` located at the entry's `name`.","locale":"en"},"5204":{"id":"/en/docs/development-loader-18","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#loader","content":"**Managed realms**","locale":"en"},"5205":{"id":"/en/docs/development-loader-19","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#loader","content":"`LocalRealm`/`GlobalRealm` as `RealmId`s with labels; the 7-step `patch-context` algorithm ported faithfully, with the delimiter test computed directly by walking scope parents (`scope.is_within(entry_marker)`) instead of temporary symbols; provider migration without restart; blocked moves tracked in `Impl::realm`. **Fix** the realm-GC early `return` (use `continue`).","locale":"en"},"5206":{"id":"/en/docs/development-loader-20","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#loader","content":"**Self-dispose / self-update write-back**","locale":"en"},"5207":{"id":"/en/docs/development-loader-21","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#loader","content":"Core passes a `DisposeReason { SelfRequested, Parent, Loader }` instead of the TS `_disposing` flag + unregister-before-dispose trick (a deliberate breaking simplification).","locale":"en"},"5208":{"id":"/en/docs/development-loader-22","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#loader","content":"**`loader` await barrier**","locale":"en"},"5209":{"id":"/en/docs/development-loader-23","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#loader","content":"`Loader::settled().await` and an availability check driven by an atomic task counter.","locale":"en"},"5210":{"id":"/en/docs/development-loader-24","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#loader","content":"**Validation**","locale":"en"},"5211":{"id":"/en/docs/development-loader-25","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#loader","content":"`validate_options(&Value, deep) -> Vec<Issue>` at the boundary (deep for API calls, shallow for file input).","locale":"en"},"5212":{"id":"/en/docs/development-loader-26","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#loader","content":"**Expressions** (`!!js`)","locale":"en"},"5213":{"id":"/en/docs/development-loader-27","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#loader","content":"JS `with(ctx) eval` cannot be ported. Decision point (Risks): adopt a side-effect-free expression language (recommended: CEL, or a small custom evaluator) whose identifiers resolve through `ctx.get_dyn(name)` and a serializable service view (`trait ExprValue { fn to_value(&self) -> Value }`), respecting the same evaluation-context table as the TS loader. Until then, `Expr` values are rejected with a clear validation issue.","locale":"en"},"5214":{"id":"/en/docs/development-loader-28","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#loader","content":"Where `kardia-loader` differs from the table:","locale":"en"},"5215":{"id":"/en/docs/development-loader-29","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#loader","content":"**Data model:** `EntryOptions` is a typed view read from options already accepted by `validate_options` (`EntryOptions::read`); the JSON object stays the source of truth, so unknown keys survive write-back without a `flatten` map. `IsolateLabel::{Private, Shared(String)}` and `Disabled::{Bool(bool), Expr(String)}` are as planned.","locale":"en"},"5216":{"id":"/en/docs/development-loader-30","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#loader","content":"**Catalog:** `Catalog::register::<P>()`, `register_def(name, def)` and `alias(alias, name)` (not `register_alias`); `kardia_loader::builtins()` registers `group` and aliases `@cordisjs/plugin-group` to it, and `kardia::catalog()` adds the other built-in plugins under their names and their JavaScript package names.","locale":"en"},"5217":{"id":"/en/docs/development-loader-31","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#loader","content":"**Checkpoint:** synchronous, `ctx.checkpoint()?`.","locale":"en"},"5218":{"id":"/en/docs/development-loader-32","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#loader","content":"**Managed realms:** the delimiter test is `Context::is_within(..)` on contexts whose entry tables are tagged `Overlay` nodes; the realm-GC fix is in (`collect_realms` uses `continue`).","locale":"en"},"5219":{"id":"/en/docs/development-loader-33","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#loader","content":"**Self-dispose:** `DisposeReason` was not introduced. The loader sets a per-entry `disposing` flag around its own `fiber.dispose()` call (`entry.rs`, `dispose_fiber`), the same pattern as the TS `_disposing` flag.","locale":"en"},"5220":{"id":"/en/docs/development-loader-34","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#loader","content":"**Expressions:** implemented as a side-effect-free JavaScript subset (`kardia_loader::expr`) instead of CEL; identifiers resolve through the JSON views of services (`ctx.view(name)`, provided with `provide_serialized_as`), not through an `ExprValue` trait; see Expressions.","locale":"en"},"5221":{"id":"/en/docs/development-loader-35","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#include","content":"**Pure modules**, ported almost verbatim and unit-tested in isolation: `journal` (record, merge, flatten, apply, three-way `reconcile`; file wins), `patch` (insert/override patches, `PatchIndex` ownership, `route_journal`), anonymous id assignment.","locale":"en"},"5222":{"id":"/en/docs/development-loader-36","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#include","content":"**IO loop:** one task driven by `dirty_read/dirty_write` flags + `Notify`; latest-wins tree application; `flush()`.","locale":"en"},"5223":{"id":"/en/docs/development-loader-37","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#include","content":"**Parsing:** a YAML parser with spans and custom tags (`saphyr` family): `!!js` → `Value::Expr`; errors **and** warnings fatal; JSON via `serde_json` plus a spanned pass for locations.","locale":"en"},"5224":{"id":"/en/docs/development-loader-38","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#include","content":"**Atomic writes:** temp file in the same directory, stale-content check before every rename, bounded retry on `PermissionDenied`/`ResourceBusy`, read-only → keep journal in memory.","locale":"en"},"5225":{"id":"/en/docs/development-loader-39","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#include","content":"**Errors:** structured `ConfigFrame { id, file, line, col }` chains instead of rewritten stack strings.","locale":"en"},"5226":{"id":"/en/docs/development-loader-40","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#include","content":"In the code, `serde_json::Value` has no expression variant: `!!js` becomes the object `{ \"__jsExpr\": \"…\" }` (`kardia_loader::EXPR_KEY`). Errors are `ConfigFileError` / `ConfigIssue` values whose locations are `file:line:col`, and the loader prints located frames as text (`at <id> (file:line:col)`) rather than a `ConfigFrame` type; see Errors.","locale":"en"},"5227":{"id":"/en/docs/development-loader-41","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#hmr","content":"Optional, Phase 7. Paper §6.4: *native code exposes no module registry, so introduction and retraction take the form of explicit dynamic linking (dlopen/dlclose) … WebAssembly … released when a native embedder (e.g. Wasmtime) drops it.* The plan separates the **algorithm** (portable) from the **module technology** (a backend):","locale":"en"},"5228":{"id":"/en/docs/development-loader-42","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#hmr","content":"In the code (`graph.rs`): `trait ModuleSource: Send + Sync + 'static { fn load(&self, id: &str) -> Result<ModuleCode>; }`. `ModuleId` is a `String` (an absolute path), `ModuleCode { deps: Vec<ModuleId>, evaluate }` evaluates against its dependencies' exports, and a module exports `Exports::{None, Plugin(PluginDef), Value(Value)}`. `ModuleGraph::new(source)` keeps an ordered table of loaded records (`deps`, `exports`) and the set of host modules.","locale":"en"},"5229":{"id":"/en/docs/development-loader-43","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#hmr","content":"The host owns a `ModuleGraph { records: HashMap<ModuleId, ModuleRecord { deps, kind: Host|Dynamic, instance } > }` replacing Node's caches.","locale":"en"},"5230":{"id":"/en/docs/development-loader-44","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#hmr","content":"The Cordis reconcile algorithm is ported as pure graph code with tests from `reconcile.spec.ts`. This follows the **code**, not the paper's Algorithm 10 (see HMR: paper vs. code).","locale":"en"},"5231":{"id":"/en/docs/development-loader-45","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#hmr","content":"Transactions are serialized, and re-entrancy is rejected via a task-local transaction id.","locale":"en"},"5232":{"id":"/en/docs/development-loader-46","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#hmr","content":"Backends, in order of preference:","locale":"en"},"5233":{"id":"/en/docs/development-loader-47","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#hmr","content":"**WASM components (wasmtime):** old and new instances coexist safely, dropping is sound, natural sandbox (paper §6.3 bridge fibers). Cost: services cross a WIT boundary.","locale":"en"},"5234":{"id":"/en/docs/development-loader-48","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#hmr","content":"**dylibs (`libloading`):** development-time only: same toolchain, each version loaded from a unique copied path, **never unloaded** (unloading Rust dylibs is unsound with TLS destructors and leaked `'static` references), C-ABI entry point.","locale":"en"},"5235":{"id":"/en/docs/development-loader-49","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#hmr","content":"**Out-of-process plugins** (respawn = reload) via the service-broker/RPC pattern of paper §6.2.","locale":"en"},"5236":{"id":"/en/docs/development-loader-50","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#hmr","content":"Statically linked plugins are \"host modules\" by construction; changing them requires a process restart, while live *re*configuration remains fully supported by the loader.","locale":"en"},"5237":{"id":"/en/docs/development-loader-51","page_id":"/en/docs/development-loader","tags":[],"type":"text","url":"/en/docs/development-loader#hmr","content":"All three backends exist: `WasmSource` (core WASM modules, not WIT components), `DylibSource` and `ProcessSource`, sharing one JSON guest ABI, plus `kardia-guest` for writing guests in Rust. Watch mode is `HmrConfig { base, watch }`. The full account of how they differ from this plan is under Dynamic modules.","locale":"en"},"5238":{"id":"/en/docs/development-risks","page_id":"/en/docs/development-risks","type":"page","content":"Risks and worked example","breadcrumbs":["kardia Documentation","Development"],"tags":[],"url":"/en/docs/development-risks","locale":"en"},"5239":{"id":"/en/docs/development-risks-0","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks","content":"The risks and open decisions of the kardia design with their proposed answers, and a worked example of the plugin API.","locale":"en"},"5240":{"id":"/en/docs/development-risks-1","page_id":"/en/docs/development-risks","type":"heading","tags":[],"url":"/en/docs/development-risks#risks","content":"Risks and open decisions","locale":"en"},"5241":{"id":"/en/docs/development-risks-2","page_id":"/en/docs/development-risks","type":"heading","tags":[],"url":"/en/docs/development-risks#worked-example","content":"Worked example","locale":"en"},"5242":{"id":"/en/docs/development-risks-3","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks#risks","content":"Topic","locale":"en"},"5243":{"id":"/en/docs/development-risks-4","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks#risks","content":"Risk / question","locale":"en"},"5244":{"id":"/en/docs/development-risks-5","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks#risks","content":"Proposed answer","locale":"en"},"5245":{"id":"/en/docs/development-risks-6","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks#risks","content":"Threading model","locale":"en"},"5246":{"id":"/en/docs/development-risks-7","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks#risks","content":"`Send` bounds everywhere vs. a literal JS-like `!Send` design","locale":"en"},"5247":{"id":"/en/docs/development-risks-8","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks#risks","content":"`Send + Sync` with the lock-plus-actions rule (Concurrency); revisit only with evidence","locale":"en"},"5248":{"id":"/en/docs/development-risks-9","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks#risks","content":"Reentrancy","locale":"en"},"5249":{"id":"/en/docs/development-risks-10","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks#risks","content":"user code called under the state lock deadlocks (`parking_lot` is not reentrant)","locale":"en"},"5250":{"id":"/en/docs/development-risks-11","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks#risks","content":"enforced by structure: critical sections return `Actions`; availability `check` closures documented as runtime-free","locale":"en"},"5251":{"id":"/en/docs/development-risks-12","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks#risks","content":"Disposal order","locale":"en"},"5252":{"id":"/en/docs/development-risks-13","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks#risks","content":"paper LIFO vs. Cordis concurrent fiber-level disposal","locale":"en"},"5253":{"id":"/en/docs/development-risks-14","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks#risks","content":"follow Cordis (tests depend on it); LIFO within one effect","locale":"en"},"5254":{"id":"/en/docs/development-risks-15","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks#risks","content":"Cancellation","locale":"en"},"5255":{"id":"/en/docs/development-risks-16","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks#risks","content":"dropping `apply` futures would leak half-registered resources","locale":"en"},"5256":{"id":"/en/docs/development-risks-17","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks#risks","content":"inertial host + explicit checkpoints (Interruption)","locale":"en"},"5257":{"id":"/en/docs/development-risks-18","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks#risks","content":"Reference cycles","locale":"en"},"5258":{"id":"/en/docs/development-risks-19","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks#risks","content":"services hold their own `Context` (→ `Root`), `Root` holds services","locale":"en"},"5259":{"id":"/en/docs/development-risks-20","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks#risks","content":"cycles are broken when bindings are withdrawn; `Root::shutdown().await` disposes the root fiber and clears the store","locale":"en"},"5260":{"id":"/en/docs/development-risks-21","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks#risks","content":"Expressions","locale":"en"},"5261":{"id":"/en/docs/development-risks-22","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks#risks","content":"no JS `eval`","locale":"en"},"5262":{"id":"/en/docs/development-risks-23","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks#risks","content":"decide on CEL vs. custom evaluator before Phase 4 finishes; reject expressions until then","locale":"en"},"5263":{"id":"/en/docs/development-risks-24","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks#risks","content":"Dynamic code","locale":"en"},"5264":{"id":"/en/docs/development-risks-25","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks#risks","content":"Rust has no module registry; dylib unloading unsound","locale":"en"},"5265":{"id":"/en/docs/development-risks-26","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks#risks","content":"static catalog first; WASM backend for real hot reload/sandboxing","locale":"en"},"5266":{"id":"/en/docs/development-risks-27","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks#risks","content":"Type-level keys","locale":"en"},"5267":{"id":"/en/docs/development-risks-28","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks#risks","content":"string keys can collide; `TypeId` unstable across dylibs","locale":"en"},"5268":{"id":"/en/docs/development-risks-29","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks#risks","content":"`TypeId` check in-process; string + version tag for dynamic modules (paper §6.6)","locale":"en"},"5269":{"id":"/en/docs/development-risks-30","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks#risks","content":"Error-message parity","locale":"en"},"5270":{"id":"/en/docs/development-risks-31","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks#risks","content":"TS messages/columns (UTF-16)","locale":"en"},"5271":{"id":"/en/docs/development-risks-32","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks#risks","content":"keep message wording where cheap; no UTF-16 parity","locale":"en"},"5272":{"id":"/en/docs/development-risks-33","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks#risks","content":"How these were settled in the code:","locale":"en"},"5273":{"id":"/en/docs/development-risks-34","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks#risks","content":"**Reentrancy:** critical sections queue `Action`s on the state (see Concurrency); values released under the lock are dropped after it.","locale":"en"},"5274":{"id":"/en/docs/development-risks-35","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks#risks","content":"**Reference cycles:** there is no `Root` type or `shutdown()`. Disposing the root fiber, `root.fiber().dispose().await`, restarts it and reverts everything registered on it, which withdraws every binding.","locale":"en"},"5275":{"id":"/en/docs/development-risks-36","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks#risks","content":"**Expressions:** decided as a side-effect-free JavaScript subset (`kardia_loader::expr`), not CEL; see Status and deviations.","locale":"en"},"5276":{"id":"/en/docs/development-risks-37","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks#risks","content":"**Dynamic code:** the static catalog came first; the WASM, dylib and process backends followed (see Dynamic modules).","locale":"en"},"5277":{"id":"/en/docs/development-risks-38","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks#risks","content":"**Type-level keys:** the in-process check is the downcast at access (`AccessError::TypeMismatch`). Guest services cross the module boundary as JSON values with JSON calls (`GuestService`), so no Rust type or `TypeId` crosses it.","locale":"en"},"5278":{"id":"/en/docs/development-risks-39","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks#worked-example","content":"A provider and a consumer, written against the plugin API. The first tab is the example in today's API (it compiles and runs against the workspace once `connect` and its pool, placeholders for a real database client, are supplied); the second is the plan's original sketch of the then-future API.","locale":"en"},"5279":{"id":"/en/docs/development-risks-40","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks#worked-example","content":"What changed between the sketch and the code:","locale":"en"},"5280":{"id":"/en/docs/development-risks-41","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks#worked-example","content":"**Root:** `Context::new()` creates the root context; `root.fiber().dispose()` replaces `root.shutdown()`.","locale":"en"},"5281":{"id":"/en/docs/development-risks-42","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks#worked-example","content":"**Errors:** `Result<()>` (`kardia_core::Result`) replaces `Result<(), PluginError>` and `anyhow::Result`.","locale":"en"},"5282":{"id":"/en/docs/development-risks-43","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks#worked-example","content":"**Declarations:** `fn inject() -> Inject` (here `Inject::of::<(Database,)>()`) replaces `type Inject`, and `fn provide() -> Vec<Key>` replaces the `&'static [&'static str]` slice. `#[derive(Service)]` implements `Service` (the hand-written `impl Service for Database` also works). With the `#[plugin]` macro, a plugin is an `async fn` taking `Injected<(Database,)>`, which turns undeclared access into a compile error (see Plugins).","locale":"en"},"5283":{"id":"/en/docs/development-risks-44","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks#worked-example","content":"**Boundaries:** `ctx.checkpoint()?` and `ctx.on_dispose(..)?` are synchronous and fallible.","locale":"en"},"5284":{"id":"/en/docs/development-risks-45","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks#worked-example","content":"**Configuration:** `ctx.plugin::<P>(config)` requires `P::Config: Serialize` (the value is serialized and decoded like any other configuration), so a `Deserialize`-only config is passed as JSON with `plugin_value`. `db.update(value)?` validates at once and returns the future to await; `update_with(value, no_save)` takes the flag.","locale":"en"},"5285":{"id":"/en/docs/development-risks-46","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks#worked-example","content":"**Settling:** `greeter.settled()` resolves as soon as no transition is in flight, so the example first waits for `db` to settle; the greeter's transitions start once the database is provided.","locale":"en"},"5286":{"id":"/en/docs/development-risks-47","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks#worked-example","content":"**Logger:** `ctx.logger_named(\"greeter\")`, or `ctx.logger()`, which is named after the plugin.","locale":"en"},"5287":{"id":"/en/docs/development-risks-48","page_id":"/en/docs/development-risks","tags":[],"type":"text","url":"/en/docs/development-risks#worked-example","content":"**Dependencies:** `#[derive(Deserialize)]` needs `serde` with the `derive` feature among the crate's own dependencies, even though `kardia::prelude` re-exports the derive.","locale":"en"},"5288":{"id":"/en/docs/development-status","page_id":"/en/docs/development-status","type":"page","content":"Status and deviations","breadcrumbs":["kardia Documentation","Development"],"tags":[],"url":"/en/docs/development-status","locale":"en"},"5289":{"id":"/en/docs/development-status-0","page_id":"/en/docs/development-status","tags":[],"type":"text","url":"/en/docs/development-status","content":"The implementation phases of kardia, their exit criteria, the implementation status, and every place where the implementation departs from the plan or from the TypeScript code.","locale":"en"},"5290":{"id":"/en/docs/development-status-1","page_id":"/en/docs/development-status","type":"heading","tags":[],"url":"/en/docs/development-status#phases","content":"Implementation phases","locale":"en"},"5291":{"id":"/en/docs/development-status-2","page_id":"/en/docs/development-status","type":"heading","tags":[],"url":"/en/docs/development-status#status","content":"Implementation status","locale":"en"},"5292":{"id":"/en/docs/development-status-3","page_id":"/en/docs/development-status","type":"heading","tags":[],"url":"/en/docs/development-status#deviations","content":"Deviations","locale":"en"},"5293":{"id":"/en/docs/development-status-4","page_id":"/en/docs/development-status","type":"h