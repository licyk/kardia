configuration-22","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#entry-fields","content":"Stops the plugin without removing its entry.","locale":"en"},"5707":{"id":"/en/docs/guide-configuration-23","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#entry-fields","content":"`inject`","locale":"en"},"5708":{"id":"/en/docs/guide-configuration-24","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#entry-fields","content":"Extra services the entry depends on: a list of names, or a map of name → interception metadata.","locale":"en"},"5709":{"id":"/en/docs/guide-configuration-25","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#entry-fields","content":"`intercept`","locale":"en"},"5710":{"id":"/en/docs/guide-configuration-26","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#entry-fields","content":"Metadata for the services the plugin uses, keyed by service. For example, `logger: { name: db, level: 3 }`.","locale":"en"},"5711":{"id":"/en/docs/guide-configuration-27","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#entry-fields","content":"`isolate`","locale":"en"},"5712":{"id":"/en/docs/guide-configuration-28","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#entry-fields","content":"Gives services their own scope: `{ db: true }` makes `db` private to the entry, and `{ db: shared }` shares it between every entry using the label `shared`.","locale":"en"},"5713":{"id":"/en/docs/guide-configuration-29","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#entry-fields","content":"Entries are validated when they are read; the rules are few:","locale":"en"},"5714":{"id":"/en/docs/guide-configuration-30","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#entry-fields","content":"**`id`** is a string and must not contain `:` (the loader joins ids across included files with `:`). A missing id is generated when the file is read: eight hexadecimal digits. An anonymous entry that is unchanged on the next read keeps its id, so editing a neighbour does not restart it. Generated ids reach the file with the next write-back.","locale":"en"},"5715":{"id":"/en/docs/guide-configuration-31","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#entry-fields","content":"**`name`** is required. A name that is not a built-in plugin is a guest module path, relative to the config file: `.wasm` or `.wat` for WebAssembly, anything else a dynamic library. See Guest plugins.","locale":"en"},"5716":{"id":"/en/docs/guide-configuration-32","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#entry-fields","content":"**`config`** can be any value; the plugin decodes it. A group's `config` (`group: true`) must be a list of entries.","locale":"en"},"5717":{"id":"/en/docs/guide-configuration-33","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#entry-fields","content":"**`group`** is a boolean.","locale":"en"},"5718":{"id":"/en/docs/guide-configuration-34","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#entry-fields","content":"**`disabled`** is a boolean or an expression. On a group, it does not stop the group itself: it disables the entries inside it.","locale":"en"},"5719":{"id":"/en/docs/guide-configuration-35","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#entry-fields","content":"**`inject`** is a list of service names, or a map from service name to interception metadata (`null` for none).","locale":"en"},"5720":{"id":"/en/docs/guide-configuration-36","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#entry-fields","content":"**`intercept`** is a map from service name to metadata. Changing it applies to the running plugin in place, without a restart.","locale":"en"},"5721":{"id":"/en/docs/guide-configuration-37","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#entry-fields","content":"**`isolate`** is a map from service name to `true` (a scope private to the entry) or a label (a scope shared by every entry with that label).","locale":"en"},"5722":{"id":"/en/docs/guide-configuration-38","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#entry-fields","content":"Any other key is tolerated and kept: the file stays the source of truth, so unknown keys survive the write-back. Loader explains groups, isolation and interception in depth.","locale":"en"},"5723":{"id":"/en/docs/guide-configuration-39","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#expressions","content":"A value tagged `!!js` is an expression, such as `disabled: !!js \"!settings.enabled\"`. In JSON, write it as `{ \"__jsExpr\": \"!settings.enabled\" }`.","locale":"en"},"5724":{"id":"/en/docs/guide-configuration-40","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#expressions","content":"**Syntax:** a side-effect-free subset of JavaScript:","locale":"en"},"5725":{"id":"/en/docs/guide-configuration-41","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#expressions","content":"literals (numbers, strings, `true`, `false`, `null`, `undefined`), array and object literals;","locale":"en"},"5726":{"id":"/en/docs/guide-configuration-42","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#expressions","content":"member access: `a.b`, `a[0]`, `a?.b`, `.length` of strings and arrays;","locale":"en"},"5727":{"id":"/en/docs/guide-configuration-43","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#expressions","content":"unary `!`, `-`, `+`; arithmetic `+ - * / %`;","locale":"en"},"5728":{"id":"/en/docs/guide-configuration-44","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#expressions","content":"comparisons `< <= > >=`, equality `== != === !==`;","locale":"en"},"5729":{"id":"/en/docs/guide-configuration-45","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#expressions","content":"`&&`, `||`, `??` and `?:`.","locale":"en"},"5730":{"id":"/en/docs/guide-configuration-46","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#expressions","content":"Function calls are not supported.","locale":"en"},"5731":{"id":"/en/docs/guide-configuration-47","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#expressions","content":"**Identifiers:** a name reads the JSON value of the service with that name. The entry must declare that service in `inject`. Only services that have a JSON view can be read this way (see Writing plugins).","locale":"en"},"5732":{"id":"/en/docs/guide-configuration-48","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#expressions","content":"Expressions are accepted in these places:","locale":"en"},"5733":{"id":"/en/docs/guide-configuration-49","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#expressions","content":"Where","locale":"en"},"5734":{"id":"/en/docs/guide-configuration-50","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#expressions","content":"Evaluated","locale":"en"},"5735":{"id":"/en/docs/guide-configuration-51","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#expressions","content":"If it fails","locale":"en"},"5736":{"id":"/en/docs/guide-configuration-52","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#expressions","content":"`disabled`","locale":"en"},"5737":{"id":"/en/docs/guide-configuration-53","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#expressions","content":"When the entry starts or changes, in the entry's context (which sees its `inject`); the result's truthiness decides","locale":"en"},"5738":{"id":"/en/docs/guide-configuration-54","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#expressions","content":"The entry is disabled","locale":"en"},"5739":{"id":"/en/docs/guide-configuration-55","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#expressions","content":"Anywhere inside `config`","locale":"en"},"5740":{"id":"/en/docs/guide-configuration-56","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#expressions","content":"On every (re)load of the plugin, in the plugin's context. The file keeps the expression. A group's entry list is not evaluated","locale":"en"},"5741":{"id":"/en/docs/guide-configuration-57","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#expressions","content":"The plugin's load fails","locale":"en"},"5742":{"id":"/en/docs/guide-configuration-58","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#expressions","content":"The values of `intercept`","locale":"en"},"5743":{"id":"/en/docs/guide-configuration-59","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#expressions","content":"When the entry starts or changes","locale":"en"},"5744":{"id":"/en/docs/guide-configuration-60","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#expressions","content":"The entry is disabled","locale":"en"},"5745":{"id":"/en/docs/guide-configuration-61","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#expressions","content":"The metadata values of `inject` (map form)","locale":"en"},"5746":{"id":"/en/docs/guide-configuration-62","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#expressions","content":"In the parent group's context","locale":"en"},"5747":{"id":"/en/docs/guide-configuration-63","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#expressions","content":"The entry is disabled","locale":"en"},"5748":{"id":"/en/docs/guide-configuration-64","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#expressions","content":"`name`, `group`, `isolate`, and `inject` or `intercept` as a whole cannot be expressions. Errors in the file, including failing expressions, are reported with their location (`file:line:col`).","locale":"en"},"5749":{"id":"/en/docs/guide-configuration-65","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#edits-go-both-ways","content":"Edits to the file are applied to the running app. Changes the app makes to its own entries are written back to the file.","locale":"en"},"5750":{"id":"/en/docs/guide-configuration-66","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#edits-go-both-ways","content":"**File → app.** When the file changes, the new entries are reconciled with the running ones by `id`: a changed entry is updated in place, a new one starts, a removed one stops.","locale":"en"},"5751":{"id":"/en/docs/guide-configuration-67","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#edits-go-both-ways","content":"**App → file.** Changes made at runtime, through the loader API or by a plugin updating or disposing itself, are written back to whoever owns them: the file, or a patch in the configuration of the `include` that loaded it (see `include`). Generated ids are written along with them.","locale":"en"},"5752":{"id":"/en/docs/guide-configuration-68","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#edits-go-both-ways","content":"**Conflicts:** when the file and the app both changed, the file wins.","locale":"en"},"5753":{"id":"/en/docs/guide-configuration-69","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#edits-go-both-ways","content":"**Shutting down** (Ctrl-C) does not write to the file.","locale":"en"},"5754":{"id":"/en/docs/guide-configuration-70","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#built-in-plugins","content":"Name","locale":"en"},"5755":{"id":"/en/docs/guide-configuration-71","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#built-in-plugins","content":"What it does","locale":"en"},"5756":{"id":"/en/docs/guide-configuration-72","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#built-in-plugins","content":"Config","locale":"en"},"5757":{"id":"/en/docs/guide-configuration-73","page_id":"/en/docs/guide-configuration","tags":[],"type":"text","url":"/en/docs/guide-configuration#built-in-plugins","content":"`timer`","locale":"en"},"5758":{"id":"/en/docs/guide-configuration-74","page_id":"/en/docs/guide-configu