"8120":{"id":"/en/docs/reference-loader-103","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#entry-update","content":"`loader/patch-context` isolate algorithm (Managed realms)","locale":"en"},"8121":{"id":"/en/docs/reference-loader-104","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#entry-update","content":"`intercept`","locale":"en"},"8122":{"id":"/en/docs/reference-loader-105","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#entry-update","content":"in place","locale":"en"},"8123":{"id":"/en/docs/reference-loader-106","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#entry-update","content":"`_intercept` swapped in place, no reload","locale":"en"},"8124":{"id":"/en/docs/reference-loader-107","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#entry-update","content":"`config`","locale":"en"},"8125":{"id":"/en/docs/reference-loader-108","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#entry-update","content":"handed to component","locale":"en"},"8126":{"id":"/en/docs/reference-loader-109","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#entry-update","content":"`innerFiber.update(config, true)` → `internal/update` veto or restart","locale":"en"},"8127":{"id":"/en/docs/reference-loader-110","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#entry-update","content":"`disabled`","locale":"en"},"8128":{"id":"/en/docs/reference-loader-111","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#entry-update","content":"unload / reload","locale":"en"},"8129":{"id":"/en/docs/reference-loader-112","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#entry-update","content":"`_verdict` → dispose inner fiber / `outerFiber.restart()` or `init()`","locale":"en"},"8130":{"id":"/en/docs/reference-loader-113","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#entry-update","content":"`inject`","locale":"en"},"8131":{"id":"/en/docs/reference-loader-114","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#entry-update","content":"(n/a)","locale":"en"},"8132":{"id":"/en/docs/reference-loader-115","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#entry-update","content":"rebuild (outer fiber's specification changes)","locale":"en"},"8133":{"id":"/en/docs/reference-loader-116","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#init","content":"`config/entry.ts:311-358`. `_initTask ??= _init(disposeTask)` makes concurrent callers join one task. `_init`:","locale":"en"},"8134":{"id":"/en/docs/reference-loader-117","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#init","content":"awaits the pending disposal, then re-checks after **every** await (name unchanged? still registered? not blocked? no fiber created meanwhile?);","locale":"en"},"8135":{"id":"/en/docs/reference-loader-118","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#init","content":"imports the module and patches the context;","locale":"en"},"8136":{"id":"/en/docs/reference-loader-119","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#init","content":"releases `_initTask` *before* creating fibers (their `apply` may trigger another init);","locale":"en"},"8137":{"id":"/en/docs/reference-loader-120","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#init","content":"creates the outer fiber (if `inject`) or starts the plugin directly.","locale":"en"},"8138":{"id":"/en/docs/reference-loader-121","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#init","content":"`rebuild.spec.ts` / `evaluate.spec.ts` cover renames during import, removal during disposal, a plugin renaming its own entry, and so on.","locale":"en"},"8139":{"id":"/en/docs/reference-loader-122","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#entry-tree","content":"`config/tree.ts:71-261` and `config/group.ts`:","locale":"en"},"8140":{"id":"/en/docs/reference-loader-123","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#entry-tree","content":"`EntryTree`: `ctx`, `root: EntryGroup`, `store: Dict<Entry>` by local id; `create/remove/update(id, options, parent?, position?)` (the runtime API, deep-validated before anything is committed; supports moves within and across trees), `resolve(compositeId)`, `getTasks()/await()`, abstract `commit(change)`. `EntryChange { id, group, from?, options?, legacy? }` encodes create / remove / update / move.","locale":"en"},"8141":{"id":"/en/docs/reference-loader-124","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#entry-tree","content":"`EntryGroup.update(config)` is **keyed reconciliation**: the union of old and new ids; for each, in parallel (`Promise.all`), `create()` (adopt/update, forced) or `remove()`. Anonymous entries get a unique key, so each is created with a fresh random id. One bad entry does not stop the others.","locale":"en"},"8142":{"id":"/en/docs/reference-loader-125","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#entry-tree","content":"`Group` (the `@cordisjs/plugin-group` plugin) extends `EntryGroup`, **shares the parent tree's store**, and vetoes restarts with `ctx.on('internal/update', config => this.update(config))`. This is the paper's \"group reconciliation and entry update recurse together down the tree\".","locale":"en"},"8143":{"id":"/en/docs/reference-loader-126","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#entry-tree","content":"The unregister-before-dispose ordering in `remove`/`_reject` is what lets self-dispose detection distinguish loader-driven disposal.","locale":"en"},"8144":{"id":"/en/docs/reference-loader-127","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#module-import","content":"`config/tree.ts:198-246` and `resolve.ts`. Modules are imported through Node's internal ESM loader (via `loader-utils`) with the tree's `baseUrl` as the parent URL, so specifiers resolve relative to the config file. Bare specifiers are resolved via a generated helper module `<scope>/.cordis/resolve.mjs`, so they resolve in the *project's* dependency graph. `ERR_MODULE_NOT_FOUND` for the requested module becomes a `ModuleNotFoundError` located at the entry's `name`; a missing *transitive* dependency stays the plugin's own error.","locale":"en"},"8145":{"id":"/en/docs/reference-loader-128","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#managed-realms","content":"`config/isolate.ts`:","locale":"en"},"8146":{"id":"/en/docs/reference-loader-129","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#managed-realms","content":"`isolate: { svc: true }` → a **LocalRealm** owned by the entry (symbol `svc#<localId>`), which travels with the entry.","locale":"en"},"8147":{"id":"/en/docs/reference-loader-130","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#managed-realms","content":"`isolate: { svc: 'label' }` → a **GlobalRealm** shared by every entry using that label (symbol `svc@label`); garbage-collected on `loader/partial-dispose` once no entry references it.","locale":"en"},"8148":{"id":"/en/docs/reference-loader-131","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#managed-realms","content":"Each entry gets its own isolate table (`Object.create(parent table)`) at `loader/entry-init`.","locale":"en"},"8149":{"id":"/en/docs/reference-loader-132","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#managed-realms","content":"The `loader/patch-context` listener implements Algorithm 7:","locale":"en"},"8150":{"id":"/en/docs/reference-loader-133","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#managed-realms","content":"compute the new table (own keys from `options.isolate`, inheriting the parent group's table);","locale":"en"},"8151":{"id":"/en/docs/reference-loader-134","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#managed-realms","content":"for each name whose realm symbol changes, stamp a fresh **delimiter tag** `entry.ctx[delim(name)]` (it marks \"contexts inside this entry\" and is inherited by descendants) and record `[oldSym, newSym, entryTag, providerTag]` for the provider found in the store;","locale":"en"},"8152":{"id":"/en/docs/reference-loader-135","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#managed-realms","content":"re-parent and swap the table **in place** (identity preserved for descendants);","locale":"en"},"8153":{"id":"/en/docs/reference-loader-136","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#managed-realms","content":"run the rest of the patch (`next()`);","locale":"en"},"8154":{"id":"/en/docs/reference-loader-137","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#managed-realms","content":"**migrate** a binding whose provider is inside the entry (tags equal) to the new symbol if it is free. The provider keeps the same `Impl` (same uid) and **does not restart**. If the target is occupied the move is *blocked*, and `Impl.isolate` keeps tracking where the binding really lives;","locale":"en"},"8155":{"id":"/en/docs/reference-loader-138","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#managed-realms","content":"`reflect.notify(names, filter)` with the filter `ctx.isolate[name] ∈ {old, new} && (entryTag === ctx[delim]) !== (entryTag === providerTag)`: only fibers whose inside/outside relation differs from the provider's are re-checked;","locale":"en"},"8156":{"id":"/en/docs/reference-loader-139","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#managed-realms","content":"drop the delimiter tags the entry does not itself need.","locale":"en"},"8157":{"id":"/en/docs/reference-loader-140","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#managed-realms","content":"**Likely bug (verified in source):** in the realm GC listener (`config/isolate.ts:150-153`) the inner loop uses `return` when an entry still references the realm. That exits the whole listener and skips GC for the remaining names of the same `legacy.isolate`; `continue` (of the outer loop) was almost certainly intended. Effect: a stale global realm may survive until a later partial-dispose.","locale":"en"},"8158":{"id":"/en/docs/reference-loader-141","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#validation","content":"`config/utils.ts:159-209`. `validateOptions(options, sep, deep)` returns `Issue { message, path }[]` and checks:","locale":"en"},"8159":{"id":"/en/docs/reference-loader-142","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#validation","content":"the object shape;","locale":"en"},"8160":{"id":"/en/docs/reference-loader-143","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#validation","content":"`id`: a string without `:`;","locale":"en"},"8161":{"id":"/en/docs/reference-loader-144","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#validation","content":"`name`: a required string;","locale":"en"},"8162":{"id":"/en/docs/reference-loader-145","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#validation","content":"`group`: a boolean;","locale":"en"},"8163":{"id":"/en/docs/reference-loader-146","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#validation","content":"`disabled`: a boolean or an expression;","locale":"en"},"8164":{"id":"/en/docs/reference-loader-147","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#validation","content":"a group's `config`: an array;","locale":"en"},"8165":{"id":"/en/docs/reference-loader-148","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#validation","content":"`inject`: an array of strings or an object;","locale":"en"},"8166":{"id":"/en/docs/reference-loader-149","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#validation","content":"`intercept`/`isolate`: objects (isolate values `true` or a string).","locale":"en"},"8167":{"id":"/en/docs/reference-loader-150","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#validation","content":"Validation is deep for the runtime API and shallow per entry for file input (children are validated when their group creates them). This is the \"validate once at the entry boundary\" discipline.","locale":"en"},"8168":{"id":"/en/docs/reference-loader-151","page_id":"/en/docs/reference-loader","tags":[],"type":"text","url":"/en/docs/reference-loader#concurrency","content":"Single-threaded cooperative JS. All coordination uses promise de-duplication (`_initTask ??=`), latest-wins slots, flags, and the guarantee that synchronous code between `await`s is atomic. `EntryGroup.update` reconciles children concurrently. The loader never awaits fiber activation where it could deadlock (`init` settles fibers in a detached promise). The paper's justification (Theorem 70: entries can be instantiated together; Theorem 80: the order does not matter; see Metatheory) is what makes concurrent module loading safe.","locale":"en"},"8169":{"id":"/en/docs/reference-paper-vs-code","page_id":"/en/docs/reference-paper-vs-code","type":"page","content":"Paper vs. implementation","breadcrumbs":["kardia Documentation","Cordis reference"],"tags":[],"url":"/en/docs/reference-paper-vs-code","locale":"en"},"8170":{"id":"/en/docs/reference-paper-vs-code-0","page_id":"/en/docs/reference-paper-vs-code","tags":[],"type":"text","url":"/en/docs/reference-paper-vs-code","content":"Where the TypeScript Cordis code follows the paper's model and pseudo-code, where it deviates or refines it, the defects found, and what the Rust port follows.","locale":"en"},"8171":{"id":"/en/docs/reference-paper-vs-code-1","page_id":"/en/docs/reference-paper-vs-code","type":"heading","tags":[],"url":"/en/docs/reference-paper-vs-code#correspondences","content":"Faithful correspondences","locale":"en"},"8172":{"id":"/en/docs/reference-paper-vs-code-2","page_id":"/en/docs/reference-paper-vs-code","type":"heading","tags":[],"url":"/en/docs/reference-paper-vs-code#deviations","content":"Deviations and refinements","locale":"en"},"8173":{"id":"/en/docs/reference-paper-vs-code-3","page_id":"/en/docs/reference-paper-vs-code","type":"heading","tags":[],"url":"/en/docs/reference-paper-vs-code#target","content":"Target representation","locale":"en"},"8174":{"id":"/en/docs/reference-paper-vs-code-4","page_id":"/en/docs/reference-paper-vs-code","type":"heading","tags":[],"url":"/en/docs/reference-paper-vs-code#retirement","content":"Retirement and removal","locale":"en"},"8175":{"id":"/en/docs/reference-paper-vs-code-5","page_id":"/en/docs/reference-paper-vs-code","type":"heading","tags":[],"url":"/en/docs/reference-paper-vs-code#guard","content":"Guard implementation","locale":"en"},"8176":{"id":"/en/docs/reference-paper-vs-code-6","page_id":"/en/docs/reference-paper-vs-code","type":"heading","tags":[],"url":"/en/docs/reference-paper-vs-code#accumulator","content":"Accumulator execution order","locale":"en"},"8177":{"id":"/en/docs/reference-paper-vs-code-7","page_id":"/en/docs/reference-paper-vs-code","type":"heading","tags":[],"url":"/en/docs/reference-paper-vs-code#iteration-boundaries","content":"Iteration boundaries","locale":"en"},"8178":{"id":"/en/docs/reference-paper-vs-code-8","page_id":"/en/docs/reference-paper-vs-code","type":"heading","tags":[],"url":"/en/docs/reference-paper-vs-code#notification","content":"Notification","locale":"en"},"8179":{"id":"/en/docs/reference-paper-vs-code-9","page_id":"/en/docs/reference-paper-vs-code","type":"heading","tags":[],"url":"/en/docs/reference-paper-vs-code#availability","content":"Availability predicate","locale":"en"},"8180":{"id":"/en/docs/reference-paper-vs-code-10","page_id":"/en/docs/reference-paper-vs-code","type":"heading","tags":[],"url":"/en/docs/reference-paper-vs-code#access","content":"Access resolution","locale":"en"},"8181":{"id":"/en/docs/reference-paper-vs-code-11","page_id":"/en/docs/reference-paper-vs-code","type":"heading","tags":[],"url":"/en/docs/reference-paper-vs-code#caller-attribution","content":"Caller attribution (not in the paper)","locale":"en"},"8182":{"id":"/en/docs/reference-paper-vs-code-12","page_id":"/en/docs/reference-paper-vs-code","type":"heading","tags":[],"url":"/en/docs/reference-paper-vs-code#loader-specifics","content":"Loader specifics not in the paper","locale":"en"},"8183":{"id":"/en/docs/reference-paper-vs-code-13","page_id":"/en/docs/reference-paper-vs-code","type":"heading","tags":[],"url":"/en/doc