rence-fibers-99","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#fiber-state","content":"`Unloading`","locale":"en"},"8233":{"id":"/en/docs/reference-fibers-100","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#fiber-state","content":"`FAILED`","locale":"en"},"8234":{"id":"/en/docs/reference-fibers-101","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#fiber-state","content":"`Inactive` + error outcome (§4.4 Failure)","locale":"en"},"8235":{"id":"/en/docs/reference-fibers-102","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#fiber-state","content":"`DISPOSED`","locale":"en"},"8236":{"id":"/en/docs/reference-fibers-103","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#fiber-state","content":"removed from the registry (uid `null`)","locale":"en"},"8237":{"id":"/en/docs/reference-fibers-104","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#fiber-state","content":"`_getState()` derives the settled state: `uid === null → DISPOSED`, `_error → FAILED`, `epoch !== INACTIVE → ACTIVE`, else `PENDING`.","locale":"en"},"8238":{"id":"/en/docs/reference-fibers-105","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#instantiation","content":"`fiber.ts:148-206`:","locale":"en"},"8239":{"id":"/en/docs/reference-fibers-106","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#instantiation","content":"A child fiber is therefore exactly Definition 52: an ordinary effect of the parent whose inverse retires it. Unloading a parent cascades to its children through the parent's accumulator. Unlike the calculus, retirement and removal are fused: the inverse retires, waits for the chain to finish, and then the fiber is gone (its uid is already `null`).","locale":"en"},"8240":{"id":"/en/docs/reference-fibers-107","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#target","content":"`fiber.ts:387-429`:","locale":"en"},"8241":{"id":"/en/docs/reference-fibers-108","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#target","content":"The epoch string is the paper's hash of `target(γ, n)`, plus the revision counter (a configuration revision is a new effect function, §4.4 Configuration; see Metatheory).","locale":"en"},"8242":{"id":"/en/docs/reference-fibers-109","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#state-machine","content":"`fiber.ts:431-514`.","locale":"en"},"8243":{"id":"/en/docs/reference-fibers-110","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#set-epoch","content":"Algorithm 5, `refresh`:","locale":"en"},"8244":{"id":"/en/docs/reference-fibers-111","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#set-epoch","content":"A change from one non-⊥ target to another while `ACTIVE` goes through `UNLOADING` and then chains into `LOADING` (unload checks the epoch at its end).","locale":"en"},"8245":{"id":"/en/docs/reference-fibers-112","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#reload","content":"**Inertia:** a stale target does not abort an in-flight `apply`. The load lands and the fiber unloads afterwards (async hosts take the *landing* alternative of L-Divert). The microtask yield before executing lets a burst of `update()` calls skip superseded loads entirely (`update.spec.ts: 'skips superseded loads before executing the plugin'`).","locale":"en"},"8246":{"id":"/en/docs/reference-fibers-113","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#update-state","content":"`fiber.ts:372-385`. It sets the new state, emits `internal/status(fiber, oldState)`, and **only on transitions into or out of `ACTIVE`** notifies the dependents of every provision still bound in the store (`ctx.isolate(name, impl.isolate).reflect.notify([name])`). Entering `UNLOADING` from `ACTIVE` therefore makes all consumers recompute an unsatisfied target *before* any inverse is scheduled (L-Leave), while the bindings are still physically present.","locale":"en"},"8247":{"id":"/en/docs/reference-fibers-114","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#guards","content":"**Fiber-level** (the `_unload` loop): a provider fiber does not run *any* disposer until no provision has dependents.","locale":"en"},"8248":{"id":"/en/docs/reference-fibers-115","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#guards","content":"**Binding-level** (`provide`'s inverse, see `provide`): withdrawing one binding waits for that binding's dependents only. This lets one provider withdraw binding A without waiting for consumers of binding B (`service-dispose.spec.ts: 'withdraws one binding without waiting for another binding from the same provider'`), and lets a binding be replaced during a consumer's initialization.","locale":"en"},"8249":{"id":"/en/docs/reference-fibers-116","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#guards","content":"Dependents are tracked as `Impl.dependents: Set<Fiber>` (populated at commit, cleared at the end of the dependent's unload), the runtime form of `relied_n`.","locale":"en"},"8250":{"id":"/en/docs/reference-fibers-117","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#await-update-restart","content":"`fiber.ts:516-552`.","locale":"en"},"8251":{"id":"/en/docs/reference-fibers-118","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#await-update-restart","content":"`await()` loops on `inertia` until settled, and throws `_error` if the fiber is `FAILED`.","locale":"en"},"8252":{"id":"/en/docs/reference-fibers-119","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#await-update-restart","content":"`restart()` (on `ctx.fiber`): `_revision++`, `_refresh()`, await. For the root fiber, `dispose()` *is* `restart()`: everything is unloaded and the root becomes active again.","locale":"en"},"8253":{"id":"/en/docs/reference-fibers-120","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#await-update-restart","content":"`update(config, noSave = false)` is the configuration revision path:","locale":"en"},"8254":{"id":"/en/docs/reference-fibers-121","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#await-update-restart","content":"resolve and validate the new config if loaded (the `internal/config` waterfall → Standard Schema `validate`, sync only; `ValidationError` keeps issue paths);","locale":"en"},"8255":{"id":"/en/docs/reference-fibers-122","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#await-update-restart","content":"`emit('internal/commit', fiber, config)` unless `noSave` (the loader writes the config back to its entry);","locale":"en"},"8256":{"id":"/en/docs/reference-fibers-123","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#await-update-restart","content":"store the config and clear `_error`;","locale":"en"},"8257":{"id":"/en/docs/reference-fibers-124","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#await-update-restart","content":"if loaded, `waterfall(fiber, 'internal/update', resolved, restart)`: per-fiber `internal/update` listeners (registered by the plugin via `ctx.on('internal/update', …)`) may accept the new config **without restarting** by not calling `next()`; otherwise `restart()`.","locale":"en"},"8258":{"id":"/en/docs/reference-fibers-125","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#await-update-restart","content":"The returned promise is marked handled, so dropped results do not cause unhandled rejections.","locale":"en"},"8259":{"id":"/en/docs/reference-fibers-126","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#await-update-restart","content":"Concurrency semantics verified by `tests/update.spec.ts`:","locale":"en"},"8260":{"id":"/en/docs/reference-fibers-127","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#await-update-restart","content":"concurrent updates settle on the latest config;","locale":"en"},"8261":{"id":"/en/docs/reference-fibers-128","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#await-update-restart","content":"updates during unloading coalesce;","locale":"en"},"8262":{"id":"/en/docs/reference-fibers-129","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#await-update-restart","content":"a superseded failure is cleaned up without failing the latest update;","locale":"en"},"8263":{"id":"/en/docs/reference-fibers-130","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#await-update-restart","content":"all waiting updates reject when the latest load fails;","locale":"en"},"8264":{"id":"/en/docs/reference-fibers-131","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#await-update-restart","content":"an outdated async generator stops advancing;","locale":"en"},"8265":{"id":"/en/docs/reference-fibers-132","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#await-update-restart","content":"a queued config is not loaded after disposal.","locale":"en"},"8266":{"id":"/en/docs/reference-fibers-133","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#failure","content":"From `tests/fiber.spec.ts`:","locale":"en"},"8267":{"id":"/en/docs/reference-fibers-134","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#failure","content":"A throwing `apply` → the error is logged, `_error` is set, the epoch becomes ⊥, partial effects are unwound via `_unload`, and the state is `FAILED`.","locale":"en"},"8268":{"id":"/en/docs/reference-fibers-135","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#failure","content":"A failed fiber **does not re-enter** on a dependency refresh (`_setEpoch` returns early). This matches §4.4: \"not retried against an unchanged environment\".","locale":"en"},"8269":{"id":"/en/docs/reference-fibers-136","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#failure","content":"`update()` (or `registry.replace`) clears the error and retries.","locale":"en"},"8270":{"id":"/en/docs/reference-fibers-137","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#failure","content":"Disposing a `PENDING` or `FAILED` fiber settles it to `DISPOSED`.","locale":"en"},"8271":{"id":"/en/docs/reference-fibers-138","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#nine-rules","content":"The rules are defined on Calculus.","locale":"en"},"8272":{"id":"/en/docs/reference-fibers-139","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#nine-rules","content":"Rule","locale":"en"},"8273":{"id":"/en/docs/reference-fibers-140","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#nine-rules","content":"Code","locale":"en"},"8274":{"id":"/en/docs/reference-fibers-141","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#nine-rules","content":"O-Insert","locale":"en"},"8275":{"id":"/en/docs/reference-fibers-142","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#nine-rules","content":"`parent.fiber.effect(() => { runtime.fibers.push(this); this._refresh() … })`","locale":"en"},"8276":{"id":"/en/docs/reference-fibers-143","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#nine-rules","content":"O-Retire","locale":"en"},"8277":{"id":"/en/docs/reference-fibers-144","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#nine-rules","content":"inverse of that effect: `uid = null; _setEpoch(INACTIVE)`","locale":"en"},"8278":{"id":"/en/docs/reference-fibers-145","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#nine-rules","content":"O-Remove","locale":"en"},"8279":{"id":"/en/docs/reference-fibers-146","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#nine-rules","content":"`_remove()`, runtime unregistered, state `DISPOSED` after the chain ends","locale":"en"},"8280":{"id":"/en/docs/reference-fibers-147","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#nine-rules","content":"L-Begin","locale":"en"},"8281":{"id":"/en/docs/reference-fibers-148","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#nine-rules","content":"`_setEpoch` → `_reload()` with state `LOADING`","locale":"en"},"8282":{"id":"/en/docs/reference-fibers-149","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#nine-rules","content":"L-Iter","locale":"en"},"8283":{"id":"/en/docs/reference-fibers-150","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":