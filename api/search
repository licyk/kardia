cs/guide-effects#update","content":"Update, restart and dispose","locale":"en"},"5878":{"id":"/en/docs/guide-effects-11","page_id":"/en/docs/guide-effects","type":"heading","tags":[],"url":"/en/docs/guide-effects#replace","content":"Replacing an implementation","locale":"en"},"5879":{"id":"/en/docs/guide-effects-12","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects","content":"Everything a plugin sets up (listeners, timers, services, child plugins) is an **effect**: a setup paired with its **inverse**, the disposer that reverts it. Effects are registered on the plugin's **fiber**, and when the fiber unloads, every inverse runs. This is what lets you reconfigure, replace or stop any plugin while the app runs without leaking what it acquired.","locale":"en"},"5880":{"id":"/en/docs/guide-effects-13","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects","content":"This page shows how to register effects, how they are disposed and what a fiber's handle can do. For the theory see Revertible effects; for the design decisions (non-owning handles, inertial loads instead of dropped futures) see API design; for the state machine underneath see Core data structures.","locale":"en"},"5881":{"id":"/en/docs/guide-effects-14","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#inverses","content":"The simplest effect is a plain inverse for something you just did:","locale":"en"},"5882":{"id":"/en/docs/guide-effects-15","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#inverses","content":"Method","locale":"en"},"5883":{"id":"/en/docs/guide-effects-16","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#inverses","content":"Registers on the current fiber","locale":"en"},"5884":{"id":"/en/docs/guide-effects-17","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#inverses","content":"`ctx.on_dispose(f)`","locale":"en"},"5885":{"id":"/en/docs/guide-effects-18","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#inverses","content":"a synchronous inverse `f: FnOnce()`","locale":"en"},"5886":{"id":"/en/docs/guide-effects-19","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#inverses","content":"`ctx.defer(label, disposer)`","locale":"en"},"5887":{"id":"/en/docs/guide-effects-20","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#inverses","content":"an arbitrary `Disposer`, under a label shown in introspection","locale":"en"},"5888":{"id":"/en/docs/guide-effects-21","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#inverses","content":"Both return `Result<EffectHandle>`. They fail with `KardiaError::InactiveEffect` (`cannot create effect on inactive context`) on a fiber that has been retired, with one exception: a retired fiber whose own load is still in flight may still collect inverses, which the unload that follows reverts, so that nothing the load acquired leaks.","locale":"en"},"5889":{"id":"/en/docs/guide-effects-22","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#inverses","content":"A `Disposer` is the inverse of an effect. It is consumed when it runs, so it runs at most once:","locale":"en"},"5890":{"id":"/en/docs/guide-effects-23","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#inverses","content":"Constructor","locale":"en"},"5891":{"id":"/en/docs/guide-effects-24","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#inverses","content":"Inverse","locale":"en"},"5892":{"id":"/en/docs/guide-effects-25","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#inverses","content":"`Disposer::new(f)`","locale":"en"},"5893":{"id":"/en/docs/guide-effects-26","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#inverses","content":"a synchronous `FnOnce()`","locale":"en"},"5894":{"id":"/en/docs/guide-effects-27","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#inverses","content":"`Disposer::fallible(f)`","locale":"en"},"5895":{"id":"/en/docs/guide-effects-28","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#inverses","content":"a synchronous `FnOnce() -> Result<()>`","locale":"en"},"5896":{"id":"/en/docs/guide-effects-29","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#inverses","content":"`Disposer::future(f)`","locale":"en"},"5897":{"id":"/en/docs/guide-effects-30","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#inverses","content":"`f` runs synchronously when disposal starts and returns a future that finishes the work","locale":"en"},"5898":{"id":"/en/docs/guide-effects-31","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#inverses","content":"`Disposer::try_future(f)`","locale":"en"},"5899":{"id":"/en/docs/guide-effects-32","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#inverses","content":"the same, with a fallible future","locale":"en"},"5900":{"id":"/en/docs/guide-effects-33","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#inverses","content":"Panics in a disposer, synchronous or asynchronous, are caught and reported as errors.","locale":"en"},"5901":{"id":"/en/docs/guide-effects-34","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#effects","content":"When the setup itself can fail, or registers several inverses, write it as an effect body. The body gets an `EffectScope` to collect inverses into.","locale":"en"},"5902":{"id":"/en/docs/guide-effects-35","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#effects","content":"**Synchronous:** `ctx.effect_sync(label, |scope| { … })` runs the body at once. If the body fails (or panics), whatever it collected is disposed and the error is returned.","locale":"en"},"5903":{"id":"/en/docs/guide-effects-36","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#effects","content":"**Asynchronous:** `ctx.effect(label, |scope| async move { … })` spawns the body. It is never dropped half-way: disposal waits for it to reach its end or an iteration boundary. A failure disposes what the body collected, is logged, and is reported by `EffectHandle::ready()`. Returning `Interrupted` (see below) is not a failure.","locale":"en"},"5904":{"id":"/en/docs/guide-effects-37","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#scope","content":"Method","locale":"en"},"5905":{"id":"/en/docs/guide-effects-38","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#scope","content":"Does","locale":"en"},"5906":{"id":"/en/docs/guide-effects-39","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#scope","content":"`scope.defer(disposer)`","locale":"en"},"5907":{"id":"/en/docs/guide-effects-40","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#scope","content":"collects an inverse, without an iteration boundary","locale":"en"},"5908":{"id":"/en/docs/guide-effects-41","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#scope","content":"`scope.defer_fn(f)`","locale":"en"},"5909":{"id":"/en/docs/guide-effects-42","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#scope","content":"shorthand for deferring a synchronous inverse","locale":"en"},"5910":{"id":"/en/docs/guide-effects-43","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#scope","content":"`scope.adopt(handle)`","locale":"en"},"5911":{"id":"/en/docs/guide-effects-44","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#scope","content":"moves a nested effect under this one: it is no longer disposed by its fiber directly, but together with this effect (ownership transfer)","locale":"en"},"5912":{"id":"/en/docs/guide-effects-45","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#scope","content":"`scope.checkpoint()`","locale":"en"},"5913":{"id":"/en/docs/guide-effects-46","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#scope","content":"an iteration boundary: `Err(Interrupted)` once the effect has been disposed","locale":"en"},"5914":{"id":"/en/docs/guide-effects-47","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#scope","content":"`scope.yield_(disposer)`","locale":"en"},"5915":{"id":"/en/docs/guide-effects-48","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#scope","content":"collects an inverse and marks an iteration boundary","locale":"en"},"5916":{"id":"/en/docs/guide-effects-49","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#scope","content":"`checkpoint` and `yield_` are synchronous and return `Result<(), Interrupted>`, so you propagate them with `?`.","locale":"en"},"5917":{"id":"/en/docs/guide-effects-50","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#scope","content":"A nested effect, created inside a body with `ctx.effect(..)` or `ctx.effect_sync(..)`, is registered on the fiber like any other. `scope.adopt(handle)` takes it over, so that it is reverted when (and only when) the outer effect is. Any `Fiber` converts into the `EffectHandle` that created it, so a scope can adopt a child plugin too: `scope.adopt(&ctx.plugin::<Child>(())?)`.","locale":"en"},"5918":{"id":"/en/docs/guide-effects-51","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#interruption","content":"A load that has been superseded (the plugin was reconfigured, a dependency changed, or it was disposed) is not cancelled by dropping its future: a future dropped between \"acquire a resource\" and \"register its inverse\" would leak exactly what effects promise to recover. Instead the host is **inertial**: a stale load runs to its end and is then unloaded. To stop earlier, a load checks at explicit **iteration boundaries**:","locale":"en"},"5919":{"id":"/en/docs/guide-effects-52","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#interruption","content":"Boundary","locale":"en"},"5920":{"id":"/en/docs/guide-effects-53","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#interruption","content":"Fails with `Interrupted`","locale":"en"},"5921":{"id":"/en/docs/guide-effects-54","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#interruption","content":"`ctx.checkpoint()`","locale":"en"},"5922":{"id":"/en/docs/guide-effects-55","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#interruption","content":"in a plugin's `apply`, once its load has been superseded or the fiber retired (the paper's L-Divert)","locale":"en"},"5923":{"id":"/en/docs/guide-effects-56","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#interruption","content":"`scope.checkpoint()` / `scope.yield_(d)`","locale":"en"},"5924":{"id":"/en/docs/guide-effects-57","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#interruption","content":"in an effect body, once the effect has been disposed","locale":"en"},"5925":{"id":"/en/docs/guide-effects-58","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#interruption","content":"Propagating `Interrupted` with `?` is not a failure: the fiber (or effect) does not become `Failed`, and what was registered so far is disposed normally. `Error::is_interrupted()` tells it apart from real errors. The loader uses this pattern for entries with `inject`: the outer fiber resolves the plugin, hits `ctx.checkpoint()?`, then starts the inner one. The reasoning is on API design.","locale":"en"},"5926":{"id":"/en/docs/guide-effects-59","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#handle","content":"Every effect registration returns an `EffectHandle`:","locale":"en"},"5927":{"id":"/en/docs/guide-effects-60","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#handle","content":"Method","locale":"en"},"5928":{"id":"/en/docs/guide-effects-61","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#handle","content":"Returns","locale":"en"},"5929":{"id":"/en/docs/guide-effects-62","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#handle","content":"`handle.label()`","locale":"en"},"5930":{"id":"/en/docs/guide-effects-63","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#handle","content":"the effect's label","locale":"en"},"5931":{"id":"/en/docs/guide-effects-64","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#handle","content":"`handle.is_active()`","locale":"en"},"5932":{"id":"/en/docs/guide-effects-65","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#handle","content":"whether it has not been disposed yet","locale":"en"},"5933":{"id":"/en/docs/guide-effects-66","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#handle","content":"`handle.dispose()`","locale":"en"},"5934":{"id":"/en/docs/guide-effects-67","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#handle","content":"reverts the effect (at most once) and returns a `Disposal`","locale":"en"},"5935":{"id":"/en/docs/guide-effects-68","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#handle","content":"`handle.ready()`","locale":"en"},"5936":{"id":"/en/docs/guide-effects-69","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#handle","content":"a future that resolves when the setup has finished (immediately for synchronous effects), with the setup's failure if it failed","locale":"en"},"5937":{"id":"/en/docs/guide-effects-70","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#handle","content":"`handle.meta()`","locale":"en"},"5938":{"id":"/en/docs/guide-effects-71","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#handle","content":"an `EffectMeta { label, children }`, for introspection","locale":"en"},"5939":{"id":"/en/docs/guide-effects-72","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#handle","content":"An `EffectHandle` is **non-owning**: dropping it does not dispose the effect. The effect's lifetime is governed by the fiber it was registered on, which is where the paper distinguishes Cordis from RAII. Lexical scoping is complementary, for resources local to one effect: inside a disposer, ordinary `Drop` types are fine.","locale":"en"},"5940":{"id":"/en/docs/guide-effects-73","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#handle","content":"A `Disposal` is the completion of a disposal. It makes progress without being polled: the synchronous part has already run when `dispose()` returns, and any asynchronous rest runs as a spawned task, so dropping a `Disposal` does not cancel it. Await it to observe the result; `disposal.is_ready()` tells whether everything finished synchronously. Disposing an asynchronous effect whose setup is still running waits for the setup first.","locale":"en"},"5941":{"id":"/en/docs/guide-effects-74","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#order","content":"**Within one effect** (an `effect_sync` body, an `effect` body, or the inverses a scope adopted), inverses run **sequentially, newest first**:","locale":"en"},"5942":{"id":"/en/docs/guide-effects-75","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#order","content":"synchronous inverses run immediately; from the first asynchronous one on, the rest runs as a spawned task;","locale":"en"},"5943":{"id":"/en/docs/guide-effects-76","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#order","content":"every inverse runs even if an earlier one fails, and the first error is the result;","locale":"en"},"5944":{"id":"/en/docs/guide-effects-77","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#order","content":"an inverse deferred to an effect that is already being disposed runs immediately.","locale":"en"},"5945":{"id":"/en/docs/guide-effects-78","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#order","content":"**When a fiber unloads**, the runtime:","locale":"en"},"5946":{"id":"/en/docs/guide-effects-79","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#order","content":"waits until no consumer still depends on the services the fiber provides (each consumer finishes its own teardown first);","locale":"en"},"5947":{"id":"/en/docs/guide-effects-80","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#order","content":"takes the fiber's effects, newest first;","locale":"en"},"5948":{"id":"/en/docs/guide-effects-81","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#order","content":"disposes them all **concurrently**, logging every failure and panic;","locale":"en"},"5949":{"id":"/en/docs/guide-effects-82","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#order","content":"then releases the services the fiber committed to.","locale":"en"},"5950":{"id":"/en/docs/guide-effects-83","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#order","content":"Sibling effects of one fiber therefore clean up concurrently, as Cordis's tests require (`service-dispose.spec.ts`). When teardown steps must happen in order, put them in **one** effect:","locale":"en"},"5951":{"id":"/en/docs/guide-effects-84","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#order","content":"Unloading a parent cascades to its children: each child plugin is an effect of its parent, so the parent's unload disposes them.","locale":"en"},"5952":{"id":"/en/docs/guide-effects-85","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#fibers","content":"A **fiber** is one instantiation of a plugin. Instantiating a plugin registers, on the current fiber, an effect whose inverse retires the new fiber:","locale":"en"},"5953":{"id":"/en/docs/guide-effects-86","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#fibers","content":"Method","locale":"en"},"5954":{"id":"/en/docs/guide-effects-87","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#fibers","content":"Instantiates","locale":"en"},"5955":{"id":"/en/docs/guide-effects-88","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#fibers","content":"`ctx.plugin::<P>(config)`","locale":"en"},"5956":{"id":"/en/docs/guide-effects-89","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#fibers","content":"a typed plugin with a typed config (`P::Config: Serialize`)","locale":"en"},"5957":{"id":"/en/docs/guide-effects-90","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#fibers","content":"`ctx.plugin_value::<P>(value)`","locale":"en"},"5958":{"id":"/en/docs/guide-effects-91","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#fibers","content":"a typed plugin from a raw JSON config","locale":"en"},"5959":{"id":"/en/docs/guide-effects-92","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#fibers","content":"`ctx.plugin_def(&def, value)`","locale":"en"},"5960":{"id":"/en/docs/guide-effects-93","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#fibers","content":"a `PluginDef`","locale":"en"},"5961":{"id":"/en/docs/guide-effects-94","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#fibers","content":"`ctx.inject(deps, \\|ctx\\| async move { … })`","locale":"en"},"5962":{"id":"/en/docs/guide-effects-95","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#fibers","content":"an anonymous closure plugin with the given dependencies","locale":"en"},"5963":{"id":"/en/docs/guide-effects-96","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#fibers","content":"Each returns `Result<Fiber>`. Retiring a fiber and then enabling the plugin again creates a **fresh** fiber, not the old one. `ctx.fiber()` returns the fiber a context belongs to; `Context::new()` creates a root, whose fiber is always active.","locale":"en"},"5964":{"id":"/en/docs/guide-effects-97","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#states","content":"`FiberState`","locale":"en"},"5965":{"id":"/en/docs/guide-effects-98","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#states","content":"Meaning","locale":"en"},"5966":{"id":"/en/docs/guide-effects-99","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#states","content":"`Pending`","locale":"en"},"5967":{"id":"/en/docs/guide-effects-100","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#states","content":"waiting for its dependencies","locale":"en"},"5968":{"id":"/en/docs/guide-effects-101","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#states","content":"`Loading`","locale":"en"},"5969":{"id":"/en/docs/guide-effects-102","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#states","content":"its `apply` is running","locale":"en"},"5970":{"id":"/en/docs/guide-effects-103","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#states","content":"`Active`","locale":"en"},"5971":{"id":"/en/docs/guide-effects-104","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#states","content":"loaded, with its services and effects in place","locale":"en"},"5972":{"id":"/en/docs/guide-effects-105","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#states","content":"`Unloading`","locale":"en"},"5973":{"id":"/en/docs/guide-effects-106","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#states","content":"its effects are being disposed","locale":"en"},"5974":{"id":"/en/docs/guide-effects-107","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#states","content":"`Failed`","locale":"en"},"5975":{"id":"/en/docs/guide-effects-108","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#states","content":"its last load failed; only `update` or a `registry.replace` recovers it (both clear the error)","locale":"en"},"5976":{"id":"/en/docs/guide-effects-109","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#states","content":"`Disposed`","locale":"en"},"5977":{"id":"/en/docs/guide-effects-110","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#states","content":"retired","locale":"en"},"5978":{"id":"/en/docs/guide-effects-111","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#states","content":"A transition in flight is never cut short (inertia): if the fiber's target changes while it loads, the load finishes and the fiber then unloads. A failed load also unloads what it registered before the fiber settles to `Failed`; a failure of a superseded load only cleans up and does not mark the fiber `Failed`. `StatusChanged` events report each change (see Events). Why the state machine is built this way is described on Core data structures and API design.","locale":"en"},"5979":{"id":"/en/docs/guide-effects-112","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#fiber-handle","content":"Method","locale":"en"},"5980":{"id":"/en/docs/guide-effects-113","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#fiber-handle","content":"Returns","locale":"en"},"5981":{"id":"/en/docs/guide-effects-114","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#fiber-handle","content":"`fiber.id()`","locale":"en"},"5982":{"id":"/en/docs/guide-effects-115","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#fiber-handle","content":"its `FiberId` (never reused; `0` is the root)","locale":"en"},"5983":{"id":"/en/docs/guide-effects-116","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#fiber-handle","content":"`fiber.state()`","locale":"en"},"5984":{"id":"/en/docs/guide-effects-117","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#fiber-handle","content":"its `FiberState`","locale":"en"},"5985":{"id":"/en/docs/guide-effects-118","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#fiber-handle","content":"`fiber.context()`","locale":"en"},"5986":{"id":"/en/docs/guide-effects-119","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#fiber-handle","content":"the fiber's own `Context`","locale":"en"},"5987":{"id":"/en/docs/guide-effects-120","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#fiber-handle","content":"`fiber.settled()`","locale":"en"},"5988":{"id":"/en/docs/guide-effects-121","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#fiber-handle","content":"`Settle`: resolves when no transition is in flight, with the fiber's error if it failed (Cordis's `await fiber`)","locale":"en"},"5989":{"id":"/en/docs/guide-effects-122","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#fiber-handle","content":"`fiber.update(config)`","locale":"en"},"5990":{"id":"/en/docs/guide-effects-123","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#fiber-handle","content":"`Result<Settle>`: replaces the configuration (below)","locale":"en"},"5991":{"id":"/en/docs/guide-effects-124","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#fiber-handle","content":"`fiber.update_with(config, no_save)`","locale":"en"},"5992":{"id":"/en/docs/guide-effects-125","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#fiber-handle","content":"the same; `no_save` suppresses `ConfigCommitted`","locale":"en"},"5993":{"id":"/en/docs/guide-effects-126","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#fiber-handle","content":"`fiber.restart()`","locale":"en"},"5994":{"id":"/en/docs/guide-effects-127","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#fiber-handle","content":"`Settle`: unloads and loads again","locale":"en"},"5995":{"id":"/en/docs/guide-effects-128","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#fiber-handle","content":"`fiber.dispose()`","locale":"en"},"5996":{"id":"/en/docs/guide-effects-129","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#fiber-handle","content":"`Disposal`: retires the fiber","locale":"en"},"5997":{"id":"/en/docs/guide-effects-130","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#fiber-handle","content":"`fiber.config()`","locale":"en"},"5998":{"id":"/en/docs/guide-effects-131","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#fiber-handle","content":"the source configuration, as last given","locale":"en"},"5999":{"id":"/en/docs/guide-effects-132","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#fiber-handle","content":"`fiber.inject()`, `fiber.def()`, `fiber.runtime()`, `fiber.name()`","locale":"en"},"6000":{"id":"/en/docs/guide-effects-133","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#fiber-handle","content":"its declaration, plugin definition, registry key, and plugin name (or its nearest named ancestor's)","locale":"en"},"6001":{"id":"/en/docs/guide-effects-134","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#fiber-handle","content":"`fiber.error()`","locale":"en"},"6002":{"id":"/en/docs/guide-effects-135","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#fiber-handle","content":"the failure of its last load, if any","locale":"en"},"6003":{"id":"/en/docs/guide-effects-136","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#fiber-handle","content":"`fiber.parent()`, `fiber.is_root()`, `fiber.is_removed()`","locale":"en"},"6004":{"id":"/en/docs/guide-effects-137","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#fiber-handle","content":"its place in the tree, and whether it has been retired","locale":"en"},"6005":{"id":"/en/docs/guide-effects-138","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#fiber-handle","content":"`fiber.effect_handle()`","locale":"en"},"6006":{"id":"/en/docs/guide-effects-139","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#fiber-handle","content":"the effect on the parent that instantiated it","locale":"en"},"6007":{"id":"/en/docs/guide-effects-140","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#fiber-handle","content":"`fiber.effects()`, `fiber.effect_count()`","locale":"en"},"6008":{"id":"/en/docs/guide-effects-141","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#fiber-handle","content":"the effects in its accumulator, in insertion order, as `EffectMeta` (labels and adopted children)","locale":"en"},"6009":{"id":"/en/docs/guide-effects-142","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#update","content":"**`update(config)`**:","locale":"en"},"6010":{"id":"/en/docs/guide-effects-143","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#update","content":"If the fiber is loaded, the new configuration is validated first; a rejected configuration returns an error and leaves the running instance untouched.","locale":"en"},"6011":{"id":"/en/docs/guide-effects-144","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#update","content":"Unless `no_save` is set, `ConfigCommitted { fiber, config }` is emitted (the loader writes it back to the config file).","locale":"en"},"6012":{"id":"/en/docs/guide-effects-145","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#update","content":"The configuration is stored and the fiber's error cleared.","locale":"en"},"6013":{"id":"/en/docs/guide-effects-146","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#update","content":"The decoded configuration is offered to the fiber's update hooks (`ctx.on_update`, `ctx.on_update_with`). A hook that takes the update over decides how it completes, and the fiber is not restarted.","locale":"en"},"6014":{"id":"/en/docs/guide-effects-147","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#update","content":"Otherwise the fiber restarts.","locale":"en"},"6015":{"id":"/en/docs/guide-effects-148","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#update","content":"**`restart()`** bumps the fiber's revision, so it unloads and loads again with the same configuration. It fails on a retired fiber, and it does not recover a `Failed` fiber: the failure stays (and `settled()` keeps returning it) until `update` or `registry.replace` clears it.","locale":"en"},"6016":{"id":"/en/docs/guide-effects-149","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#update","content":"**`dispose()`** retires the fiber: it is marked removed, its live provisions are unbound at once, it unloads and settles to `Disposed`. For the root fiber, `dispose()` restarts the root, reverting everything registered on it; this is how an app shuts down:","locale":"en"},"6017":{"id":"/en/docs/guide-effects-150","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#replace","content":"`ctx.registry()` gives access to the root's plugin registry:","locale":"en"},"6018":{"id":"/en/docs/guide-effects-151","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#replace","content":"Method","locale":"en"},"6019":{"id":"/en/docs/guide-effects-152","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#replace","content":"Does","locale":"en"},"6020":{"id":"/en/docs/guide-effects-153","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#replace","content":"`registry.replace(&old, &new)`","locale":"en"},"6021":{"id":"/en/docs/guide-effects-154","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#replace","content":"swaps the implementation behind every fiber of `old` in place and forwards future instantiations of `old` to `new`. Returns the moved fibers; each reloads with the new implementation and emits `Replaced`.","locale":"en"},"6022":{"id":"/en/docs/guide-effects-155","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#replace","content":"`registry.size()`, `keys()`, `get(&def)`, `has(&def)`, `fibers(&def)`","locale":"en"},"6023":{"id":"/en/docs/guide-effects-156","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#replace","content":"inspection","locale":"en"},"6024":{"id":"/en/docs/guide-effects-157","page_id":"/en/docs/guide-effects","tags":[],"type":"text","url":"/en/docs/guide-effects#replace","content":"The moved fibers keep their identity, parent, configuration and loader entry. This is the primitive behind hot reload, and it is useful on its own:","locale":"en"},"6025":{"id":"/en/docs/guide-guests","page_id":"/en/docs/guide-guests","type":"page","content":"Guest plugins","breadcrumbs":["kardia Documentation","Guide"],"tags":[],"url":"/en/docs/guide-guests","locale":"en"},"6026":{"id":"/en/docs/guide-guests-0","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests","content":"Write plugins that hot-reload without restarting the app: the WASM, dylib and process backends, the Rust guest SDK, failure behaviour, and the JSON-based guest ABI.","locale":"en"},"6027":{"id":"/en/docs/guide-guests-1","page_id":"/en/docs/guide-guests","type":"heading","tags":[],"url":"/en/docs/guide-guests#backends","content":"Backends","locale":"en"},"6028":{"id":"/en/docs/guide-guests-2","page_id":"/en/docs/guide-guests","type":"heading","tags":[],"url":"/en/docs/guide-guests#guest-service","content":"Calling guests from Rust","locale":"en"},"6029":{"id":"/en/docs/guide-guests-3","page_id":"/en/docs/guide-guests","type":"heading","tags":[],"url":"/en/docs/guide-guests#sdk","content":"Writing a guest in Rust","locale":"en"},"6030":{"id":"/en/docs/guide-guests-4","page_id":"/en/docs/guide-guests","type":"heading","tags":[],"url":"/en/docs/guide-guests#guest-trait","content":"The `Guest` trait","locale":"en"},"6031":{"id":"/en/docs/guide-guests-5","page_id":"/en/docs/guide-guests","type":"heading","tags":[],"url":"/en/docs/guide-guests#host","content":"The `Host`","locale":"en"},"6032":{"id":"/en/docs/guide-guests-6","page_id":"/en/docs/guide-guests","type":"heading","tags":[],"url":"/en/docs/guide-guests#build","content":"Building","locale":"en"},"6033":{"id":"/en/docs/guide-guests-7","page_id":"/en/docs/guide-guests","type":"heading","tags":[],"url":"/en/docs/guide-guests#deps","content":"Modules with dependencies","locale":"en"},"6034":{"id":"/en/docs/guide-guests-8","page_id":"/en/docs/guide-guests","type":"heading","tags":[],"url":"/en/docs/guide-guests#failures","content":"Failure behaviour","locale":"en"},"6035":{"id":"/en/docs/guide-guests-9","page_id":"/en/docs/guide-guests","type":"heading","tags":[],"url":"/en/docs/guide-guests#abi","content":"The guest ABI","locale":"en"},"6036":{"id":"/en/docs/guide-guests-10","page_id":"/en/docs/guide-guests","type":"heading","tags":[],"url":"/en/docs/guide-guests#process","content":"Process transport","locale":"en"},"6037":{"id":"/en/docs/guide-guests-11","page_id":"/en/docs/guide-guests","type":"heading","tags":[],"url":"/en/docs/guide-guests#hello","content":"A guest by hand: `hello.wat`","locale":"en"},"6038":{"id":"/en/docs/guide-guests-12","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests","content":"**Guest plugins** are separate modules that the `hmr` plugin can reload in place, unlike plugins compiled into the binary, whose code changes need a restart. In a config file loaded by the `kardia` binary, any entry name that is not a built-in plugin is a guest module path, relative to the config file:","locale":"en"},"6039":{"id":"/en/docs/guide-guests-13","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests","content":"All backends speak one JSON-based **guest ABI** (below) and run each guest plugin through a bridge plugin that instantiates the guest once per fiber and drops the instance when the fiber is disposed. The Rust SDK `kardia-guest` writes such guests for every backend from one source.","locale":"en"},"6040":{"id":"/en/docs/guide-guests-14","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#backends","content":"WebAssembly (`WasmSource`)","locale":"en"},"6041":{"id":"/en/docs/guide-guests-15","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#backends","content":"Dynamic library (`DylibSource`)","locale":"en"},"6042":{"id":"/en/docs/guide-guests-16","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#backends","content":"Child process (`ProcessSource`)","locale":"en"},"6043":{"id":"/en/docs/guide-guests-17","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#backends","content":"Files","locale":"en"},"6044":{"id":"/en/docs/guide-guests-18","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#backends","content":"`.wasm`, or `.wat` text","locale":"en"},"6045":{"id":"/en/docs/guide-guests-19","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#backends","content":"`.so` / `.dylib` / `.dll`","locale":"en"},"6046":{"id":"/en/docs/guide-guests-20","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#backends","content":"executables","locale":"en"},"6047":{"id":"/en/docs/guide-guests-21","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#backends","content":"Runs","locale":"en"},"6048":{"id":"/en/docs/guide-guests-22","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#backends","content":"on wasmtime, one store per fiber","locale":"en"},"6049":{"id":"/en/docs/guide-guests-23","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#backends","content":"in the host process","locale":"en"},"6050":{"id":"/en/docs/guide-guests-24","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#backends","content":"one child process per fiber","locale":"en"},"6051":{"id":"/en/docs/guide-guests-25","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#backends","content":"Isolation","locale":"en"},"6052":{"id":"/en/docs/guide-guests-26","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#backends","content":"sandboxed","locale":"en"},"6053":{"id":"/en/docs/guide-guests-27","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#backends","content":"none: a crash in the library brings down the app","locale":"en"},"6054":{"id":"/en/docs/guide-guests-28","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#backends","content":"a crashing guest fails only its own calls","locale":"en"},"6055":{"id":"/en/docs/guide-guests-29","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#backends","content":"Reload","locale":"en"},"6056":{"id":"/en/docs/guide-guests-30","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#backends","content":"compiles once per version; old and new instances run side by side, and dropping an instance releases all of its memory","locale":"en"},"6057":{"id":"/en/docs/guide-guests-31","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#backends","content":"each version is loaded from a fresh copy and **never unloaded**; it stays loaded until the process exits","locale":"en"},"6058":{"id":"/en/docs/guide-guests-32","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#backends","content":"reloading a module respawns its processes","locale":"en"},"6059":{"id":"/en/docs/guide-guests-33","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#backends","content":"Use for","locale":"en"},"6060":{"id":"/en/docs/guide-guests-34","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#backends","content":"production guests","locale":"en"},"6061":{"id":"/en/docs/guide-guests-35","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#backends","content":"development: same toolchain, no WASM target needed","locale":"en"},"6062":{"id":"/en/docs/guide-guests-36","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#backends","content":"guests in any language, or that must not crash the host","locale":"en"},"6063":{"id":"/en/docs/guide-guests-37","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#backends","content":"`kardia` binary","locale":"en"},"6064":{"id":"/en/docs/guide-guests-38","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#backends","content":"yes","locale":"en"},"6065":{"id":"/en/docs/guide-guests-39","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#backends","content":"yes","locale":"en"},"6066":{"id":"/en/docs/guide-guests-40","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#backends","content":"not yet (library only)","locale":"en"},"6067":{"id":"/en/docs/guide-guests-41","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#backends","content":"**WebAssembly.** `WasmSource` runs core WebAssembly modules on wasmtime rather than WIT components, so guests need no component toolchain (the tests are written in WAT). A module compiles once per version and instantiates in its own store per fiber.","locale":"en"},"6068":{"id":"/en/docs/guide-guests-42","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#backends","content":"**Dynamic libraries.** `DylibSource` speaks a C ABI instead of passing Rust types: a `cdylib` carries its own copies of `kardia-core` and tokio, with separate statics and no runtime context. Each load copies the library to a fresh path (in a `kardia-dylib-<pid>` directory under the temp directory), because the platform loader hands out the library it already loaded for a known path. Libraries are never unloaded: unloading Rust code is unsound once it registered thread-local destructors or handed out `'static` references.","locale":"en"},"6069":{"id":"/en/docs/guide-guests-43","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#backends","content":"**Child processes.** `ProcessSource` runs each plugin instance as its own process, speaking the guest ABI as JSON lines over stdin and stdout (see Process transport). A crashing guest fails only its own calls, and a guest that breaks the protocol is killed. Replace an executable by renaming a new file over it: a running executable cannot be written to, and one held open for writing cannot be started.","locale":"en"},"6070":{"id":"/en/docs/guide-guests-44","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#backends","content":"**Common to all three.** Calls are synchronous rather than the asynchronous RPC of paper §6.2: they block the caller until the guest answers, so a hung guest blocks its caller too. There is no separate broker service: each fiber's `GuestService` is the RPC endpoint. The backends are cargo features of `kardia-hmr` (`wasm`, `dylib`, `process`, all on by default).","locale":"en"},"6071":{"id":"/en/docs/guide-guests-45","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#backends","content":"The `kardia` binary picks a backend by file extension: `.wasm` and `.wat` go to `WasmSource`, anything else to `DylibSource`. An app built on the library chooses its own:","locale":"en"},"6072":{"id":"/en/docs/guide-guests-46","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#guest-service","content":"A guest provides services with `Host::provide`. On the host side, each is a `kardia::hmr::GuestService`, whose JSON view is the value the guest provided:","locale":"en"},"6073":{"id":"/en/docs/guide-guests-47","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#guest-service","content":"`GuestService`","locale":"en"},"6074":{"id":"/en/docs/guide-guests-48","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#guest-service","content":"`value()`","locale":"en"},"6075":{"id":"/en/docs/guide-guests-49","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#guest-service","content":"the JSON value the guest provided the service with","locale":"en"},"6076":{"id":"/en/docs/guide-guests-50","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#guest-service","content":"`call(method, args)`","locale":"en"},"6077":{"id":"/en/docs/guide-guests-51","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#guest-service","content":"calls the guest's `cordis_call` with `{ key, method, args }` and returns its JSON result","locale":"en"},"6078":{"id":"/en/docs/guide-guests-52","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#guest-service","content":"A call fails with `the guest instance is disposed` once the providing fiber is gone, and with `invalid result of <key>.<method>: …` if the guest returns something that is not JSON. A guest calling back into an instance that is already running on the same thread (directly or through other guests) fails with `re-entrant call into a guest instance` instead of deadlocking. Like any service, a guest service is withdrawn when the guest's fiber is disposed.","locale":"en"},"6079":{"id":"/en/docs/guide-guests-53","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#sdk","content":"Create a `cdylib` crate that depends on `kardia-guest`:","locale":"en"},"6080":{"id":"/en/docs/guide-guests-54","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#sdk","content":"Implement `Guest` and `export!` it:","locale":"en"},"6081":{"id":"/en/docs/guide-guests-55","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#guest-trait","content":"Each fiber running the plugin gets its own instance of the type.","locale":"en"},"6082":{"id":"/en/docs/guide-guests-56","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#guest-trait","content":"Item","locale":"en"},"6083":{"id":"/en/docs/guide-guests-57","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#guest-trait","content":"Purpose","locale":"en"},"6084":{"id":"/en/docs/guide-guests-58","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#guest-trait","content":"`type Config: DeserializeOwned`","locale":"en"},"6085":{"id":"/en/docs/guide-guests-59","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#guest-trait","content":"the plugin's configuration; `null` decodes as `{}` when it fails to decode as it is","locale":"en"},"6086":{"id":"/en/docs/guide-guests-60","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#guest-trait","content":"`fn meta() -> Meta`","locale":"en"},"6087":{"id":"/en/docs/guide-guests-61","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#guest-trait","content":"what the module depends on and exports","locale":"en"},"6088":{"id":"/en/docs/guide-guests-62","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#guest-trait","content":"`fn apply(host, config, imports) -> Result<Self>`","locale":"en"},"6089":{"id":"/en/docs/guide-guests-63","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#guest-trait","content":"starts an instance with its configuration and the values of the module's dependencies (keyed by resolved path)","locale":"en"},"6090":{"id":"/en/docs/guide-guests-64","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#guest-trait","content":"`fn call(&mut self, host, request) -> Result<Value>`","locale":"en"},"6091":{"id":"/en/docs/guide-guests-65","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#guest-trait","content":"answers a call to a service the instance provided; the default fails with `<key> has no method <method>`","locale":"en"},"6092":{"id":"/en/docs/guide-guests-66","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#guest-trait","content":"`fn dispose(self, host)`","locale":"en"},"6093":{"id":"/en/docs/guide-guests-67","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#guest-trait","content":"runs when the fiber is disposed, before the instance is dropped; the default does nothing","locale":"en"},"6094":{"id":"/en/docs/guide-guests-68","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#guest-trait","content":"`Meta` describes the module:","locale":"en"},"6095":{"id":"/en/docs/guide-guests-69","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#guest-trait","content":"`Meta`","locale":"en"},"6096":{"id":"/en/docs/guide-guests-70","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#guest-trait","content":"`Meta::plugin(name)`","locale":"en"},"6097":{"id":"/en/docs/guide-guests-71","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#guest-trait","content":"a module exporting a plugin named `name`","locale":"en"},"6098":{"id":"/en/docs/guide-guests-72","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#guest-trait","content":"`Meta::value(value)`","locale":"en"},"6099":{"id":"/en/docs/guide-guests-73","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#guest-trait","content":"a module exporting a value, which dependent modules receive as an import","locale":"en"},"6100":{"id":"/en/docs/guide-guests-74","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#guest-trait","content":"`.dep(path)`","locale":"en"},"6101":{"id":"/en/docs/guide-guests-75","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#guest-trait","content":"a dependency: a module path relative to this module","locale":"en"},"6102":{"id":"/en/docs/guide-guests-76","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#guest-trait","content":"`.inject(key)`","locale":"en"},"6103":{"id":"/en/docs/guide-guests-77","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#guest-trait","content":"a service the plugin reads; it starts once the service is available","locale":"en"},"6104":{"id":"/en/docs/guide-guests-78","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#guest-trait","content":"`.provide(key)`","locale":"en"},"6105":{"id":"/en/docs/guide-guests-79","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#guest-trait","content":"a service the plugin provides","locale":"en"},"6106":{"id":"/en/docs/guide-guests-80","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#guest-trait","content":"`Request` is `{ key, method, args }`. `Error` is an error message reported to the host (`Error::msg(..)`, `error.message()`); any displayable error converts into it with `?`.","locale":"en"},"6107":{"id":"/en/docs/guide-guests-81","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#host","content":"`Host` method","locale":"en"},"6108":{"id":"/en/docs/guide-guests-82","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#host","content":"Does","locale":"en"},"6109":{"id":"/en/docs/guide-guests-83","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#host","content":"`log(level, text)`","locale":"en"},"6110":{"id":"/en/docs/guide-guests-84","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#host","content":"logs as the plugin (`Level::Error` … `Level::Debug`)","locale":"en"},"6111":{"id":"/en/docs/guide-guests-85","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#host","content":"`provide(key, &value)`","locale":"en"},"6112":{"id":"/en/docs/guide-guests-86","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#host","content":"provides the service `key`, whose JSON view is `value`; calls to it arrive at `Guest::call`. It is withdrawn when the fiber is disposed.","locale":"en"},"6113":{"id":"/en/docs/guide-guests-87","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#host","content":"`view(key)`","locale":"en"},"6114":{"id":"/en/docs/guide-guests-88","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#host","content":"the JSON view of a service declared with `Meta::inject` (or provided by this plugin or its ancestors), with the checked access of the plugin's declared `inject`","locale":"en"},"6115":{"id":"/en/docs/guide-guests-89","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#host","content":"`invoke(key, method, &args)`","locale":"en"},"6116":{"id":"/en/docs/guide-guests-90","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#host","content":"calls a service provided by another guest","locale":"en"},"6117":{"id":"/en/docs/guide-guests-91","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#host","content":"From Rust host code, a guest's services are called through `GuestService` (see above).","locale":"en"},"6118":{"id":"/en/docs/guide-guests-92","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#build","content":"The same source builds a WebAssembly or a dynamic-library guest. `export!` emits the WASM exports on `wasm32` and the C symbols elsewhere:","locale":"en"},"6119":{"id":"/en/docs/guide-guests-93","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#build","content":"For a **process guest**, add a binary to the crate whose `main` serves the guest. Use `crate-type = [\"cdylib\", \"rlib\"]`, so that the binary can use the library:","locale":"en"},"6120":{"id":"/en/docs/guide-guests-94","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#build","content":"`serve` answers the exports the host sends as JSON lines on stdin, until the host disposes the instance or stdin closes. stdout carries the protocol, so a process guest must not print to it; it logs through `Host::log` or to stderr.","locale":"en"},"6121":{"id":"/en/docs/guide-guests-95","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#deps","content":"A module can depend on other modules, and a module can export a value instead of a plugin:","locale":"en"},"6122":{"id":"/en/docs/guide-guests-96","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#deps","content":"When `shared.wasm` changes, hot reload reloads `greeter` too, since it imports the changed module (see Reconcile transactions). A module exporting neither a plugin nor a value exports nothing.","locale":"en"},"6123":{"id":"/en/docs/guide-guests-97","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#failures","content":"An error or a panic in a guest fails only that plugin or call:","locale":"en"},"6124":{"id":"/en/docs/guide-guests-98","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#failures","content":"Backend","locale":"en"},"6125":{"id":"/en/docs/guide-guests-99","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#failures","content":"A panic in a guest","locale":"en"},"6126":{"id":"/en/docs/guide-guests-100","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#failures","content":"The guest goes away","locale":"en"},"6127":{"id":"/en/docs/guide-guests-101","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#failures","content":"dylib","locale":"en"},"6128":{"id":"/en/docs/guide-guests-102","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#failures","content":"the SDK catches it and returns it as an error: `the guest panicked: <message>`","locale":"en"},"6129":{"id":"/en/docs/guide-guests-103","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#failures","content":"a crash brings down the host","locale":"en"},"6130":{"id":"/en/docs/guide-guests-104","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#failures","content":"process","locale":"en"},"6131":{"id":"/en/docs/guide-guests-105","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#failures","content":"the SDK catches it and returns it as an error: `the guest panicked: <message>`","locale":"en"},"6132":{"id":"/en/docs/guide-guests-106","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#failures","content":"a process that exits fails its later calls with `the guest process exited`; one that breaks the protocol (`invalid message from guest: …`) is killed, with the same result","locale":"en"},"6133":{"id":"/en/docs/guide-guests-107","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#failures","content":"WebAssembly","locale":"en"},"6134":{"id":"/en/docs/guide-guests-108","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#failures","content":"the guest aborts, and the host reports the abort as a failed call","locale":"en"},"6135":{"id":"/en/docs/guide-guests-109","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#failures","content":"–","locale":"en"},"6136":{"id":"/en/docs/guide-guests-110","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#failures","content":"An error returned from `apply` fails the plugin's fiber (`Failed`); an error returned from `call` fails that call, and the instance keeps running.","locale":"en"},"6137":{"id":"/en/docs/guide-guests-111","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#failures","content":"A panic in `dispose` is contained, as the host has nothing to report it to.","locale":"en"},"6138":{"id":"/en/docs/guide-guests-112","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#failures","content":"The process of a disposed or failed instance is never left running; after `dispose`, the host kills it. If the host goes away, a process guest exits.","locale":"en"},"6139":{"id":"/en/docs/guide-guests-113","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#failures","content":"While the module's metadata is read (`meta`), there is no plugin context: host calls fail with `host calls are unavailable while reading module metadata`.","locale":"en"},"6140":{"id":"/en/docs/guide-guests-114","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#abi","content":"Guests in other languages implement this interface, which is also documented in the `kardia-hmr` crate docs (`cargo doc -p kardia-hmr --open`).","locale":"en"},"6141":{"id":"/en/docs/guide-guests-115","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#abi","content":"Data crosses the boundary as UTF-8 JSON in byte buffers. The host keeps one **message** per instance: the input of the export being called, then the result of the last host call. The guest copies it into its own memory with `read`, after allocating the length it was given.","locale":"en"},"6142":{"id":"/en/docs/guide-guests-116","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#abi","content":"**Exports** (status `0` is success; on failure the guest `write`s the error):","locale":"en"},"6143":{"id":"/en/docs/guide-guests-117","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#abi","content":"WASM","locale":"en"},"6144":{"id":"/en/docs/guide-guests-118","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#abi","content":"dylib","locale":"en"},"6145":{"id":"/en/docs/guide-guests-119","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#abi","content":"`memory`","locale":"en"},"6146":{"id":"/en/docs/guide-guests-120","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#abi","content":"`cordis_new() -> state`","locale":"en"},"6147":{"id":"/en/docs/guide-guests-121","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#abi","content":"memory / per-instance guest state","locale":"en"},"6148":{"id":"/en/docs/guide-guests-122","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#abi","content":"`cordis_meta() -> i32`","locale":"en"},"6149":{"id":"/en/docs/guide-guests-123","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#abi","content":"`cordis_meta(state, host) -> i32`","locale":"en"},"6150":{"id":"/en/docs/guide-guests-124","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#abi","content":"`write`s `{ deps?, plugin?: { name?, inject?, provide? }, value? }`","locale":"en"},"6151":{"id":"/en/docs/guide-guests-125","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#abi","content":"`cordis_apply(len) -> i32`","locale":"en"},"6152":{"id":"/en/docs/guide-guests-126","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#abi","content":"`cordis_apply(state, host, len) -> i32`","locale":"en"},"6153":{"id":"/en/docs/guide-guests-127","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#abi","content":"message: `{ config, imports }`","locale":"en"},"6154":{"id":"/en/docs/guide-guests-128","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#abi","content":"`cordis_call(len) -> i32`","locale":"en"},"6155":{"id":"/en/docs/guide-guests-129","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#abi","content":"`cordis_call(state, host, len) -> i32`","locale":"en"},"6156":{"id":"/en/docs/guide-guests-130","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#abi","content":"message: `{ key, method, args }`; `write`s the result","locale":"en"},"6157":{"id":"/en/docs/guide-guests-131","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#abi","content":"`cordis_dispose()` (optional)","locale":"en"},"6158":{"id":"/en/docs/guide-guests-132","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#abi","content":"`cordis_dispose(state, host)`","locale":"en"},"6159":{"id":"/en/docs/guide-guests-133","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#abi","content":"last call; a dylib frees `state`","locale":"en"},"6160":{"id":"/en/docs/guide-guests-134","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#abi","content":"`deps` are module paths relative to the module; `imports` maps each dependency that exports a `value` to that value. A module exporting neither a plugin nor a value exports nothing.","locale":"en"},"6161":{"id":"/en/docs/guide-guests-135","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#abi","content":"**Host functions** (WASM imports from module `cordis`; for a dylib, function pointers in the `host` struct `{ host, read, write, log, provide, view, invoke }`, each taking `host.host` first). Pointers are guest addresses, lengths are byte counts:","locale":"en"},"6162":{"id":"/en/docs/guide-guests-136","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#abi","content":"`read(ptr)` copies the message to `ptr`.","locale":"en"},"6163":{"id":"/en/docs/guide-guests-137","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#abi","content":"`write(ptr, len)` sets the result of the current export.","locale":"en"},"6164":{"id":"/en/docs/guide-guests-138","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#abi","content":"`log(level, ptr, len)` logs as the plugin (`0` error … `3` debug).","locale":"en"},"6165":{"id":"/en/docs/guide-guests-139","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#abi","content":"`provide(key, key_len, value, value_len) -> i32` provides the service `key` as a `GuestService` whose JSON view is `value`.","locale":"en"},"6166":{"id":"/en/docs/guide-guests-140","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#abi","content":"`view(key, key_len) -> i32` reads the JSON view of a service, with the checked access of the plugin's declared `inject`.","locale":"en"},"6167":{"id":"/en/docs/guide-guests-141","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#abi","content":"`invoke(key, key_len, method, method_len, args, args_len) -> i32` calls a `GuestService`.","locale":"en"},"6168":{"id":"/en/docs/guide-guests-142","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#abi","content":"Host functions returning `i32` set the message to their result and return its length, or set it to an error message and return `-1 - len`.","locale":"en"},"6169":{"id":"/en/docs/guide-guests-143","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#abi","content":"**Lifecycle of a module.** Loading a module instantiates it once to read its metadata (`meta`, then `dispose`); dependencies in `deps` are loaded first. Each fiber running the plugin then gets a fresh instance: `apply` with `{ config, imports }`, any number of `call`s, and `dispose` when the fiber is disposed, after which the instance is dropped. A non-zero status with no written output fails with `guest failed with status <n>`.","locale":"en"},"6170":{"id":"/en/docs/guide-guests-144","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#process","content":"A process guest exchanges one JSON object per line over its stdin and stdout (stdout is reserved for this; a guest logs through `log` or stderr).","locale":"en"},"6171":{"id":"/en/docs/guide-guests-145","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#process","content":"Direction","locale":"en"},"6172":{"id":"/en/docs/guide-guests-146","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#process","content":"Message","locale":"en"},"6173":{"id":"/en/docs/guide-guests-147","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#process","content":"Meaning","locale":"en"},"6174":{"id":"/en/docs/guide-guests-148","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#process","content":"host → guest","locale":"en"},"6175":{"id":"/en/docs/guide-guests-149","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#process","content":"`{ export, input }`","locale":"en"},"6176":{"id":"/en/docs/guide-guests-150","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#process","content":"an export: `export` is one of `meta`, `apply`, `call`, `dispose`; `input` is the message (`null` if empty)","locale":"en"},"6177":{"id":"/en/docs/guide-guests-151","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#process","content":"guest → host","locale":"en"},"6178":{"id":"/en/docs/guide-guests-152","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#process","content":"`{ call: \"log\", level, text }`","locale":"en"},"6179":{"id":"/en/docs/guide-guests-153","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#process","content":"logs; no reply","locale":"en"},"6180":{"id":"/en/docs/guide-guests-154","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#process","content":"guest → host","locale":"en"},"6181":{"id":"/en/docs/guide-guests-155","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#process","content":"`{ call: \"provide\", key, value }`","locale":"en"},"6182":{"id":"/en/docs/guide-guests-156","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#process","content":"answered with `{ result }` or `{ error }`","locale":"en"},"6183":{"id":"/en/docs/guide-guests-157","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#process","content":"guest → host","locale":"en"},"6184":{"id":"/en/docs/guide-guests-158","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#process","content":"`{ call: \"view\", key }`","locale":"en"},"6185":{"id":"/en/docs/guide-guests-159","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#process","content":"answered with `{ result }` or `{ error }`","locale":"en"},"6186":{"id":"/en/docs/guide-guests-160","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#process","content":"guest → host","locale":"en"},"6187":{"id":"/en/docs/guide-guests-161","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#process","content":"`{ call: \"invoke\", key, method, args }`","locale":"en"},"6188":{"id":"/en/docs/guide-guests-162","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#process","content":"answered with `{ result }` or `{ error }`","locale":"en"},"6189":{"id":"/en/docs/guide-guests-163","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#process","content":"guest → host","locale":"en"},"6190":{"id":"/en/docs/guide-guests-164","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#process","content":"`{ output }`","locale":"en"},"6191":{"id":"/en/docs/guide-guests-165","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#process","content":"sets the result text of the export","locale":"en"},"6192":{"id":"/en/docs/guide-guests-166","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#process","content":"guest → host","locale":"en"},"6193":{"id":"/en/docs/guide-guests-167","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#process","content":"`{ done: status }`","locale":"en"},"6194":{"id":"/en/docs/guide-guests-168","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#process","content":"ends the export","locale":"en"},"6195":{"id":"/en/docs/guide-guests-169","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#process","content":"After `dispose` the process is killed; a guest exits when its stdin closes.","locale":"en"},"6196":{"id":"/en/docs/guide-guests-170","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#process","content":"For example, the `Counter` guest above, applied without configuration and then called once:","locale":"en"},"6197":{"id":"/en/docs/guide-guests-171","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#hello","content":"`examples/plugins/hello.wat` is a guest written by hand in WebAssembly text. It imports `write` and `log` from the `cordis` module and exports `memory` and three functions:","locale":"en"},"6198":{"id":"/en/docs/guide-guests-172","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#hello","content":"`cordis_meta` writes `{\"plugin\":{\"name\":\"hello\"}}`: a plugin named `hello`, with no dependencies, injections or provisions. It returns `0`.","locale":"en"},"6199":{"id":"/en/docs/guide-guests-173","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#hello","content":"`cordis_apply` ignores its input (it never `read`s the message) and logs `hello from wasm` at level `2` (info).","locale":"en"},"6200":{"id":"/en/docs/guide-guests-174","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#hello","content":"`cordis_dispose` logs `goodbye from wasm`.","locale":"en"},"6201":{"id":"/en/docs/guide-guests-175","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#hello","content":"There is no `cordis_call`, as the plugin provides no service.","locale":"en"},"6202":{"id":"/en/docs/guide-guests-176","page_id":"/en/docs/guide-guests","tags":[],"type":"text","url":"/en/docs/guide-guests#hello","content":"Run it with `cargo run -p kardia -- examples/kardia.yml` and edit the greeting: `hmr` reloads the module in place, so the old instance logs its goodbye, then the new one logs your greeting.","locale":"en"},"6203":{"id":"/en/docs/guide-hot-reload","page_id":"/en/docs/guide-hot-reload","type":"page","content":"Hot reload","breadcrumbs":["kardia Documentation","Guide"],"tags":[],"url":"/en/docs/guide-hot-reload","locale":"en"},"6204":{"id":"/en/docs/guide-hot-reload-0","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload","content":"Reload guest modules in place with the hmr plugin: configure watch mode, set up a module graph, run reconcile transactions, and understand how failures are handled.","locale":"en"},"6205":{"id":"/en/docs/guide-hot-reload-1","page_id":"/en/docs/guide-hot-reload","type":"heading","tags":[],"url":"/en/docs/guide-hot-reload#config","content":"Watching guest modules","locale":"en"},"6206":{"id":"/en/docs/guide-hot-reload-2","page_id":"/en/docs/guide-hot-reload","type":"heading","tags":[],"url":"/en/docs/guide-hot-reload#setup","content":"Setting up hot reload in your app","locale":"en"},"6207":{"id":"/en/docs/guide-hot-reload-3","page_id":"/en/docs/guide-hot-reload","type":"heading","tags":[],"url":"/en/docs/guide-hot-reload#graph","content":"Modules and the module graph","locale":"en"},"6208":{"id":"/en/docs/guide-hot-reload-4","page_id":"/en/docs/guide-hot-reload","type":"heading","tags":[],"url":"/en/docs/guide-hot-reload#host","content":"Host modules","locale":"en"},"6209":{"id":"/en/docs/guide-hot-reload-5","page_id":"/en/docs/guide-hot-reload","type":"heading","tags":[],"url":"/en/docs/guide-hot-reload#reconcile","content":"Reconcile transactions","locale":"en"},"6210":{"id":"/en/docs/guide-hot-reload-6","page_id":"/en/docs/guide-hot-reload","type":"heading","tags":[],"url":"/en/docs/guide-hot-reload#result","content":"`ReconcileResult`","locale":"en"},"6211":{"id":"/en/docs/guide-hot-reload-7","page_id":"/en/docs/guide-hot-reload","type":"heading","tags":[],"url":"/en/docs/guide-hot-reload#replacing","content":"How a reload replaces a plugin","locale":"en"},"6212":{"id":"/en/docs/guide-hot-reload-8","page_id":"/en/docs/guide-hot-reload","type":"heading","tags":[],"url":"/en/docs/guide-hot-reload#watch","content":"Watch mode","locale":"en"},"6213":{"id":"/en/docs/guide-hot-reload-9","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload","content":"Plugins compiled into the binary can be reconfigured live, but changing their code needs a restart. **Guest plugins** are separate modules that the `hmr` plugin (`kardia-hmr`) can reload in place: when a module changes, the plugins it exports are replaced behind their running fibers, and the rest of the app follows.","locale":"en"},"6214":{"id":"/en/docs/guide-hot-reload-10","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload","content":"Rust has no module registry, so the host owns one: a `ModuleGraph` loads module code from a `ModuleSource`. The `Hmr` service reloads changed modules and replaces the plugins they export in place through `registry.replace`; with `watch.enabled` (and the `fs` service) it does so as files change. How to write the modules themselves is on Guest plugins; how the reconciliation is built is on Loader internals, and the TypeScript original on HMR.","locale":"en"},"6215":{"id":"/en/docs/guide-hot-reload-11","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#config","content":"To reload guest modules as they change, add an `hmr` entry with watch mode to the config file:","locale":"en"},"6216":{"id":"/en/docs/guide-hot-reload-12","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#config","content":"`HmrConfig`:","locale":"en"},"6217":{"id":"/en/docs/guide-hot-reload-13","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#config","content":"Option","locale":"en"},"6218":{"id":"/en/docs/guide-hot-reload-14","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#config","content":"Default","locale":"en"},"6219":{"id":"/en/docs/guide-hot-reload-15","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#config","content":"Meaning","locale":"en"},"6220":{"id":"/en/docs/guide-hot-reload-16","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#config","content":"`base`","locale":"en"},"6221":{"id":"/en/docs/guide-hot-reload-17","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#config","content":"`.`","locale":"en"},"6222":{"id":"/en/docs/guide-hot-reload-18","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#config","content":"The base directory. A relative `base` resolves against the directory of the config file that loads the `hmr` entry (as the TypeScript code does with `ctx.baseUrl`), else against the working directory. `watch.files` and logged paths are relative to it.","locale":"en"},"6223":{"id":"/en/docs/guide-hot-reload-19","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#config","content":"`watch.enabled`","locale":"en"},"6224":{"id":"/en/docs/guide-hot-reload-20","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#config","content":"`false`","locale":"en"},"6225":{"id":"/en/docs/guide-hot-reload-21","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#config","content":"Reload on file changes. Requires the `fs` service.","locale":"en"},"6226":{"id":"/en/docs/guide-hot-reload-22","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#config","content":"`watch.files`","locale":"en"},"6227":{"id":"/en/docs/guide-hot-reload-23","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#config","content":"`[\".\", \"!**/.*\", \"!**/target\"]`","locale":"en"},"6228":{"id":"/en/docs/guide-hot-reload-24","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#config","content":"Files to watch: patterns relative to `base`, as the `fs` watch filter takes them. A leading `!` excludes, and the last pattern matching a path or one of its ancestors decides.","locale":"en"},"6229":{"id":"/en/docs/guide-hot-reload-25","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#config","content":"`watch.debounce`","locale":"en"},"6230":{"id":"/en/docs/guide-hot-reload-26","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#config","content":"`100`","locale":"en"},"6231":{"id":"/en/docs/guide-hot-reload-27","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#config","content":"Changes within this many milliseconds are reloaded together.","locale":"en"},"6232":{"id":"/en/docs/guide-hot-reload-28","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#config","content":"With `watch.enabled` and a non-empty `files` list, `hmr` logs `watching [..] in <base>` and starts a watch below itself that waits for `fs`. If `fs` is there, the watch is set up before `hmr` settles; a failure to set it up is logged.","locale":"en"},"6233":{"id":"/en/docs/guide-hot-reload-29","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#config","content":"The `kardia` binary registers `hmr` (also as `@cordisjs/plugin-hmr`) and resolves any entry name that is not a built-in plugin as a guest module relative to the config file, so `examples/kardia.yml` hot-reloads `plugins/hello.wat`:","locale":"en"},"6234":{"id":"/en/docs/guide-hot-reload-30","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#setup","content":"A `ModuleGraph` is also a `Resolver`, so the loader can resolve entry names through it; `Hmr::plugin(graph)` is the `hmr` plugin over the same graph:","locale":"en"},"6235":{"id":"/en/docs/guide-hot-reload-31","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#setup","content":"To mix built-in plugins and guest modules, resolve through a catalog first and the graph second, as the binary does (see The loader). To reload through the loader's config file, register `Hmr::plugin(graph)` in the catalog under `hmr` and add an `hmr` entry.","locale":"en"},"6236":{"id":"/en/docs/guide-hot-reload-32","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#graph","content":"A **module** is identified by a `ModuleId`, an absolute path (`/app/plugins/foo.wasm`). Its code comes from a `ModuleSource`:","locale":"en"},"6237":{"id":"/en/docs/guide-hot-reload-33","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#graph","content":"A module's `evaluate` receives its dependencies' exports through `Imports` (`imports.get(id)`, or `imports.value(id)` for a dependency that exports a value) and returns what it exports itself. `ModuleCode::new(deps, evaluate)` builds one. Besides custom sources, three backends load guest modules from files: `WasmSource`, `DylibSource` and `ProcessSource` (see Guest plugins).","locale":"en"},"6238":{"id":"/en/docs/guide-hot-reload-34","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#graph","content":"`ModuleGraph` is the host-owned module registry, what Node's module caches are to the reference implementation: the loaded modules, their edges and their exports.","locale":"en"},"6239":{"id":"/en/docs/guide-hot-reload-35","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#graph","content":"Method","locale":"en"},"6240":{"id":"/en/docs/guide-hot-reload-36","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#graph","content":"Does","locale":"en"},"6241":{"id":"/en/docs/guide-hot-reload-37","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#graph","content":"`ModuleGraph::new(source)`","locale":"en"},"6242":{"id":"/en/docs/guide-hot-reload-38","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#graph","content":"a graph over a source","locale":"en"},"6243":{"id":"/en/docs/guide-hot-reload-39","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#graph","content":"`graph.import(id)`","locale":"en"},"6244":{"id":"/en/docs/guide-hot-reload-40","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#graph","content":"imports a module and its dependencies, dependencies first, and caches them. In a cycle, a module that is still being imported is seen as `Exports::None`. A module that fails to load is not kept, so its next import tries again.","locale":"en"},"6245":{"id":"/en/docs/guide-hot-reload-41","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#graph","content":"`graph.resolve(name)` (as `Resolver`)","locale":"en"},"6246":{"id":"/en/docs/guide-hot-reload-42","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#graph","content":"imports `name` and returns its plugin; fails with `module <name> does not export a plugin` otherwise","locale":"en"},"6247":{"id":"/en/docs/guide-hot-reload-43","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#graph","content":"`graph.mark_host(ids)`, `graph.is_host(id)`","locale":"en"},"6248":{"id":"/en/docs/guide-hot-reload-44","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#graph","content":"host modules (below)","locale":"en"},"6249":{"id":"/en/docs/guide-hot-reload-45","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#graph","content":"`graph.is_loaded(id)`, `graph.loaded()`","locale":"en"},"6250":{"id":"/en/docs/guide-hot-reload-46","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#graph","content":"what is loaded","locale":"en"},"6251":{"id":"/en/docs/guide-hot-reload-47","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#graph","content":"`graph.edges(id)`, `graph.exports(id)`","locale":"en"},"6252":{"id":"/en/docs/guide-hot-reload-48","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#graph","content":"a loaded module's dependencies and exports","locale":"en"},"6253":{"id":"/en/docs/guide-hot-reload-49","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#host","content":"Statically linked plugins are **host modules** by construction: the program itself can only change by restarting it, while live *re*configuration of those plugins remains fully supported by the loader. If you model parts of the host as modules in the graph, mark them with `graph.mark_host(ids)`. A change to a host module is not applied; it is reported in `ReconcileResult::skipped_host_modules`, and watch mode warns:","locale":"en"},"6254":{"id":"/en/docs/guide-hot-reload-50","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#host","content":"Edges from host modules do not make them reload with the modules they import.","locale":"en"},"6255":{"id":"/en/docs/guide-hot-reload-51","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#reconcile","content":"`HmrExt::reconcile` runs one **transaction** on the `Hmr` service. Its callback reports the changed files or directories, as absolute paths; every loaded module at or below one of them (comparing whole path segments) is reloaded:","locale":"en"},"6256":{"id":"/en/docs/guide-hot-reload-52","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#reconcile","content":"A root that is not absolute fails the transaction: `invalid root <path>, expected an absolute path`.","locale":"en"},"6257":{"id":"/en/docs/guide-hot-reload-53","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#reconcile","content":"Transactions run one at a time.","locale":"en"},"6258":{"id":"/en/docs/guide-hot-reload-54","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#reconcile","content":"Starting a transaction inside another one (from its callback, or from a plugin the running transaction is reloading) fails with `cannot start a transaction inside another transaction`.","locale":"en"},"6259":{"id":"/en/docs/guide-hot-reload-55","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#reconcile","content":"A transaction follows the reference code (not the paper's Algorithm 10):","locale":"en"},"6260":{"id":"/en/docs/guide-hot-reload-56","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#reconcile","content":"**Match.** Changed modules are the loaded modules at or below the reported roots; host modules among them are only reported.","locale":"en"},"6261":{"id":"/en/docs/guide-hot-reload-57","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#reconcile","content":"**Accept.** The changed modules and every module that imports an accepted one (except host modules) are accepted.","locale":"en"},"6262":{"id":"/en/docs/guide-hot-reload-58","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#reconcile","content":"**Stale plugins.** Every registered plugin whose module closure reaches an accepted module is stale. A plugin exported by several modules (a module re-exporting it, for example) takes its replacement from the outermost exporter, the one no other exporter imports.","locale":"en"},"6263":{"id":"/en/docs/guide-hot-reload-59","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#reconcile","content":"**Stage 1: import.** The stale plugins' modules are evicted and every stale plugin is imported again. This is the only fallible step; validity is checked here, where only the module cache has changed, so the later stages need no rollback. Nothing is restored before every plugin has been imported, so no new module links against an evicted old one. Import errors are logged.","locale":"en"},"6264":{"id":"/en/docs/guide-hot-reload-60","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#reconcile","content":"**Units.** Plugins whose closures (in the old or the new graph) share an evicted module form a **unit** that commits or aborts together. A unit with a failed import is aborted: nothing in it is applied, and its modules' cache entries are restored; the other units are not affected.","locale":"en"},"6265":{"id":"/en/docs/guide-hot-reload-61","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#reconcile","content":"**Stage 2: replace.** Each committed plugin is replaced in place through `registry.replace`, logged as `reload plugin at <module>`.","locale":"en"},"6266":{"id":"/en/docs/guide-hot-reload-62","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#reconcile","content":"**Stage 3: settle.** The replaced fibers settle concurrently. There is no rollback: a plugin that fails to apply stays failed, as on a cold start.","locale":"en"},"6267":{"id":"/en/docs/guide-hot-reload-63","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#result","content":"Field","locale":"en"},"6268":{"id":"/en/docs/guide-hot-reload-64","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#result","content":"Contents","locale":"en"},"6269":{"id":"/en/docs/guide-hot-reload-65","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#result","content":"`settled_fibers: Vec<Fiber>`","locale":"en"},"6270":{"id":"/en/docs/guide-hot-reload-66","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#result","content":"the fibers that were replaced and have settled (a fiber below another reloaded fiber may have been disposed by it, and is left out)","locale":"en"},"6271":{"id":"/en/docs/guide-hot-reload-67","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#result","content":"`import_failures: Vec<ImportFailure>`","locale":"en"},"6272":{"id":"/en/docs/guide-hot-reload-68","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#result","content":"one per aborted unit","locale":"en"},"6273":{"id":"/en/docs/guide-hot-reload-69","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#result","content":"`skipped_host_modules: Vec<ModuleId>`","locale":"en"},"6274":{"id":"/en/docs/guide-hot-reload-70","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#result","content":"changed host modules, which only a restart applies; the other changes are applied","locale":"en"},"6275":{"id":"/en/docs/guide-hot-reload-71","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#result","content":"An `ImportFailure` has `modules` (the evicted modules of the unit, sorted, whose cache entries were restored) and `error` (why a module of the unit failed to import, or `invalid plugin at <module>, expect a plugin export` when it no longer exports a plugin).","locale":"en"},"6276":{"id":"/en/docs/guide-hot-reload-72","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#replacing","content":"A replacement goes through `registry.replace`, so each fiber of the plugin keeps its identity, parent, configuration and loader entry; only the implementation behind it changes. The fiber unloads (its effects, including the old guest instance, are disposed) and then loads the new implementation. For `hello.wat`, the old instance logs its goodbye and then the new one logs the new greeting. A guest gets a new instance with fresh state.","locale":"en"},"6277":{"id":"/en/docs/guide-hot-reload-73","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#replacing","content":"What can go wrong, and what happens:","locale":"en"},"6278":{"id":"/en/docs/guide-hot-reload-74","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#replacing","content":"Failure","locale":"en"},"6279":{"id":"/en/docs/guide-hot-reload-75","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#replacing","content":"Outcome","locale":"en"},"6280":{"id":"/en/docs/guide-hot-reload-76","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#replacing","content":"A changed module does not load, or no longer exports a plugin","locale":"en"},"6281":{"id":"/en/docs/guide-hot-reload-77","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#replacing","content":"Its unit is aborted: nothing in it is reloaded and the old module stays cached, so the running plugins keep their old code. Other units reload. In watch mode, its files are retried with the next batch.","locale":"en"},"6282":{"id":"/en/docs/guide-hot-reload-78","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#replacing","content":"The new implementation fails in `apply`","locale":"en"},"6283":{"id":"/en/docs/guide-hot-reload-79","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#replacing","content":"The fiber is `Failed`, as on a cold start; there is no rollback. A later reload of the module (or an `update` of the entry) recovers it.","locale":"en"},"6284":{"id":"/en/docs/guide-hot-reload-80","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#replacing","content":"The transaction itself fails (a bad root, a nested transaction, a failing callback)","locale":"en"},"6285":{"id":"/en/docs/guide-hot-reload-81","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#replacing","content":"Nothing is reloaded; the error is returned (and in watch mode logged as a warning, with all files retried).","locale":"en"},"6286":{"id":"/en/docs/guide-hot-reload-82","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#watch","content":"In watch mode, `hmr` watches `base` through the `fs` service and turns file changes into transactions:","locale":"en"},"6287":{"id":"/en/docs/guide-hot-reload-83","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#watch","content":"Each change is logged at debug level (`change detected at <path>`, relative to `base`).","locale":"en"},"6288":{"id":"/en/docs/guide-hot-reload-84","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#watch","content":"Changes are collected until `debounce` milliseconds pass without another one; the window's changes reload together as one batch (`reconcile N changed files`).","locale":"en"},"6289":{"id":"/en/docs/guide-hot-reload-85","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#watch","content":"Batches run one at a time, and each batch takes over the files retained by the one before:","locale":"en"},"6290":{"id":"/en/docs/guide-hot-reload-86","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#watch","content":"the files of failed imports are retried with the next batch (their import failures have been logged by the transaction);","locale":"en"},"6291":{"id":"/en/docs/guide-hot-reload-87","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#watch","content":"if the transaction itself fails, all its files are retried, and the error is logged as a warning;","locale":"en"},"6292":{"id":"/en/docs/guide-hot-reload-88","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#watch","content":"changes to host modules are only reported (`skipped host modules: …`), since restarting is up to the host.","locale":"en"},"6293":{"id":"/en/docs/guide-hot-reload-89","page_id":"/en/docs/guide-hot-reload","tags":[],"type":"text","url":"/en/docs/guide-hot-reload#watch","content":"The watch is an effect below the `hmr` fiber and ends with it.","locale":"en"},"6294":{"id":"/en/docs/guide-loader","page_id":"/en/docs/guide-loader","type":"page","content":"The loader","breadcrumbs":["kardia Documentation","Guide"],"tags":[],"url":"/en/docs/guide-loader","locale":"en"},"6295":{"id":"/en/docs/guide-loader-0","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader","content":"Run plugins from declarative entries: set up the loader and its catalog, drive trees, groups and entries from Rust, include config files with two-way sync, and locate config errors.","locale":"en"},"6296":{"id":"/en/docs/guide-loader-1","page_id":"/en/docs/guide-loader","type":"heading","tags":[],"url":"/en/docs/guide-loader#setup","content":"Setting up the loader","locale":"en"},"6297":{"id":"/en/docs/guide-loader-2","page_id":"/en/docs/guide-loader","type":"heading","tags":[],"url":"/en/docs/guide-loader#model","content":"Entries, groups and trees","locale":"en"},"6298":{"id":"/en/docs/guide-loader-3","page_id":"/en/docs/guide-loader","type":"heading","tags":[],"url":"/en/docs/guide-loader#api","content":"Driving the loader from Rust","locale":"en"},"6299":{"id":"/en/docs/guide-loader-4","page_id":"/en/docs/guide-loader","type":"heading","tags":[],"url":"/en/docs/guide-loader#loader-api","content":"`Loader`","locale":"en"},"6300":{"id":"/en/docs/guide-loader-5","page_id":"/en/docs/guide-loader","type":"heading","tags":[],"url":"/en/docs/guide-loader#handles","content":"`TreeHandle`, `GroupHandle`, `EntryHandle`","locale":"en"},"6301":{"id":"/en/docs/guide-loader-6","page_id":"/en/docs/guide-loader","type":"heading","tags":[],"url":"/en/docs/guide-loader#crud","content":"Creating, updating, moving and removing","locale":"en"},"6302":{"id":"/en/docs/guide-loader-7","page_id":"/en/docs/guide-loader","type":"heading","tags":[],"url":"/en/docs/guide-loader#backends","content":"Tree backends","locale":"en"},"6303":{"id":"/en/docs/guide-loader-8","page_id":"/en/docs/guide-loader","type":"heading","tags":[],"url":"/en/docs/guide-loader#isolation","content":"Isolation and interception through entries","locale":"en"},"6304":{"id":"/en/docs/guide-loader-9","page_id":"/en/docs/guide-loader","type":"heading","tags":[],"url":"/en/docs/guide-loader#include","content":"Including config files","locale":"en"},"6305":{"id":"/en/docs/guide-loader-10","page_id":"/en/docs/guide-loader","type":"heading","tags":[],"url":"/en/docs/guide-loader#patches","content":"Patches","locale":"en"},"6306":{"id":"/en/docs/guide-loader-11","page_id":"/en/docs/guide-loader","type":"heading","tags":[],"url":"/en/docs/guide-loader#writes","content":"Writes and conflicts","locale":"en"},"6307":{"id":"/en/docs/guide-loader-12","page_id":"/en/docs/guide-loader","type":"heading","tags":[],"url":"/en/docs/guide-loader#include-api","content":"The `Include` handle","locale":"en"},"6308":{"id":"/en/docs/guide-loader-13","page_id":"/en/docs/guide-loader","type":"heading","tags":[],"url":"/en/docs/guide-loader#errors","content":"Locating config errors","locale":"en"},"6309":{"id":"/en/docs/guide-loader-14","page_id":"/en/docs/guide-loader","type":"heading","tags":[],"url":"/en/docs/guide-loader#patch-context","content":"The `on_patch_context` hook","locale":"en"},"6310":{"id":"/en/docs/guide-loader-15","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader","content":"The **loader** (`kardia-loader`) keeps a tree of **entries** (a plugin name plus its configuration) in step with live fibers, in both directions: changes to the entries are reconciled into the running fibers, and a plugin that updates or disposes itself is written back to its entry. The **include** plugin (`kardia-include`) grafts the entries of a YAML or JSON file into that tree and keeps the file in sync both ways.","locale":"en"},"6311":{"id":"/en/docs/guide-loader-16","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader","content":"This page is the library user's view: how to set the loader up, drive it from Rust, include files and find config errors. The entry fields themselves (`id`, `name`, `config`, `group`, `disabled`, `inject`, `intercept`, `isolate`) and expressions are listed in The configuration file. How the loader is built is on Loader internals, and every place where it departs from the TypeScript loader is listed on Status and deviations.","locale":"en"},"6312":{"id":"/en/docs/guide-loader-17","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#setup","content":"`Loader::plugin(resolver)` returns the loader plugin. Once it runs, it provides the `loader` service:","locale":"en"},"6313":{"id":"/en/docs/guide-loader-18","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#setup","content":"**Resolving names.** The loader turns an entry's `name` into a `PluginDef` through a `Resolver`, the analogue of a module import. Resolution may be asynchronous:","locale":"en"},"6314":{"id":"/en/docs/guide-loader-19","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#setup","content":"A `Catalog` is the static resolver: a registry of plugins by name.","locale":"en"},"6315":{"id":"/en/docs/guide-loader-20","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#setup","content":"`Catalog` method","locale":"en"},"6316":{"id":"/en/docs/guide-loader-21","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#setup","content":"Does","locale":"en"},"6317":{"id":"/en/docs/guide-loader-22","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#setup","content":"`Catalog::new()`","locale":"en"},"6318":{"id":"/en/docs/guide-loader-23","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#setup","content":"an empty catalog","locale":"en"},"6319":{"id":"/en/docs/guide-loader-24","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#setup","content":"`catalog.register::<P>()`","locale":"en"},"6320":{"id":"/en/docs/guide-loader-25","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#setup","content":"registers a typed plugin under `P::NAME`","locale":"en"},"6321":{"id":"/en/docs/guide-loader-26","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#setup","content":"`catalog.register_def(name, def)`","locale":"en"},"6322":{"id":"/en/docs/guide-loader-27","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#setup","content":"registers a `PluginDef` under a name","locale":"en"},"6323":{"id":"/en/docs/guide-loader-28","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#setup","content":"`catalog.alias(alias, name)`","locale":"en"},"6324":{"id":"/en/docs/guide-loader-29","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#setup","content":"makes `alias` resolve to whatever `name` resolves to","locale":"en"},"6325":{"id":"/en/docs/guide-loader-30","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#setup","content":"`catalog.get(name)`","locale":"en"},"6326":{"id":"/en/docs/guide-loader-31","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#setup","content":"looks a name up","locale":"en"},"6327":{"id":"/en/docs/guide-loader-32","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#setup","content":"A missing name fails with `ModuleNotFound` (`Cannot find plugin 'name'`), which the loader reports located at the entry's `name` (see Locating config errors). `kardia_loader::builtins()` is a catalog with the `group` plugin (also as `@cordisjs/plugin-group`); `kardia::catalog()` adds `timer`, `logger-console`, `fs` and `include`, each also under its TypeScript package name.","locale":"en"},"6328":{"id":"/en/docs/guide-loader-33","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#setup","content":"A resolver can mix sources. The `kardia` binary resolves built-ins from its catalog and treats any other name as a guest module path relative to the config file:","locale":"en"},"6329":{"id":"/en/docs/guide-loader-34","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#setup","content":"`Loader::plugin_with(resolver, backend)` also sets the backend of the loader's own tree (see Tree backends); `Loader::plugin` uses `MemoryTree`, which keeps it in memory only. `crates/kardia/src/main.rs` shows the full setup of the binary.","locale":"en"},"6330":{"id":"/en/docs/guide-loader-35","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#model","content":"An **entry** is a JSON object of options. The JSON stays the source of truth, so unknown keys are tolerated and survive write-back. Keys are kept in a stable order: `id`, `name`, the rest alphabetically, `config` last.","locale":"en"},"6331":{"id":"/en/docs/guide-loader-36","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#model","content":"A **group** is an entry with `group: true` running the `group` plugin. Its `config` is a list of entries, which the group reconciles in place on every update instead of restarting: entries are created, updated and removed by id, concurrently, and one bad entry does not stop the others. Groups are never disabled themselves; their `disabled` verdict is passed on to their members.","locale":"en"},"6332":{"id":"/en/docs/guide-loader-37","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#model","content":"A **tree** is a set of groups with one backend that persists its changes. The loader's own tree lives in memory. A plugin can create a subtree (`loader.create_tree(ctx, backend)`); the include does this for each file.","locale":"en"},"6333":{"id":"/en/docs/guide-loader-38","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#model","content":"**Ids** are unique within a tree. Entries without one get a random eight-hex-digit id. Across nested trees an entry has a **composite id**, its tree owners' ids and its own joined by `:` (`kardia_loader::SEP`), such as `include:hmr`; an `id` must therefore not contain `:`.","locale":"en"},"6334":{"id":"/en/docs/guide-loader-39","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#model","content":"**Typed view.** `EntryOptions::read(&options)` reads validated options into a typed view (`id`, `name`, `config`, `group`, `disabled: Option<Disabled>` with `Disabled::{Bool, Expr}`, `inject`, `intercept`, `isolate: Vec<(String, IsolateLabel)>` with `IsolateLabel::{Private, Shared(label)}`); the JSON object stays the source of truth.","locale":"en"},"6335":{"id":"/en/docs/guide-loader-40","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#model","content":"**Two fibers per entry with `inject`.** An entry that declares `inject` runs an outer fiber (tagged `loader:outer`, `kardia_loader::OUTER_TAG`) that holds the dependencies, resolves the plugin, passes a `ctx.checkpoint()?`, and then starts the inner fiber that runs the plugin. Without `inject`, the entry has only the inner fiber.","locale":"en"},"6336":{"id":"/en/docs/guide-loader-41","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#model","content":"**When an entry runs.** A literal `disabled: true` or a disabled ancestor group blocks the entry. A `disabled` expression is evaluated in the outer fiber's context (which sees the entry's `inject`); if it fails, the entry is disabled and the failure reported. The entry's `intercept` is evaluated next; a plugin does not run with an `intercept` that cannot be evaluated. Expressions in `config` are interpolated in the plugin's context on every load, while the source keeps the expressions; a group's `config` is its entry list and is not interpolated.","locale":"en"},"6337":{"id":"/en/docs/guide-loader-42","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#api","content":"The loader has three kinds of handle: `TreeHandle`, `GroupHandle` and `EntryHandle`. `Loader`'s own `create`, `remove`, `update`, `resolve`, `entries` and `root` act on its own tree.","locale":"en"},"6338":{"id":"/en/docs/guide-loader-43","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#loader-api","content":"Method","locale":"en"},"6339":{"id":"/en/docs/guide-loader-44","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#loader-api","content":"Does","locale":"en"},"6340":{"id":"/en/docs/guide-loader-45","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#loader-api","content":"`Loader::plugin(resolver)` / `Loader::plugin_with(resolver, backend)`","locale":"en"},"6341":{"id":"/en/docs/guide-loader-46","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#loader-api","content":"the loader plugin","locale":"en"},"6342":{"id":"/en/docs/guide-loader-47","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#loader-api","content":"`loader.create(options, parent, position).await`","locale":"en"},"6343":{"id":"/en/docs/guide-loader-48","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#loader-api","content":"creates an entry; returns its composite id","locale":"en"},"6344":{"id":"/en/docs/guide-loader-49","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#loader-api","content":"`loader.update(id, patch, parent, position).await`","locale":"en"},"6345":{"id":"/en/docs/guide-loader-50","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#loader-api","content":"patches, and optionally moves, an entry","locale":"en"},"6346":{"id":"/en/docs/guide-loader-51","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#loader-api","content":"`loader.remove(id)`","locale":"en"},"6347":{"id":"/en/docs/guide-loader-52","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#loader-api","content":"removes an entry","locale":"en"},"6348":{"id":"/en/docs/guide-loader-53","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#loader-api","content":"`loader.resolve(id)`","locale":"en"},"6349":{"id":"/en/docs/guide-loader-54","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#loader-api","content":"the `EntryHandle` of a (composite) id","locale":"en"},"6350":{"id":"/en/docs/guide-loader-55","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#loader-api","content":"`loader.entries()`","locale":"en"},"6351":{"id":"/en/docs/guide-loader-56","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#loader-api","content":"every entry of every tree, depth first","locale":"en"},"6352":{"id":"/en/docs/guide-loader-57","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#loader-api","content":"`loader.root()`, `loader.tree()`","locale":"en"},"6353":{"id":"/en/docs/guide-loader-58","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#loader-api","content":"its own root group and tree","locale":"en"},"6354":{"id":"/en/docs/guide-loader-59","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#loader-api","content":"`loader.settled().await`","locale":"en"},"6355":{"id":"/en/docs/guide-loader-60","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#loader-api","content":"waits until no entry is initializing and every entry fiber has settled","locale":"en"},"6356":{"id":"/en/docs/guide-loader-61","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#loader-api","content":"`loader.is_busy()`","locale":"en"},"6357":{"id":"/en/docs/guide-loader-62","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#loader-api","content":"whether some entry is still initializing","locale":"en"},"6358":{"id":"/en/docs/guide-loader-63","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#loader-api","content":"`loader.create_tree(ctx, backend)`","locale":"en"},"6359":{"id":"/en/docs/guide-loader-64","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#loader-api","content":"a tree owned by the plugin running in `ctx`","locale":"en"},"6360":{"id":"/en/docs/guide-loader-65","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#loader-api","content":"`loader.entry_of(ctx)`","locale":"en"},"6361":{"id":"/en/docs/guide-loader-66","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#loader-api","content":"the entry a context belongs to (the nearest on its derivation chain)","locale":"en"},"6362":{"id":"/en/docs/guide-loader-67","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#loader-api","content":"`loader.on_patch_context(ctx, hook)`","locale":"en"},"6363":{"id":"/en/docs/guide-loader-68","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#loader-api","content":"see below","locale":"en"},"6364":{"id":"/en/docs/guide-loader-69","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#loader-api","content":"`loader.set_logs(true)`","locale":"en"},"6365":{"id":"/en/docs/guide-loader-70","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#loader-api","content":"logs `apply plugin <name>` / `unload plugin <name>` under the `loader` logger","locale":"en"},"6366":{"id":"/en/docs/guide-loader-71","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#loader-api","content":"`loader.context()`","locale":"en"},"6367":{"id":"/en/docs/guide-loader-72","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#loader-api","content":"the loader's context","locale":"en"},"6368":{"id":"/en/docs/guide-loader-73","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#loader-api","content":"An entry can also wait for the loader: declaring `inject: { loader: { await: true } }` makes the `loader` service available to it only once every entry has settled.","locale":"en"},"6369":{"id":"/en/docs/guide-loader-74","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#handles","content":"`TreeHandle`","locale":"en"},"6370":{"id":"/en/docs/guide-loader-75","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#handles","content":"`create`, `update`, `remove`, `resolve`, `entries`","locale":"en"},"6371":{"id":"/en/docs/guide-loader-76","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#handles","content":"as on `Loader`, within this tree","locale":"en"},"6372":{"id":"/en/docs/guide-loader-77","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#handles","content":"`root()`, `context()`","locale":"en"},"6373":{"id":"/en/docs/guide-loader-78","page_id":"/en/docs/guide-loader","tags":[],"type":"text","url":"/en/docs/guide-loader#handles","content":"its root group and context","locale":"en"},"6374":{"id":"/en/docs/guide-loader-79","page_id":"/en/docs/guid