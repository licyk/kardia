":"en"},"6568":{"id":"/en/docs/guide-plugins-42","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#providing-a-service","content":"Providing is an effect of the providing plugin:","locale":"en"},"6569":{"id":"/en/docs/guide-plugins-43","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#providing-a-service","content":"The binding is withdrawn when the plugin stops. Its consumers stop first.","locale":"en"},"6570":{"id":"/en/docs/guide-plugins-44","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#providing-a-service","content":"One realm (a scope of services, see isolation) holds at most one binding per key. Providing a key that is already bound fails with `KardiaError::AlreadyProvided`, naming the provider.","locale":"en"},"6571":{"id":"/en/docs/guide-plugins-45","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#providing-a-service","content":"Consumers see the binding once the providing plugin is active.","locale":"en"},"6572":{"id":"/en/docs/guide-plugins-46","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#services-for-expressions","content":"Expressions in config files and tooling read services as JSON. Only a service with a JSON view can be read this way: one provided with `provide_serialized_as`, or a `serde_json::Value` provided directly:","locale":"en"},"6573":{"id":"/en/docs/guide-plugins-47","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#services-for-expressions","content":"An entry that injects `settings` can then use `disabled: !!js \"!settings.enabled\"`.","locale":"en"},"6574":{"id":"/en/docs/guide-plugins-48","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#using-a-service","content":"Access","locale":"en"},"6575":{"id":"/en/docs/guide-plugins-49","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#using-a-service","content":"Checked against","locale":"en"},"6576":{"id":"/en/docs/guide-plugins-50","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#using-a-service","content":"Fails with","locale":"en"},"6577":{"id":"/en/docs/guide-plugins-51","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#using-a-service","content":"`ctx.get::<S>()`","locale":"en"},"6578":{"id":"/en/docs/guide-plugins-52","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#using-a-service","content":"The plugin's declared dependencies, at run time","locale":"en"},"6579":{"id":"/en/docs/guide-plugins-53","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#using-a-service","content":"`AccessError::Undeclared` if `S` is not declared; `AccessError::Inactive` if it is declared but has no binding","locale":"en"},"6580":{"id":"/en/docs/guide-plugins-54","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#using-a-service","content":"`Injected<D>::get::<S, _>()`","locale":"en"},"6581":{"id":"/en/docs/guide-plugins-55","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#using-a-service","content":"`D`, at compile time","locale":"en"},"6582":{"id":"/en/docs/guide-plugins-56","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#using-a-service","content":"A compile error if `S` is not in `D`","locale":"en"},"6583":{"id":"/en/docs/guide-plugins-57","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#using-a-service","content":"`Injected<D>::deps()`, `ctx.deps::<D>()`","locale":"en"},"6584":{"id":"/en/docs/guide-plugins-58","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#using-a-service","content":"All of `D` at once","locale":"en"},"6585":{"id":"/en/docs/guide-plugins-59","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#using-a-service","content":"As `get`","locale":"en"},"6586":{"id":"/en/docs/guide-plugins-60","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#using-a-service","content":"`ctx.get_as::<T>(key)`, `ctx.view(key)`","locale":"en"},"6587":{"id":"/en/docs/guide-plugins-61","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#using-a-service","content":"A key given at run time (the JSON view for `view`)","locale":"en"},"6588":{"id":"/en/docs/guide-plugins-62","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#using-a-service","content":"As `get`, or `AccessError::TypeMismatch`","locale":"en"},"6589":{"id":"/en/docs/guide-plugins-63","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#using-a-service","content":"`ctx.live::<S>()`, `ctx.live_as::<T>(key)`","locale":"en"},"6590":{"id":"/en/docs/guide-plugins-64","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#using-a-service","content":"Nothing: reads the current binding, if its provider is active","locale":"en"},"6591":{"id":"/en/docs/guide-plugins-65","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#using-a-service","content":"Never fails; returns `Option`","locale":"en"},"6592":{"id":"/en/docs/guide-plugins-66","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#using-a-service","content":"The checked accesses read the plugin's **committed view**: the bindings it resolved when it started. Access walks from the plugin's own provisions up through its ancestors, stops at an isolation boundary, and returns the first binding the plugin committed to. Because consumers read their committed view rather than the live store, a dependency stays readable while the consumer itself is being torn down (Theorem 70 in Metatheory). The root context has unchecked access to the live store.","locale":"en"},"6593":{"id":"/en/docs/guide-plugins-67","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#using-a-service","content":"The typed accesses return `Svc<S>`, which dereferences to `S` and remembers the accessing context (the caller). Services such as `timer` use the caller to make what they do on your behalf an effect of *your* plugin; Services explains caller attribution, interception and events.","locale":"en"},"6594":{"id":"/en/docs/guide-plugins-68","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#plugins","content":"A plugin is the paper's component `(d, p, e)`: the services it depends on (`d`), the services it provides (`p`), and the effects it performs when it runs (`e`). There are four ways to write one.","locale":"en"},"6595":{"id":"/en/docs/guide-plugins-69","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#plugin-macro","content":"The function must be `async` and return `Result<()>`.","locale":"en"},"6596":{"id":"/en/docs/guide-plugins-70","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#plugin-macro","content":"The first parameter is `Context` (no declared dependencies) or `Injected<(A, B, …)>` (declares `A`, `B`, …; up to eight).","locale":"en"},"6597":{"id":"/en/docs/guide-plugins-71","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#plugin-macro","content":"The optional second parameter is the configuration, as `Arc<Config>`. Without it, the plugin takes no configuration (`()`).","locale":"en"},"6598":{"id":"/en/docs/guide-plugins-72","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#plugin-macro","content":"The macro generates a plugin type named after the function in CamelCase (`hello_world` → `HelloWorld`, `user` → `User`) and keeps the function.","locale":"en"},"6599":{"id":"/en/docs/guide-plugins-73","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#plugin-macro","content":"Arguments: `name` sets the plugin name (default: the hyphenated function name, `hello-world`), `provide` lists the keys it provides, `crate` the path to the kardia crate.","locale":"en"},"6600":{"id":"/en/docs/guide-plugins-74","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#plugin-macro","content":"With `Injected<D>`, `ctx.get::<S, _>()` compiles only if `S` is in `D` (the `_` is the inferred position of `S` in `D`). `Injected` dereferences to `Context`, so everything else on `Context` is available; `ctx.context()` gives the unchecked context.","locale":"en"},"6601":{"id":"/en/docs/guide-plugins-75","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#plugin-trait","content":"(`Key` is `kardia::Key`, `Arc` is `std::sync::Arc`.) The trait:","locale":"en"},"6602":{"id":"/en/docs/guide-plugins-76","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#plugin-trait","content":"`provide()` does not provide anything by itself: the plugin still calls `ctx.provide` in `apply`. The declaration lets kardia detect a dependency cycle when the plugin is started and log it as a warning, naming the plugins in the cycle (they stay pending), instead of leaving them pending silently.","locale":"en"},"6603":{"id":"/en/docs/guide-plugins-77","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#inject","content":"`Inject` is an ordered list of service keys, each with optional interception metadata:","locale":"en"},"6604":{"id":"/en/docs/guide-plugins-78","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#inject","content":"A plugin starts once every declared service is available, restarts when one is replaced, and stops when one goes away.","locale":"en"},"6605":{"id":"/en/docs/guide-plugins-79","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#plugin-def","content":"A `PluginDef` is the type-erased form the runtime stores. You can build one from a closure:","locale":"en"},"6606":{"id":"/en/docs/guide-plugins-80","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#plugin-def","content":"Constructor","locale":"en"},"6607":{"id":"/en/docs/guide-plugins-81","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#plugin-def","content":"Configuration","locale":"en"},"6608":{"id":"/en/docs/guide-plugins-82","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#plugin-def","content":"Registry identity","locale":"en"},"6609":{"id":"/en/docs/guide-plugins-83","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#plugin-def","content":"`PluginDef::of::<P>()`","locale":"en"},"6610":{"id":"/en/docs/guide-plugins-84","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#plugin-def","content":"`P::Config`","locale":"en"},"6611":{"id":"/en/docs/guide-plugins-85","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#plugin-def","content":"The type `P`: every call gives the same identity","locale":"en"},"6612":{"id":"/en/docs/guide-plugins-86","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#plugin-def","content":"`PluginDef::typed(f)`","locale":"en"},"6613":{"id":"/en/docs/guide-plugins-87","page_id":"/en/docs/guide-plugins","tags":[],"type":"text","url":"/en/docs/guide-plugins#plugin-def","content":"Deserialized into the closure's `Arc<C>`","locale":"en"},"6614":{"id":"/en/docs/guide-plugins-88","page_id":"/en/docs/guide-plugins",