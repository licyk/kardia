ibers-16","page_id":"/en/docs/reference-fibers","type":"heading","tags":[],"url":"/en/docs/reference-fibers#nine-rules","content":"Mapping to the nine rules","locale":"en"},"8150":{"id":"/en/docs/reference-fibers-17","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers","content":"This page covers `cordis/packages/core/src/fiber.ts` and `registry.ts`. The paper counterparts are §4.1–4.2 (the calculus, see Calculus) and §5.1.3 (Algorithms 4–5, see Implementation).","locale":"en"},"8151":{"id":"/en/docs/reference-fibers-18","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#plugins","content":"In `registry.ts`, a **plugin** (the paper's *component*) is one of:","locale":"en"},"8152":{"id":"/en/docs/reference-fibers-19","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#plugins","content":"`inject` is either `['a', 'b']` or `{ a: meta, b: meta }` (the values are component-declared interception metadata, Definition 26). `Inject.resolve` normalizes it to `Dict<meta | null>`; the `@Inject` decorator (on a class or a method) builds inherited inject tables (`registry.ts:17-61`).","locale":"en"},"8153":{"id":"/en/docs/reference-fibers-20","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#plugins","content":"`provide` is declarative only (used by the loader and tooling); the actual provision happens when the plugin calls `ctx.provide` or constructs a `Service`.","locale":"en"},"8154":{"id":"/en/docs/reference-fibers-21","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#plugins","content":"The *return value* of `apply` is treated as an effect (see Effects): a function, a promise, or a (async) generator of disposers.","locale":"en"},"8155":{"id":"/en/docs/reference-fibers-22","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#plugins","content":"`RegistryService` keeps a `Map<callback, Plugin.Runtime>`:","locale":"en"},"8156":{"id":"/en/docs/reference-fibers-23","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#plugins","content":"A runtime groups all fibers of one plugin; it is unregistered when its last fiber is removed (`fiber.ts:191-193`). `registry.counter` provides **fiber uids** (`++counter`, never reused).","locale":"en"},"8157":{"id":"/en/docs/reference-fibers-24","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#ctx-plugin","content":"`registry.ts:231-245`. It resolves aliases (see `replace`), calls `assertActive()` on the calling fiber, gets or creates the runtime, constructs `new Fiber(ctx, config, Inject.resolve(plugin.inject), runtime, outerStack)`, and returns an object whose prototype is the fiber and which is **thenable** (`await ctx.plugin(...)` ≡ `fiber.await()`). `ctx.inject(deps, cb)` is sugar for `ctx.plugin({ inject: deps, apply: cb })`.","locale":"en"},"8158":{"id":"/en/docs/reference-fibers-25","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#replace","content":"`registry.ts:185-209`. Swaps the implementation behind existing fibers **in place**:","locale":"en"},"8159":{"id":"/en/docs/reference-fibers-26","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#replace","content":"it records an alias `old → new`, so later `ctx.plugin(old)` instantiates `new` (aliases are followed in chains and can switch back);","locale":"en"},"8160":{"id":"/en/docs/reference-fibers-27","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#replace","content":"it moves every fiber of the old runtime to the new runtime via `fiber._replace(runtime, inject)`.","locale":"en"},"8161":{"id":"/en/docs/reference-fibers-28","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#replace","content":"`_replace` (`fiber.ts:401-416`) re-checks injections against the new `inject`, clears `_error`, bumps `_revision` and calls `_refresh()`. The fiber keeps its identity, parent and config but reloads with the new code. This is the primitive HMR uses (see HMR).","locale":"en"},"8162":{"id":"/en/docs/reference-fibers-29","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#fiber","content":"`fiber.ts:115-220`:","locale":"en"},"8163":{"id":"/en/docs/reference-fibers-30","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#fiber","content":"Field","locale":"en"},"8164":{"id":"/en/docs/reference-fibers-31","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#fiber","content":"Paper","locale":"en"},"8165":{"id":"/en/docs/reference-fibers-32","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#fiber","content":"Notes","locale":"en"},"8166":{"id":"/en/docs/reference-fibers-33","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#fiber","content":"`uid: number \\| null`","locale":"en"},"8167":{"id":"/en/docs/reference-fibers-34","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#fiber","content":"name n","locale":"en"},"8168":{"id":"/en/docs/reference-fibers-35","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#fiber","content":"`null` once removed (O-Remove)","locale":"en"},"8169":{"id":"/en/docs/reference-fibers-36","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#fiber","content":"`parent: Context`","locale":"en"},"8170":{"id":"/en/docs/reference-fibers-37","page_id":"/en/docs/reference-fibers","tags":[],"type":"text","url":"/en/docs/reference-fibers#fiber","content":"